<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Life Partner Pro: a native shell around the website (STEP 37). Only what the app really needs is requested. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:replace="android:allowBackup">

        <!-- The only component other apps and web links can start. It opens ONLY this site's approved routes (see App Links below); the page then checks the person. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links (verified through https://<host>/.well-known/assetlinks.json). Exact routes only: keep in step with ALLOWED_LINKS in src/lib/mobile/deep-link.ts
                 (a test compares the two). The host comes from the LPP_APP_HOST build property. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${appHost}" />
                <data android:path="/dashboard" />
                <data android:pathPrefix="/dashboard/proposals/" />
                <data android:path="/dashboard/notifications" />
                <data android:path="/dashboard/documents" />
                <data android:path="/dashboard/membership" />
                <data android:path="/dashboard/profile/edit" />
                <data android:path="/dashboard/journey" />
                <data android:path="/dashboard/referrals" />
                <data android:path="/dashboard/feedback" />
                <data android:path="/dashboard/settings/notifications" />
                <data android:path="/my-proposals" />
                <data android:path="/my-verification" />
                <data android:path="/my-status" />
                <data android:path="/my-notifications" />
                <data android:path="/account-settings" />
                <data android:path="/report-concern" />
                <data android:path="/family/dashboard" />
                <data android:path="/family/proposals" />
                <data android:path="/family/meetings" />
                <data android:path="/family/documents" />
                <data android:path="/family/communications" />
                <data android:path="/family/security" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions. Nothing for location, contacts, microphone or Bluetooth. Camera and photos use the system picker, which needs no permission. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>