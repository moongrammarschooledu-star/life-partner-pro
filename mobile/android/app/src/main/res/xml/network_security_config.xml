<?xml version="1.0" encoding="utf-8"?>
<!-- No plain-text traffic, and only the phone's system certificate authorities are trusted (never certificates a user or app installed). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>