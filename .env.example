# SQLite for local development. To move to Postgres, change the datasource
# provider in prisma/schema.prisma to "postgresql" and point this at a
# postgres connection string instead.
DATABASE_URL="file:./dev.db"

# Used to sign admin session JWTs. Generate a real value with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-secret"

# Optional: overrides the password assigned to the seeded super admin.
SEED_ADMIN_PASSWORD="ChangeMe123!"
