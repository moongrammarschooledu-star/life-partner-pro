# Postgres connection string. Locally this can point at a free Neon/Vercel
# Postgres branch, or a local Postgres install. In production (Vercel), add
# the project's Postgres integration under Storage — it sets this for you.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Used to sign admin session JWTs. Generate a real value with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-secret"

# Optional: overrides the password assigned to the seeded super admin.
SEED_ADMIN_PASSWORD="ChangeMe123!"
