# Life Partner Pro — environment variables (PLACEHOLDERS ONLY — never commit real values).
# Copy to `.env` for local development. In Vercel, set each variable per
# environment (Development / Preview = staging / Production). Server-only
# variables must NEVER be prefixed NEXT_PUBLIC_ (the security scan fails the
# build if a secret-looking name is).

# ---- Environment identity (STEP 15 §1/§2) ---------------------------------
# development | staging | production. Defaults: VERCEL_ENV=production → production,
# preview → staging, otherwise development.
APP_ENV=development
# Canonical public URL (https in production). Used for HTTPS/HSTS readiness checks.
APP_URL=http://localhost:3000
# Each of these MUST equal APP_ENV — they prove the database / storage / payment
# credentials belong to THIS environment. A mismatch is a CRITICAL config error
# and the migration runner aborts. Give development, staging and production
# their OWN database and storage.
DATABASE_ENV_LABEL=development
STORAGE_ENV_LABEL=development
PAYMENT_ENVIRONMENT=sandbox

# ---- Database ----------------------------------------------------------------
# Pooled (pgbouncer) URL for the app. Migrations automatically use the direct
# (un-pooled) host derived from it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Authentication / crypto ---------------------------------------------------
# 32+ random characters. Signs sessions AND derives the file-encryption keys —
# rotating it invalidates every session and stored file (see docs/DEPLOYMENT.md).
NEXTAUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Local seed only. Change it immediately and deactivate the seeded account.
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ---- Storage --------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# ---- Backups (STEP 15 §6) ------------------------------------------------------------
# Dedicated key for backup encryption (32+ chars). NOT derived from NEXTAUTH_SECRET
# so backups survive a session-secret rotation. Store it in a password manager too.
BACKUP_ENCRYPTION_KEY=""
# Optional but recommended: a SEPARATE Vercel Blob store for backup copies.
BACKUP_BLOB_READ_WRITE_TOKEN=""
# Development/testing ONLY (refused in production): write backups to this folder.
# BACKUP_LOCAL_DIR=./.backups

# ---- Scheduled endpoints & pipeline evidence -----------------------------------------
# Vercel sends `Authorization: Bearer $CRON_SECRET` automatically once this is set.
CRON_SECRET=""
NOTIFICATION_WEBHOOK_SECRET=""
# Shared secret GitHub Actions uses to post CI/smoke evidence to /api/internal/ci-evidence.
CI_EVIDENCE_TOKEN=""

# ---- Communications (optional — messages are only logged until configured) -------------
# AI assistant (STEP 16). The built-in analysis needs NO key and sends no data anywhere.
# ANTHROPIC_API_KEY is only used if an admin switches the provider to Claude AND allows external access
# AND the member has given explicit AI consent. Leave empty to keep everything inside the system.
ANTHROPIC_API_KEY=""

# Email (SMTP; Gmail needs an App Password — never your normal password)
SMTP_USER=""
SMTP_PASS=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
EMAIL_FROM=""
SMS_PROVIDER_API_KEY=""
WHATSAPP_ENABLED="false"
WHATSAPP_API_KEY=""

# ---- Payments (optional — Manual/bank transfer needs none) ----------------------------------
# sk_test_ keys only outside production; sk_live_ only with PAYMENT_ENVIRONMENT=production.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Monitoring & security tuning -------------------------------------------------------------
# DEBUG | INFO | WARN | ERROR | CRITICAL (default: INFO in production, DEBUG elsewhere)
LOG_LEVEL=""
# Milliseconds; queries slower than this are aggregated in System Health → Slow Queries.
SLOW_QUERY_THRESHOLD_MS="500"
# Content-Security-Policy ships report-only. Set to "enforce" after reviewing violations.
CSP_MODE="report-only"
# Optional outbound alert webhook (Slack-compatible incoming webhook, https only).
ALERT_WEBHOOK_URL=""

# ---- Added in STEP 34 (names only - every value stays empty here; set real values in Vercel, never in a file) ----
# Hashing / signing secrets for the safety, communication and marketing systems (32+ random characters each, DIFFERENT from each other).
RISK_HASH_SALT=
COMMUNICATION_HASH_SALT=
COMMUNICATION_ENCRYPTION_KEY=
MARKETING_TOKEN_SECRET=
# Inbound webhook secrets. A webhook route refuses unsigned calls while its secret is missing.
SIGNATURE_WEBHOOK_SECRET=
DOCUMENT_WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=
IDENTITY_VERIFICATION_WEBHOOK_SECRET=
COMMUNICATION_SANDBOX_WEBHOOK_SECRET=
# Identity verification vendor (leave the provider empty to keep the built-in manual review).
IDENTITY_VERIFICATION_ENABLED=
IDENTITY_VERIFICATION_PROVIDER=
# SMS (Twilio) - optional; SMS is simply not sent until configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WEBHOOK_URL=
# WhatsApp Business (Meta) - optional; not sent until configured AND the whatsapp.enabled flag is on.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
# Sign-in codes by WhatsApp (STEP 38): the NAME of an approved Meta "authentication" template (body {{1}} = the code, optional copy-code button).
# Without a name no code is sent over WhatsApp (free text is not allowed) and the next channel is used.
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
WHATSAPP_OTP_TEMPLATE_BUTTON=true
# SMS through any HTTP gateway (a local Pakistani provider) - STEP 38. Everything about the provider is configuration; nothing here is read until SMS_GATEWAY_URL is set.
# URL / BODY / HEADERS may contain {to} {message} {sender}. Credentials go inside them. Must be https.
SMS_GATEWAY_URL=
SMS_GATEWAY_METHOD=POST
SMS_GATEWAY_BODY=
SMS_GATEWAY_CONTENT_TYPE=application/x-www-form-urlencoded
SMS_GATEWAY_HEADERS=
SMS_GATEWAY_SENDER=
SMS_GATEWAY_RECIPIENT_FORMAT=digits
SMS_GATEWAY_SUCCESS_PATTERN=
SMS_GATEWAY_FAILURE_PATTERN=
SMS_GATEWAY_MESSAGE_ID_PATTERN=
# Meta ads / lead forms - optional; marketing flags default OFF.
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_SECRET=
META_DATASET_ID=
META_LEADS_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_API_VERSION=
# Extra public hostnames allowed inside outgoing message links (comma separated); the production domain is always allowed.
COMMUNICATION_ALLOWED_URL_HOSTS=
# Pre-launch testing aids. NEVER set these in production: test recipients restrict who can receive messages; the debug switch prints codes.
COMMUNICATION_TEST_RECIPIENTS=
COMMUNICATION_DEBUG_OTP=
# Local development only. The demo-data seed refuses to run unless the database is labelled development (or is on this machine) AND this is "true".
ALLOW_DEMO_SEED=
# Tests only. NEVER in production (forces the outcome of the built-in mock identity-verification provider).
# IDENTITY_VERIFICATION_MOCK_OUTCOME=

# ---- Mobile apps (STEP 37) — names only; see docs/MOBILE_ENVIRONMENT_VARIABLES.md -----------------------
# Store identifiers. Leave unset to use the documented defaults. Once an app is published these must NEVER change.
ANDROID_PACKAGE_ID=
IOS_BUNDLE_ID=
# Hosts (besides APP_URL's) the apps may show / link from, comma separated.
MOBILE_ALLOWED_HOSTS=
# Public verification values (not secrets): the SHA-256 fingerprints of the Android signing keys (comma separated), and the Apple Team ID.
ANDROID_SHA256_CERT_FINGERPRINTS=
APPLE_TEAM_ID=
# Anonymous app usage counts (event names only). Off unless "true".
MOBILE_ANALYTICS_ENABLED=
# Optional dedicated key for push tokens at rest (32+ chars). Falls back to a key derived from NEXTAUTH_SECRET.
MOBILE_ENCRYPTION_KEY=
# Push providers. Server-side SECRETS: set them only in the hosting environment, never in the app, never in Git.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=production
# Minimum / recommended app versions, push, deep links and biometrics are NOT environment variables: they are the mobile.* feature flags and the
# version policy in Control Center > Mobile apps, so they can change without a deployment.
