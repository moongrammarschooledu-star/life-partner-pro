# Life Partner Pro — environment variables (PLACEHOLDERS ONLY — never commit real values).
# Copy to `.env` for local development. In Vercel, set each variable per
# environment (Development / Preview = staging / Production). Server-only
# variables must NEVER be prefixed NEXT_PUBLIC_ (the security scan fails the
# build if a secret-looking name is).

# ---- Environment identity (STEP 15 §1/§2) ---------------------------------
# development | staging | production. Defaults: VERCEL_ENV=production → production,
# preview → staging, otherwise development.
APP_ENV=development
# Canonical public URL (https in production). Used for HTTPS/HSTS readiness checks.
APP_URL=http://localhost:3000
# Each of these MUST equal APP_ENV — they prove the database / storage / payment
# credentials belong to THIS environment. A mismatch is a CRITICAL config error
# and the migration runner aborts. Give development, staging and production
# their OWN database and storage.
DATABASE_ENV_LABEL=development
STORAGE_ENV_LABEL=development
PAYMENT_ENVIRONMENT=sandbox

# ---- Database ----------------------------------------------------------------
# Pooled (pgbouncer) URL for the app. Migrations automatically use the direct
# (un-pooled) host derived from it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Authentication / crypto ---------------------------------------------------
# 32+ random characters. Signs sessions AND derives the file-encryption keys —
# rotating it invalidates every session and stored file (see docs/DEPLOYMENT.md).
NEXTAUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Local seed only. Change it immediately and deactivate the seeded account.
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ---- Storage --------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# ---- Backups (STEP 15 §6) ------------------------------------------------------------
# Dedicated key for backup encryption (32+ chars). NOT derived from NEXTAUTH_SECRET
# so backups survive a session-secret rotation. Store it in a password manager too.
BACKUP_ENCRYPTION_KEY=""
# Optional but recommended: a SEPARATE Vercel Blob store for backup copies.
BACKUP_BLOB_READ_WRITE_TOKEN=""
# Development/testing ONLY (refused in production): write backups to this folder.
# BACKUP_LOCAL_DIR=./.backups

# ---- Scheduled endpoints & pipeline evidence -----------------------------------------
# Vercel sends `Authorization: Bearer $CRON_SECRET` automatically once this is set.
CRON_SECRET=""
NOTIFICATION_WEBHOOK_SECRET=""
# Shared secret GitHub Actions uses to post CI/smoke evidence to /api/internal/ci-evidence.
CI_EVIDENCE_TOKEN=""

# ---- Communications (optional — messages are only logged until configured) -------------
# AI assistant (STEP 16). The built-in analysis needs NO key and sends no data anywhere.
# ANTHROPIC_API_KEY is only used if an admin switches the provider to Claude AND allows external access
# AND the member has given explicit AI consent. Leave empty to keep everything inside the system.
ANTHROPIC_API_KEY=""

# Email (SMTP; Gmail needs an App Password — never your normal password)
SMTP_USER=""
SMTP_PASS=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
EMAIL_FROM=""
SMS_PROVIDER_API_KEY=""
WHATSAPP_ENABLED="false"
WHATSAPP_API_KEY=""

# ---- Payments (optional — Manual/bank transfer needs none) ----------------------------------
# sk_test_ keys only outside production; sk_live_ only with PAYMENT_ENVIRONMENT=production.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Monitoring & security tuning -------------------------------------------------------------
# DEBUG | INFO | WARN | ERROR | CRITICAL (default: INFO in production, DEBUG elsewhere)
LOG_LEVEL=""
# Milliseconds; queries slower than this are aggregated in System Health → Slow Queries.
SLOW_QUERY_THRESHOLD_MS="500"
# Content-Security-Policy ships report-only. Set to "enforce" after reviewing violations.
CSP_MODE="report-only"
# Optional outbound alert webhook (Slack-compatible incoming webhook, https only).
ALERT_WEBHOOK_URL=""
