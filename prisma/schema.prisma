}

enum NotificationType {
  // Account
  ACCOUNT_REGISTERED
  MOBILE_VERIFIED
  EMAIL_VERIFIED
  PROFILE_SUBMITTED
  PROFILE_APPROVED
  PROFILE_UPDATE_APPROVED
  PROFILE_UPDATE_REJECTED
