// ---------- Core profile ----------

model Profile {
  id          String @id @default(cuid())
  profileCode String @unique // e.g. LPP-000001, cosmetic display id only

  fullName      String
  gender        Gender
  dateOfBirth   DateTime
  maritalStatus MaritalStatus
  heightCm      Int

  city        String
  area        String?
  country     String
  nationality String?

  hasChildren      Boolean? // only meaningful for Divorced/Widowed/Separated
  numberOfChildren Int?

  status            ProfileStatus @default(NEW)
  verified          Boolean       @default(false)
  softDeleted       Boolean       @default(false)
  // Orthogonal to `status` (STEP 13) — see AccountStatus enum comment.
  accountStatus     AccountStatus @default(ACTIVE)
  profileCompletion Int           @default(0) // 0-100, recomputed whenever the profile or its sections are written
  preferredLanguage Locale        @default(EN) // drives server-side notification template language (STEP 9)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact             ContactInfo?
  education           EducationInfo?
  profession          ProfessionInfo?
  family              FamilyInfo?
  lifestyle           LifestyleInfo?
  preference          PartnerPreference?
  photos              ProfilePhoto[]
  notes               ProfileNote[]
  consent             ConsentRecord?
  communications      Communication[]
  followUps           FollowUp[]
  pendingUpdate       PendingUpdate?
  dashboardPreference DashboardPreference?

  matchesAsA   Match[]    @relation("MatchProfileA")
  matchesAsB   Match[]    @relation("MatchProfileB")
  proposalsAsA Proposal[] @relation("ProposalProfileA")
  proposalsAsB Proposal[] @relation("ProposalProfileB")

  auditLogs        AuditLog[]
  contactSharesAsA ContactShareLog[] @relation("ShareProfileA")
  contactSharesAsB ContactShareLog[] @relation("ShareProfileB")

  proposalResponses       ProposalResponse[]
  contactPermissions      ContactPermission[]
  familyCommunications    FamilyCommunication[]
  performedProposalEvents ProposalEvent[]

  verification          ProfileVerification?
  otpVerifications      OtpVerification[]
  verificationDocuments VerificationDocument[]
  securityFlags         SecurityFlag[]         @relation("SecurityFlagProfile")
  relatedSecurityFlags  SecurityFlag[]         @relation("SecurityFlagRelatedProfile")

  notificationsReceived  Notification[]          @relation("NotificationRecipientProfile")
  notificationsRelated   Notification[]          @relation("NotificationRelatedProfile")
  communicationLogs      CommunicationLog[]
  notificationPreference NotificationPreference?
  communicationConsents  CommunicationConsent[]

  // ---------- Support, Complaints, Safety & Case Management (STEP 12) ----------
  casesFiled    Case[]               @relation("CaseReporterProfile")
  casesReported Case[]               @relation("CaseReportedProfile")
  caseComments  CaseComment[]
  caseEvidence  CaseEvidence[]
  restrictions  ProfileRestriction[]

  // ---------- Data Privacy, Consent, Account Management & Retention (STEP 13) ----------
  consentGrants      ConsentGrant[]
  deletionRequests   AccountDeletionRequest[]
  privacyRequests    PrivacyRequest[]
  dataExportRequests DataExportRequest[]
  sessions           ProfileSession[]

  // ---------- Payment, Subscription, Packages & Financial Management (STEP 14) ----------
  subscriptions     Subscription[]
  orders            Order[]
  payments          Payment[]
  invoices          Invoice[]
  couponRedemptions CouponRedemption[]

  // ---------- Candidate Discovery & Matchmaking Workspace (STEP 20) ----------
  searchHistoryAsSource         SearchHistory[]
  shortlistsAsSource            Shortlist[]
  shortlistAppearances          ShortlistItem[]
  candidateSearchAuditsAsSource CandidateSearchAudit[]

  @@index([gender, status])
  @@index([city])
  @@index([status])
  @@index([maritalStatus])
  @@index([dateOfBirth])
  @@index([verified])
  @@index([softDeleted, status]) // STEP 15 — matching candidate + admin list filters
  @@index([createdAt])
}

model ContactInfo {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String  @unique

  mobileNumber           String
  whatsappNumber         String?
  email                  String
  preferredContactMethod ContactMethod @default(PHONE)
  contactVerified        Boolean       @default(false)
}

model EducationInfo {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String  @unique

  level       String // e.g. Bachelor's, Master's, PhD
  degree      String?
  institution String?
}

model ProfessionInfo {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String  @unique

  profession         String
  jobTitle           String?
  companyName        String?
  employmentType     EmploymentType @default(PRIVATE)
  monthlyIncome      Int? // stored in smallest currency unit-agnostic integer (e.g. USD)
  annualIncome       Int?
  workLocation       String?
  businessDetails    String?
  program            String? // Student employment type only
  expectedGraduation String? // Student employment type only
}

model FamilyInfo {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String  @unique

  fatherOccupation String?
  motherOccupation String?
  numberOfBrothers Int          @default(0)
  numberOfSisters  Int          @default(0)
  familyType       FamilyType   @default(NUCLEAR)
  familyStatus     FamilyStatus @default(MIDDLE_CLASS)
  familyLocation   String?
  familyBackground String?
  additionalInfo   String?
}

model LifestyleInfo {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String  @unique

  religion          String?
  sect              String?
  religiousPractice String? // e.g. Practicing, Moderate, Liberal
  languages         String? // comma separated
  smoking           Boolean @default(false)
  drinking          Boolean @default(false)
  hobbies           String?
  personality       String?
  aboutMe           String?
  otherPreferences  String?
}

model PartnerPreference {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String  @unique

  minAge Int?
  maxAge Int?

  preferredCountry String?
  preferredCity    String?
  preferredArea    String?

  minEducation       String?
  preferredEducation String?

  professionPreference String? // free text or "ANY"

  minIncome      Int?
  maxIncome      Int?
  incomeFlexible Boolean @default(true)

  maritalStatusPreference String? // comma-separated MaritalStatus values or "ANY"

  minHeightCm Int?
  maxHeightCm Int?

  familyTypePreference       String?
  familyBackgroundPreference String?
  otherFamilyRequirements    String?

  additionalExpectations String? // large free text

  // Captured at registration for future matching-engine consumption — the
  // engine (src/lib/matching.ts) does not yet weight by these (spec §8).
  agePriority        PreferencePriority? @default(PREFERRED)
  locationPriority   PreferencePriority? @default(PREFERRED)
  professionPriority PreferencePriority? @default(PREFERRED)
  locationScope      String? // e.g. "Same City", "Anywhere in Country" — selected label, not scored yet
}

model ProfilePhoto {
  id            String   @id @default(cuid())
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId     String
  storageKey    String // Vercel Blob URL — never sent to the client directly, see src/lib/storage.ts
  mimeType      String
  sizeBytes     Int
  isPrimary     Boolean  @default(true)
  createdAt     DateTime @default(now())
  // STEP 13 — AES-256-GCM, nullable so existing pre-STEP-13 photos keep
  // working unencrypted until next replaced (see src/lib/privacy/photo-crypto.ts).
  ivBase64      String?
  authTagBase64 String?

  @@index([profileId])
}

// Granular consent, tracked separately per purpose rather than one blanket
// checkbox — a profile must not go ACTIVE without all four being true (see
// the status-change route). consentVersion records which wording the
// applicant agreed to, for future re-consent if the policy text changes.
model ConsentRecord {
  id                    String   @id @default(cuid())
  profile               Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId             String   @unique
  privacyConsent        Boolean  @default(false)
  matchmakingConsent    Boolean  @default(false)
  contactSharingConsent Boolean  @default(false)
  termsAccepted         Boolean  @default(false)
  consentVersion        String   @default("1.0")
  agreedAt              DateTime @default(now())
  ipHash                String?
}

// Pending, admin-reviewable edits to sensitive fields submitted by the applicant.
model PendingUpdate {
  id          String   @id @default(cuid())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String   @unique
  payload     String // JSON blob of the proposed changes
  submittedAt DateTime @default(now())
}

// STEP 21 — cosmetic, per-applicant dashboard layout state (pinned widgets,
// collapsed cards, last-visited tab). Never admin-reviewed, never affects
// matching/eligibility — distinct from PendingUpdate above.
model DashboardPreference {
  id             String   @id @default(cuid())
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId      String   @unique
  pinnedWidgets  String? // JSON array of widget keys
  collapsedCards String? // JSON array of collapsed card keys
  lastVisitedTab String?
  updatedAt      DateTime @updatedAt
}

model ProfileNote {
  id         String    @id @default(cuid())
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String?
  match      Match?    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId    String?
  admin      AdminUser @relation(fields: [adminId], references: [id])
  adminId    String
  text       String
  pinned     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([profileId])
  @@index([proposalId])
  @@index([matchId])
}

// ---------- Matching & proposals ----------

model Match {
  id         String  @id @default(cuid())
  profileA   Profile @relation("MatchProfileA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileAId String
  profileB   Profile @relation("MatchProfileB", fields: [profileBId], references: [id], onDelete: Cascade)
  profileBId String

  score              Int // overall mutual compatibility score, 0-100
  ageScore           Int
  locationScore      Int
  educationScore     Int
  professionScore    Int
  incomeScore        Int
  maritalStatusScore Int
  heightScore        Int
  familyScore        Int
  religiousScore     Int
  lifestyleScore     Int
  languagesScore     Int    @default(0)
  directionAToB      Int    @default(0) // how well B satisfies A's stated preference
  directionBToA      Int    @default(0) // how well A satisfies B's stated preference
  breakdown          String // JSON: [{category, weight, score, status, reason}] — full explanation, see src/lib/matching.ts

  // Versioning + recalculation audit trail (STEP 6 §33/§34) — historical
  // rows are never silently rewritten; recalculating snapshots the prior
  // score/breakdown here before overwriting the live fields above.
  algorithmVersion  String    @default("LPP-MATCH-v1.0")
  previousScore     Int?
  previousBreakdown String?
  recalculatedAt    DateTime?

  status         MatchStatus          @default(SUGGESTED)
  recommendation MatchRecommendation?

  createdBy   AdminUser? @relation(fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  notes     ProfileNote[]
  proposals Proposal[]

  @@unique([profileAId, profileBId])
  @@index([profileAId])
  @@index([profileBId])
  @@index([status])
}

model Proposal {
  id           String           @id @default(cuid())
  // LPP-RP-000001 style, cosmetic display id — see src/lib/proposal-code.ts.
  // Nullable: a live table already has rows when this column was added;
  // new proposals get one at creation, old rows are lazily backfilled by
  // ensureProposalCode() the first time they're read (see plan §Schema).
  proposalCode String?          @unique
  profileA     Profile          @relation("ProposalProfileA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileAId   String
  profileB     Profile          @relation("ProposalProfileB", fields: [profileBId], references: [id], onDelete: Cascade)
  profileBId   String
  match        Match?           @relation(fields: [matchId], references: [id])
  matchId      String?
  matchScore   Int? // snapshot of Match.score at proposal-creation time
  status       ProposalStatus   @default(DRAFT)
  priority     ProposalPriority @default(MEDIUM)
  createdBy    AdminUser        @relation(fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Staff assignment (spec §24) — STAFF admins may only edit proposals
  // assigned to them, enforced in src/lib/proposal-access.ts.
  assignedTo   AdminUser? @relation("AssignedProposals", fields: [assignedToId], references: [id])
  assignedToId String?

  finalizedAt   DateTime?
  finalizedById String?
  finalNotes    String?

  marriedAt     DateTime?
  marriedById   String?
  marriageNotes String?

  // rejectionReason is a short admin-chosen category; internalRejectionNote
  // is free text that must never be serialized to any applicant-facing API
  // response (spec §17 — "never expose sensitive rejection reasons").
  rejectedAt            DateTime?
  rejectedById          String?
  rejectionReason       String?
  internalRejectionNote String?

  closedAt   DateTime?
  archivedAt DateTime?

  // Anti-spam cooldown guard for the "still pending a response" reminder
  // (spec §23) — see src/app/api/cron/notifications/route.ts.
  lastPendingReminderAt DateTime?

  events               ProposalEvent[]
  notes                ProfileNote[]
  communications       Communication[]
  followUps            FollowUp[]
  responses            ProposalResponse[]
  contactPermissions   ContactPermission[]
  meetings             Meeting[]
  familyCommunications FamilyCommunication[]
  notifications        Notification[]
  communicationLogs    CommunicationLog[]

  @@index([profileAId])
  @@index([profileBId])
  @@index([matchId])
  @@index([assignedToId])
  @@index([status])
  @@index([status, updatedAt]) // STEP 15 — pending-proposal reminder sweep
}

model ProposalEvent {
  id         String         @id @default(cuid())
  proposal   Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String
  status     ProposalStatus
  note       String?
  createdAt  DateTime       @default(now())

  // Exactly one of these is set — an admin action vs. an applicant's own
  // self-service response (spec §12 "Performed by").
  performedByAdmin     AdminUser? @relation(fields: [performedByAdminId], references: [id])
  performedByAdminId   String?
  performedByProfile   Profile?   @relation(fields: [performedByProfileId], references: [id])
  performedByProfileId String?

  @@index([proposalId])
}

// Per-profile Interested/Not Interested/Need More Info response (spec §6).
// Upserted — one row per profile per proposal, respondedAt tracks the
// latest response if a profile changes their mind.
model ProposalResponse {
  id          String                 @id @default(cuid())
  proposal    Proposal               @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId  String
  profile     Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  response    ProposalResponseType
  reason      ProposalDeclineReason?
  reasonNote  String?
  respondedAt DateTime               @default(now())

  @@unique([proposalId, profileId])
  @@index([proposalId])
}

// Per-profile contact consent state (spec §8) — distinct from
// ContactShareLog, which records the actual one-shot reveal of contact
// details once both sides here are approved.
model ContactPermission {
  id           String     @id @default(cuid())
  proposal     Proposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId   String
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  requestedAt  DateTime   @default(now())
  approvedAt   DateTime?
  approvedBy   AdminUser? @relation(fields: [approvedById], references: [id])
  approvedById String?
  revokedAt    DateTime?

  @@unique([proposalId, profileId])
  @@index([proposalId])
}

model Meeting {
  id           String        @id @default(cuid())
  proposal     Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId   String
  meetingType  MeetingType
  scheduledAt  DateTime
  locationInfo String?
  participants String?
  status       MeetingStatus @default(REQUESTED)
  notes        String?
  followUpDate DateTime?
  createdBy    AdminUser     @relation(fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Scheduled-reminder dedup guards (spec §23) — see
  // src/app/api/cron/notifications/route.ts.
  reminder24hSentAt DateTime?
  reminder2hSentAt  DateTime?

  @@index([proposalId])
  @@index([scheduledAt])
}

// Optional family-involvement log (spec §9) — kept separate from the
// general Communication model since its fields (contact person,
// relationship, outcome) are specific to family outreach.
model FamilyCommunication {
  id                  String    @id @default(cuid())
  proposal            Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId          String
  profile             Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId           String
  contactPerson       String
  relationship        String
  communicationMethod String
  communicationDate   DateTime
  outcome             String?
  notes               String?
  nextFollowUpDate    DateTime?
  createdBy           AdminUser @relation(fields: [createdById], references: [id])
  createdById         String
  createdAt           DateTime  @default(now())

  @@index([proposalId])
  @@index([profileId])
}

// Running counter backing LPP-RP-###### proposal codes — see
// src/lib/proposal-code.ts (mirrors ProfileCodeCounter).
model ProposalCodeCounter {
  id      Int @id @default(1)
  lastSeq Int @default(0)
}

model Communication {
  id           String            @id @default(cuid())
  profile      Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  proposal     Proposal?         @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  proposalId   String?
  admin        AdminUser         @relation(fields: [adminId], references: [id])
  adminId      String
  type         CommunicationType
  notes        String?
  occurredAt   DateTime          @default(now())
  followUpDate DateTime?
  createdAt    DateTime          @default(now())

  @@index([profileId])
  @@index([proposalId])
}

model FollowUp {
  id          String           @id @default(cuid())
  profile     Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  proposal    Proposal?        @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  proposalId  String?
  admin       AdminUser?       @relation(fields: [adminId], references: [id])
  adminId     String?
  title       String?
  note        String?
  purpose     String? // e.g. "Check on family discussion" — spec §11
  outcome     String? // recorded once the follow-up is completed
  dueDate     DateTime
  priority    FollowUpPriority @default(MEDIUM)
  status      FollowUpStatus   @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  // Scheduled-reminder dedup guard (spec §23).
  reminderSentAt DateTime?

  @@index([dueDate, status])
  @@index([profileId])
  @@index([proposalId])
}

// ---------- Contact sharing ----------

model ContactShareLog {
  id             String    @id @default(cuid())
  profileA       Profile   @relation("ShareProfileA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileAId     String
  profileB       Profile   @relation("ShareProfileB", fields: [profileBId], references: [id], onDelete: Cascade)
  profileBId     String
  phoneShared    Boolean   @default(false)
  whatsappShared Boolean   @default(false)
  emailShared    Boolean   @default(false)
  approvedBy     AdminUser @relation(fields: [approvedById], references: [id])
  approvedById   String
  sharedAt       DateTime  @default(now())

  @@index([profileAId])
  @@index([profileBId])
}

// ---------- Verification & Trust (STEP 8) ----------

// One-to-one with Profile — the real source of truth for verification state.
// Profile.verified stays a derived, auto-synced boolean (see
// src/lib/verification/status.ts's setVerificationStatus()) so every
// existing `profile.verified` read across matching/proposals/badges keeps
// working unchanged.
model ProfileVerification {
  id        String             @id @default(cuid())
  profile   Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String             @unique
  status    VerificationStatus @default(NOT_VERIFIED)

  assignedTo   AdminUser? @relation("VerificationAssignee", fields: [assignedToId], references: [id])
  assignedToId String?

  phoneVerifiedAt    DateTime?
  emailVerifiedAt    DateTime?
  whatsappVerifiedAt DateTime? // stub — stays null until a real WhatsApp provider exists

  // User-facing — shown verbatim on /my-verification (spec §15).
  requestedInfoItems String? // JSON array of checklist itemKeys

  // Internal only — never serialized to any applicant-facing route (spec §16).
  rejectionReasonCategory String?
  rejectionNote           String?
  suspensionReason        String?
  reVerificationReason    String?

  expiresAt           DateTime?
  verificationVersion Int       @default(1)

  lastReviewedAt   DateTime?
  lastReviewedBy   AdminUser? @relation("VerificationReviewer", fields: [lastReviewedById], references: [id])
  lastReviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items VerificationItem[]

  @@index([status])
  @@index([assignedToId])
}

model VerificationItem {
  id                    String                 @id @default(cuid())
  profileVerification   ProfileVerification    @relation(fields: [profileVerificationId], references: [id], onDelete: Cascade)
  profileVerificationId String
  itemKey               String // matches a key in src/lib/verification/checklist-catalog.ts
  status                VerificationItemStatus @default(PENDING)
  document              VerificationDocument?  @relation(fields: [documentId], references: [id])
  documentId            String?                @unique
  note                  String?
  completedBy           AdminUser?             @relation(fields: [completedById], references: [id])
  completedById         String?
  completedAt           DateTime?

  @@unique([profileVerificationId, itemKey])
}

// Covers both phone OTP (6-digit code) and email verification (long token) —
// same hash-and-compare mechanism, distinguished by `channel`.
model OtpVerification {
  id                String     @id @default(cuid())
  profile           Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId         String
  channel           OtpChannel
  codeHash          String // bcrypt hash — the raw code/token is never stored
  destinationMasked String // e.g. "+92*****017" or "j***@example.com", display-only
  attempts          Int        @default(0)
  maxAttempts       Int        @default(5)
  status            OtpStatus  @default(PENDING)
  expiresAt         DateTime
  verifiedAt        DateTime?
  createdAt         DateTime   @default(now())

  @@index([profileId, channel])
}

model VerificationDocument {
  id                     String               @id @default(cuid())
  profile                Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId              String
  documentType           DocumentType
  secureStorageReference String // Vercel Blob key — never sent to the client, see document-storage.ts
  ivBase64               String // AES-256-GCM nonce
  authTagBase64          String
  mimeType               String
  sizeBytes              Int
  uploadedAt             DateTime             @default(now())
  reviewStatus           DocumentReviewStatus @default(PENDING)
  reviewedBy             AdminUser?           @relation(fields: [reviewedById], references: [id])
  reviewedById           String?
  reviewedAt             DateTime?
  reviewNote             String?
  expiresAt              DateTime?

  item VerificationItem?

  @@index([profileId])
}

model SecurityFlag {
  id               String               @id @default(cuid())
  profile          Profile              @relation("SecurityFlagProfile", fields: [profileId], references: [id], onDelete: Cascade)
  profileId        String
  flagType         SecurityFlagType
  severity         SecurityFlagSeverity @default(MEDIUM)
  status           SecurityFlagStatus   @default(OPEN)
  assignedTo       AdminUser?           @relation("SecurityFlagAssignee", fields: [assignedToId], references: [id])
  assignedToId     String?
  // The other profile in a suspected duplicate pair (spec §12 — no separate
  // duplicate-detection table, a duplicate is just this flag type).
  relatedProfile   Profile?             @relation("SecurityFlagRelatedProfile", fields: [relatedProfileId], references: [id])
  relatedProfileId String?
  description      String
  resolution       String?
  resolvedBy       AdminUser?           @relation("SecurityFlagResolver", fields: [resolvedById], references: [id])
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime             @default(now())

  @@index([profileId])
  @@index([status])
}

// ---------- Audit ----------

model AuditLog {
  id              String      @id @default(cuid())
  admin           AdminUser?  @relation(fields: [adminId], references: [id])
  adminId         String?
  action          AuditAction
  targetProfile   Profile?    @relation(fields: [targetProfileId], references: [id])
  targetProfileId String?
  meta            String? // JSON blob of extra context
  createdAt       DateTime    @default(now())
  // STEP 15 — populated automatically by writeAudit() for admin actions only
  ipAddress       String?
  userAgent       String?
  correlationId   String?

  @@index([targetProfileId])
  @@index([adminId])
  @@index([createdAt])
  @@index([action, createdAt])
}

// ---------- App-wide settings (single row) ----------

model AppSettings {
  id                  Int     @id @default(1)
  appName             String  @default("Life Partner Pro")
  contactEmail        String?
  contactWhatsapp     String?
  contactAddress      String?
  weightAge           Int     @default(15)
  weightLocation      Int     @default(15)
  weightEducation     Int     @default(10)
  weightProfession    Int     @default(10)
  weightIncome        Int     @default(10)
  weightMaritalStatus Int     @default(10)
  weightHeight        Int     @default(5)
  weightFamily        Int     @default(10)
  weightReligious     Int     @default(10)
  weightLifestyle     Int     @default(5)
  weightLanguages     Int     @default(5)

  // Match tier cutoffs (spec §30) — admin-configurable, must stay descending.
  thresholdExcellent Int @default(90)
  thresholdVeryGood  Int @default(80)
  thresholdGood      Int @default(65)
  thresholdPossible  Int @default(50)

  // Hard requirement vs soft preference per category (spec §27). When true,
  // a candidate failing that category is excluded from results rather than
  // just scored low — see src/lib/matching.ts.
  hardRequirementAge           Boolean @default(false)
  hardRequirementLocation      Boolean @default(false)
  hardRequirementEducation     Boolean @default(false)
  hardRequirementProfession    Boolean @default(false)
  hardRequirementIncome        Boolean @default(false)
  hardRequirementMaritalStatus Boolean @default(false)
  hardRequirementHeight        Boolean @default(false)
  hardRequirementFamily        Boolean @default(false)
  hardRequirementReligious     Boolean @default(false)
  hardRequirementLifestyle     Boolean @default(false)
  hardRequirementLanguages     Boolean @default(false)

  // Per-category on/off (STEP 6 §5) — distinct from weight/hard-requirement:
  // a disabled category is skipped entirely (not scored, not shown), and its
  // weight no longer counts toward the normalization denominator in
  // src/lib/matching.ts.
  categoryEnabledAge           Boolean @default(true)
  categoryEnabledLocation      Boolean @default(true)
  categoryEnabledEducation     Boolean @default(true)
  categoryEnabledProfession    Boolean @default(true)
  categoryEnabledIncome        Boolean @default(true)
  categoryEnabledMaritalStatus Boolean @default(true)
  categoryEnabledHeight        Boolean @default(true)
  categoryEnabledFamily        Boolean @default(true)
  categoryEnabledReligious     Boolean @default(true)
  categoryEnabledLifestyle     Boolean @default(true)
  categoryEnabledLanguages     Boolean @default(true)

  // Matching Center behavior (STEP 6 §19/§43).
  maxMatchResults                Int     @default(10)
  excludeHardRequirementFailures Boolean @default(false)

  // Verification & Trust (STEP 8).
  documentVerificationEnabled        Boolean @default(false)
  acceptedDocumentTypes              String? // JSON array of DocumentType strings
  allowPartiallyVerifiedManualMatch  Boolean @default(false)
  removeFromPoolDuringReVerification Boolean @default(true)
  autoReVerificationOnKeyFieldChange Boolean @default(true)
  otpExpiryMinutes                   Int     @default(10)
  otpMaxAttempts                     Int     @default(5)

  // Notification & Communication (STEP 9). SMS/WhatsApp default off since no
  // real provider is configured in this environment — see
  // src/lib/notifications/providers/.
  emailNotificationsEnabled    Boolean @default(true)
  smsNotificationsEnabled      Boolean @default(false)
  whatsappNotificationsEnabled Boolean @default(false)
  inAppNotificationsEnabled    Boolean @default(true)
  defaultNotificationLanguage  Locale  @default(EN)
  meetingReminder24hEnabled    Boolean @default(true)
  meetingReminder2hEnabled     Boolean @default(true)
  followUpReminderEnabled      Boolean @default(true)
  pendingProposalReminderDays  Int     @default(3)
  notificationRetryLimit       Int     @default(3)
  quietHoursStart              Int? // hour of day, 0-23 — applied only to cron-triggered non-essential reminders
  quietHoursEnd                Int?

  // Reports & Analytics (STEP 10) — admin-configurable bucket definitions;
  // null means "use the built-in defaults" (see src/lib/reports/buckets.ts).
  ageRangeBuckets      Json?
  incomeRangeBuckets   Json?
  professionCategories Json?

  // Staff Management & Permissions (STEP 11). Session duration is NOT
  // configurable here — NextAuth's JWT maxAge is fixed at Edge config
  // construction time (src/lib/auth.config.ts) and can't do a DB read there
  // without breaking the Edge/Node split that keeps middleware under
  // Vercel's bundle limit; the 30-day default stays hardcoded.
  loginMaxAttempts       Int   @default(5)
  loginLockoutMinutes    Int   @default(15)
  twoFactorRequiredRoles Json? // array of AdminRole strings
  passwordMinLength      Int   @default(8)

  // Support, Complaints, Safety & Case Management (STEP 12) — SLA is elapsed
  // wall-clock hours, not a business-hours/holiday calendar (no such
  // infrastructure exists anywhere in this codebase — see src/lib/case-sla.ts).
  caseSlaNormalFirstResponseHours   Int @default(24)
  caseSlaNormalResolutionHours      Int @default(72)
  caseSlaHighFirstResponseHours     Int @default(8)
  caseSlaHighResolutionHours        Int @default(24)
  caseSlaUrgentFirstResponseHours   Int @default(2)
  caseSlaUrgentResolutionHours      Int @default(8)
  caseSlaCriticalFirstResponseHours Int @default(1)
  caseSlaCriticalResolutionHours    Int @default(4)

  // Payments & Billing (STEP 14). paidFeatureKeys is the Super-Admin
  // "which features currently require an entitlement" switch (spec §1) —
  // empty by default, so nothing is gated unless explicitly turned on.
  activePaymentProvider                 PaymentProviderName @default(MANUAL)
  defaultCurrencyCode                   String              @default("PKR")
  subscriptionGracePeriodDays           Int                 @default(7)
  paymentRetryLimit                     Int                 @default(3)
  refundApprovalRequiredAboveMinorUnits Int?
  paidFeatureKeys                       Json?

  // Payment Rollout Phases (STEP 14 add-on). Stage gates new checkout
  // sessions only — never touches existing subscriptions/invoices/refunds.
  // Defaults reflect the honest current state: nothing has been through
  // sandbox testing yet, so payments start fully DISABLED.
  paymentRolloutStage              PaymentRolloutStage @default(DISABLED)
  paymentsEnabled                  Boolean             @default(false)
  checkoutEnabled                  Boolean             @default(false)
  subscriptionsEnabled             Boolean             @default(false)
  refundsEnabled                   Boolean             @default(true)
  manualPaymentEnabled             Boolean             @default(true)
  betaEnabled                      Boolean             @default(false)
  publicCheckoutEnabled            Boolean             @default(false)
  providerWebhooksEnabled          Boolean             @default(true)
  paymentBetaPercentage            Int                 @default(0)
  paymentBetaAllowedProfileIds     Json?
  paymentBetaAllowedCountries      Json?
  paymentBetaAllowedPackageIds     Json?
  paymentInternalAllowedProfileIds Json?
  reconciliationFrequency          String              @default("DAILY")
  lastScheduledReconciliationAt    DateTime?

  updatedAt DateTime @updatedAt
}

enum PaymentRolloutStage {
  DISABLED
  SANDBOX
  INTERNAL
  BETA
  PRODUCTION
}

// Audit trail for payment rollout-stage transitions (STEP 14 add-on §78),
// distinct from the generic AuditLog entry written alongside it — this one
// captures the state-machine history specifically.
model PaymentRolloutEvent {
  id        String               @id @default(cuid())
  fromStage PaymentRolloutStage?
  toStage   PaymentRolloutStage
  reason    String?
  actorId   String
  actor     AdminUser            @relation(fields: [actorId], references: [id])
  createdAt DateTime             @default(now())

  @@index([createdAt])
}

// Running counter backing the human-readable LPP-###### profile codes.
model ProfileCodeCounter {
  id      Int @id @default(1)
  lastSeq Int @default(0)
}

// ---------- Notification & Communication (STEP 9) ----------

// Persisted, per-recipient in-app notification — drives the user and admin
// bells. Exactly one of recipientProfileId/recipientAdminId is set, mirroring
// ProposalEvent's performedByAdmin/performedByProfile pattern. Never created
// directly — always via src/lib/notifications/notification-service.ts.
model Notification {
  id                 String           @id @default(cuid())
  recipientProfileId String?
  recipientAdminId   String?
  type               NotificationType
  title              String
  body               String // privacy-safe, generic copy only — see spec §33
  relatedProposalId  String?
  relatedProfileId   String?
  actionUrl          String?
  readAt             DateTime?
  createdAt          DateTime         @default(now())

  recipientProfile Profile?   @relation("NotificationRecipientProfile", fields: [recipientProfileId], references: [id], onDelete: Cascade)
  recipientAdmin   AdminUser? @relation("NotificationRecipientAdmin", fields: [recipientAdminId], references: [id])
  relatedProposal  Proposal?  @relation(fields: [relatedProposalId], references: [id], onDelete: SetNull)
  relatedProfile   Profile?   @relation("NotificationRelatedProfile", fields: [relatedProfileId], references: [id], onDelete: SetNull)

  @@index([recipientProfileId, readAt, createdAt])
  @@index([recipientAdminId, readAt, createdAt])
  @@index([type])
}

// The automated outbound-notification delivery record (spec §15) — distinct
// from the pre-existing Communication model, which is an admin's manual
// "I called/emailed the applicant" log. One row per channel per
// sendNotification() call, including IN_APP (so per-profile communication
// history, spec §26, is complete).
model CommunicationLog {
  id                 String              @id @default(cuid())
  profileId          String
  proposalId         String?
  channel            NotificationChannel
  notificationType   NotificationType
  templateKey        String?
  recipientReference String? // masked, e.g. "+92*****017" — never a raw destination
  deliveryStatus     DeliveryStatus      @default(QUEUED)
  messageBody        String? // access-gated by communication:message:view in the serializer
  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  createdById        String? // set only for admin-composed manual sends (spec §12); null for system-triggered
  providerMessageId  String?
  failureReason      String?
  retryCount         Int                 @default(0)
  isTest             Boolean             @default(false) // spec §32 — excluded from analytics totals
  createdAt          DateTime            @default(now())

  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  proposal  Proposal?  @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  createdBy AdminUser? @relation(fields: [createdById], references: [id])

  @@index([profileId, createdAt])
  @@index([proposalId])
  @@index([deliveryStatus])
  @@index([providerMessageId])
}

// One row per profile (spec §10) — non-essential notification opt-in/out per
// channel x category. Essential Account/Verification/Security types bypass
// this entirely (see src/lib/notifications/classification.ts).
model NotificationPreference {
  id        String @id @default(cuid())
  profileId String @unique

  inAppProposalUpdates   Boolean @default(true)
  inAppMeetingUpdates    Boolean @default(true)
  inAppFollowUpReminders Boolean @default(true)
  inAppMarketing         Boolean @default(false)

  emailProposalUpdates   Boolean @default(true)
  emailMeetingUpdates    Boolean @default(true)
  emailFollowUpReminders Boolean @default(true)
  emailMarketing         Boolean @default(false)

  smsProposalUpdates   Boolean @default(true)
  smsMeetingUpdates    Boolean @default(true)
  smsFollowUpReminders Boolean @default(true)
  smsMarketing         Boolean @default(false)

  whatsappProposalUpdates   Boolean @default(true)
  whatsappMeetingUpdates    Boolean @default(true)
  whatsappFollowUpReminders Boolean @default(true)
  whatsappMarketing         Boolean @default(false)

  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// Per-channel consent CURRENT STATE (spec §25) — distinct from preferences
// above. In-app needs no consent row; only EMAIL/SMS/WHATSAPP are tracked
// here at the application layer.
model CommunicationConsent {
  id            String              @id @default(cuid())
  profileId     String
  channel       NotificationChannel
  status        ConsentStatus       @default(GRANTED)
  consentedAt   DateTime            @default(now())
  consentSource String
  revokedAt     DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, channel])
}

// Admin-editable override for a (event, channel, language) combination
// (spec §19). If no ACTIVE row exists, src/lib/notifications/template-resolver.ts
// falls back to the built-in default-templates.ts dictionary, then to English.
model NotificationTemplate {
  id          String              @id @default(cuid())
  name        String
  event       String // matches an event key in src/lib/notifications/events.ts
  channel     NotificationChannel
  language    Locale
  subject     String?
  message     String
  status      TemplateStatus      @default(ACTIVE)
  variables   Json // allow-listed {{variable}} names only — never arbitrary/sensitive
  updatedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  updatedBy AdminUser? @relation(fields: [updatedById], references: [id])

  @@unique([event, channel, language])
}

// Idempotent webhook intake log (spec §28) — no real provider exists in this
// environment; the admin "Simulate Webhook" action exercises this same path.
model WebhookEvent {
  id                String    @id @default(cuid())
  provider          String
  eventType         String // DELIVERED | READ | FAILED | BOUNCED
  providerMessageId String?
  idempotencyKey    String    @unique
  payload           Json?
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
}

// ---------- Reports & Analytics (STEP 10) ----------

enum ReportExportType {
  CSV
  EXCEL
  PDF
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// One row per generated/exported report (spec §24 "Report History"). Never
// stores the actual exported file bytes — only enough metadata to audit and
// regenerate (spec §24 "do not store unnecessary sensitive copies").
model ReportExecution {
  id          String            @id @default(cuid())
  name        String
  reportKey   String // "overview" | "registration" | ... | "custom"
  dataSource  String? // set only when reportKey="custom": Profiles|Verification|Matches|Proposals|Meetings|Communications|FollowUps
  filters     Json
  columns     Json?
  groupBy     String?
  sortBy      String?
  exportType  ReportExportType?
  recordCount Int
  createdById String
  createdBy   AdminUser         @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([createdById])
  @@index([createdAt])
  @@index([reportKey])
}

// Super-Admin-configured recurring report delivery (spec §25). Evaluated by
// the existing once-daily notifications cron tick (this Vercel account's
// Hobby plan rejects any more-frequent cron job) — see
// src/lib/reports/scheduler.ts.
model ScheduledReport {
  id                String           @id @default(cuid())
  name              String
  reportKey         String
  dataSource        String?
  filters           Json
  frequency         ReportFrequency
  dayOfWeek         Int? // 0-6, WEEKLY only
  dayOfMonth        Int? // 1-28, MONTHLY only (capped to dodge month-length edge cases)
  hourUtc           Int
  exportType        ReportExportType @default(CSV)
  recipientAdminIds Json // string[] of AdminUser ids
  lastRunAt         DateTime?
  nextRunAt         DateTime
  active            Boolean          @default(true)
  createdById       String
  createdBy         AdminUser        @relation(fields: [createdById], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([active, nextRunAt])
}

// ---------- Staff Management & Permissions (STEP 11) ----------

// Metadata-only registry for the Permission Matrix UI's checkbox grid — NOT
// the authorization source of truth (that's the `Permission` TS union in
// src/lib/permissions.ts). Keys must match those strings exactly.
model PermissionDef {
  key         String  @id
  module      String
  action      String
  description String?

  customRoles CustomRolePermission[]
}

// Additive on top of the 4 hardcoded system roles (SUPER_ADMIN/ADMIN/STAFF/
// VIEWER) — see src/lib/effective-permissions.ts. baseRole determines
// row-scoping shape (STAFF-style assigned-only access) and must be STAFF or
// VIEWER, enforced in the API route, not the DB.
model CustomRole {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  baseRole    AdminRole @default(STAFF)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // STEP 17 §42 — closes out the custom-role fields the spec asks for beyond
  // what STEP 11 already built (id/name/description/permissions/active above).
  // Both optional/defaulted: an existing custom role with neither set behaves
  // exactly as before.
  allowedRecordTypes AssignmentResourceType[] @default([])
  defaultAccessLevel AccessLevel?

  permissions CustomRolePermission[]
  admins      AdminUser[]
}

model CustomRolePermission {
  customRole    CustomRole    @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  customRoleId  String
  permission    PermissionDef @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  permissionKey String

  @@id([customRoleId, permissionKey])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  admins           AdminUser[]
  tasks            AdminTask[]
  approvalRequests ApprovalRequest[]
  savedSearches    SavedSearch[]
}

// Tracks a live JWT session for revocation (spec §13) — the JWT itself
// embeds this row's id as `sid`; requireAdmin() checks it on every request
// (see src/lib/route-guard.ts). Not read by the Edge-safe auth callbacks.
model AdminSession {
  id           String    @id @default(cuid())
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId      String
  deviceInfo   String?
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedById  String?

  @@index([adminId])
}

// Durable login-attempt ledger (spec §14) — also the source of truth for
// lockout (see src/lib/auth.ts's precheck), deliberately not the in-memory
// rateLimit() helper, which doesn't survive serverless cold starts.
model AdminLoginHistory {
  id        String            @id @default(cuid())
  admin     AdminUser?        @relation(fields: [adminId], references: [id])
  adminId   String?
  email     String
  event     LoginHistoryEvent
  ipAddress String?
  userAgent String?
  createdAt DateTime          @default(now())

  @@index([adminId])
  @@index([email, createdAt])
}

// Email-OTP 2FA challenge (spec §12) — mirrors STEP 8's
// src/lib/verification/otp.ts hashed-code/expiry/max-attempts convention.
model AdminOtpChallenge {
  id          String    @id @default(cuid())
  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId     String
  purpose     String    @default("LOGIN_2FA")
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminId])
}

// Unified assignment-tracking table (spec §7/§8/§20) — additive alongside
// the existing Proposal/ProfileVerification/SecurityFlag assignedToId
// columns (those + their access-check helpers are untouched). This is the
// ONLY backing store for Profile and FollowUp assignment, which have no FK
// column of their own.
model AdminAssignment {
  id           String                 @id @default(cuid())
  admin        AdminUser              @relation("AdminAssignmentAssignee", fields: [adminId], references: [id])
  adminId      String
  resourceType AssignmentResourceType
  resourceId   String
  priority     AssignmentPriority     @default(NORMAL)
  status       AssignmentStatus       @default(ASSIGNED)
  // STEP 17 §3 — the level this assignment grants; defaults to MANAGE, i.e. the
  // full "owner" access every assignment has always implicitly granted, so
  // every pre-STEP-17 row keeps its current effective behavior unchanged.
  accessLevel  AccessLevel            @default(MANAGE)
  assignedAt   DateTime               @default(now())
  dueAt        DateTime?
  // STEP 17 §20 — temporary access. Checked lazily at read time by every
  // access-check helper (an assignment past expiresAt is treated as if it
  // doesn't exist) — same lazy-expiry convention as BreakGlassAccess.expiresAt
  // and ProfileRestriction.endDate. No cron sweep; null = never expires.
  expiresAt    DateTime?
  notes        String?
  createdBy    AdminUser              @relation("AdminAssignmentCreator", fields: [createdById], references: [id])
  createdById  String

  @@index([adminId, resourceType])
  @@index([resourceType, resourceId])
  @@index([status])
}

// Discrete staff work items (spec §23/§24), auto-created at existing STEP 9
// notification trigger points — see src/lib/admin-tasks.ts. STEP 18 extends
// this table additively into the full Workflow & Task Management system
// (src/lib/workflow/engine.ts) rather than replacing it — every column below
// this line is nullable/defaulted so pre-STEP-18 rows keep their exact
// current behavior.
model AdminTask {
  id           String                 @id @default(cuid())
  assignedTo   AdminUser?             @relation("AdminTaskAssignee", fields: [assignedToId], references: [id])
  assignedToId String?
  taskType     AdminTaskType
  resourceType AssignmentResourceType
  resourceId   String
  priority     AssignmentPriority     @default(NORMAL)
  status       AdminTaskStatus        @default(PENDING)
  dueAt        DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime               @default(now())

  // ---------- STEP 18 additions (all nullable/defaulted) ----------
  taskCode             String?              @unique // LPP-TASK-###### via src/lib/privacy/codes.ts
  title                String?
  description          String?
  startedAt            DateTime?
  completionNotes      String?
  escalationLevel      Int                  @default(1)
  escalationStatus     TaskEscalationStatus @default(NONE)
  parentTask           AdminTask?           @relation("TaskParent", fields: [parentTaskId], references: [id])
  parentTaskId         String?
  childTasks           AdminTask[]          @relation("TaskParent")
  accessLevel          AccessLevel          @default(MANAGE)
  visibility           TaskVisibility       @default(STANDARD)
  version              Int                  @default(1)
  createdBy            AdminUser?           @relation("AdminTaskCreator", fields: [createdById], references: [id])
  createdById          String?
  assignedDepartment   Department?          @relation(fields: [assignedDepartmentId], references: [id])
  assignedDepartmentId String?
  outcome              String?
  updatedAt            DateTime             @updatedAt

  comments         TaskComment[]
  checklistItems   TaskChecklistItem[]
  dependsOn        TaskDependency[]    @relation("TaskDependent")
  dependedOnBy     TaskDependency[]    @relation("TaskDependsOn")
  escalations      TaskEscalation[]
  statusHistory    TaskStatusHistory[]
  attachments      TaskAttachment[]
  accessLogs       TaskAccessLog[]
  workflowEvents   WorkflowEvent[]
  workflowFailures WorkflowFailure[]
  approvalRequest  ApprovalRequest? // STEP 19 — the approval this review task was created for, if any

  @@index([assignedToId, status])
  @@index([resourceType, resourceId])
  @@index([status, dueAt])
  @@index([escalationLevel, escalationStatus])
  @@index([parentTaskId])
  @@index([assignedDepartmentId])
}

enum TaskEscalationStatus {
  NONE
  ESCALATED
  RESOLVED
}

enum TaskVisibility {
  STANDARD
  RESTRICTED
}

enum TaskCommentVisibility {
  INTERNAL
  TEAM
  MANAGER_ONLY
  SYSTEM
}

enum TaskDependencyType {
  BLOCKS
  DEPENDS_ON
}

enum WorkflowFailureStage {
  EVENT_RECEIVED
  TASK_CREATION
  ASSIGNMENT
  NOTIFICATION
  TRANSITION
}

enum WorkflowEventStatus {
  PENDING
  PROCESSED
  FAILED
}

// Internal task discussion — never exposed through any user/applicant-facing
// API (spec §17). Mirrors CaseComment's visibility-tiering convention.
model TaskComment {
  id                String                @id @default(cuid())
  task              AdminTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId            String
  author            AdminUser             @relation(fields: [authorId], references: [id])
  authorId          String
  body              String
  visibility        TaskCommentVisibility @default(INTERNAL)
  mentionedAdminIds String[]              @default([])
  createdAt         DateTime              @default(now())
  editedAt          DateTime?
  deletedAt         DateTime?

  @@index([taskId])
}

// Flat checklist rows (spec §27) — no separate "checklist" grouping row;
// TaskTemplate.defaultChecklist seeds these at task-creation time.
model TaskChecklistItem {
  id            String     @id @default(cuid())
  task          AdminTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId        String
  label         String
  required      Boolean    @default(false)
  order         Int        @default(0)
  completedAt   DateTime?
  completedBy   AdminUser? @relation(fields: [completedById], references: [id])
  completedById String?

  @@index([taskId])
}

// BLOCKED_BY / DEPENDS_ON (spec §18) — cycle detection enforced in
// src/lib/workflow/dependencies.ts, not at the DB level.
model TaskDependency {
  id              String             @id @default(cuid())
  task            AdminTask          @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  taskId          String
  dependsOnTask   AdminTask          @relation("TaskDependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String
  type            TaskDependencyType @default(DEPENDS_ON)
  createdAt       DateTime           @default(now())
  createdBy       AdminUser          @relation(fields: [createdById], references: [id])
  createdById     String

  @@unique([taskId, dependsOnTaskId])
}

// Mirrors CaseEscalation's shape exactly (spec §22/§46).
model TaskEscalation {
  id            String     @id @default(cuid())
  task          AdminTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId        String
  previousLevel Int
  newLevel      Int
  reason        String
  escalatedBy   AdminUser? @relation(fields: [escalatedById], references: [id])
  escalatedById String?
  createdAt     DateTime   @default(now())

  @@index([taskId])
}

// Mirrors CaseStatusHistory's shape exactly (spec §10/§46 timeline).
model TaskStatusHistory {
  id             String          @id @default(cuid())
  task           AdminTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId         String
  previousStatus AdminTaskStatus
  newStatus      AdminTaskStatus
  changedBy      AdminUser?      @relation(fields: [changedById], references: [id])
  changedById    String?
  reason         String?
  createdAt      DateTime        @default(now())

  @@index([taskId])
}

// Mirrors case-evidence-storage.ts's shape exactly (spec §49) — encrypted
// Blob storage, opaque storageKey, never a public URL.
model TaskAttachment {
  id            String    @id @default(cuid())
  task          AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId        String
  filename      String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  ivBase64      String
  authTagBase64 String
  uploadedBy    AdminUser @relation(fields: [uploadedById], references: [id])
  uploadedById  String
  createdAt     DateTime  @default(now())

  @@index([taskId])
}

// Mirrors CaseAccessLog — written on every task-access-chain evaluation,
// allow or deny (spec §14), independent of the global AuditLog.
model TaskAccessLog {
  id         String    @id @default(cuid())
  task       AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  admin      AdminUser @relation(fields: [adminId], references: [id])
  adminId    String
  action     String
  allowed    Boolean
  denyReason String?
  createdAt  DateTime  @default(now())

  @@index([taskId])
  @@index([adminId])
}

// Admin-configurable task templates (spec §26/§27).
model TaskTemplate {
  id                  String             @id @default(cuid())
  name                String
  taskType            AdminTaskType
  titleTemplate       String
  descriptionTemplate String?
  defaultPriority     AssignmentPriority @default(NORMAL)
  defaultChecklist    Json?
  active              Boolean            @default(true)
  createdBy           AdminUser?         @relation(fields: [createdById], references: [id])
  createdById         String?
  createdAt           DateTime           @default(now())
}

// Admin-configurable SLA targets per task type (spec §20) — deliberately a
// real table, not flat AppSettings columns (unlike Case's 5-priority scheme,
// ~25 task types would mean 50+ flat columns).
model TaskSlaConfig {
  id                    String        @id @default(cuid())
  taskType              AdminTaskType @unique
  targetResponseHours   Int?
  targetResolutionHours Int?
  warningThresholdHours Int?
  active                Boolean       @default(true)
}

// Admin-configurable event→task-type automation table (spec §19), seeded
// with the spec's default rules and editable afterward.
model WorkflowRule {
  id                          String             @id @default(cuid())
  eventName                   String             @unique
  taskType                    AdminTaskType
  defaultPriority             AssignmentPriority @default(NORMAL)
  defaultAssignedRole         AdminRole?
  defaultAssignedDepartmentId String?
  active                      Boolean            @default(true)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
}

// Idempotency ledger for automatic task creation (spec §53/§54) — dedupKey
// is derived from sourceType+sourceId+eventName so re-delivering the same
// event never creates a duplicate task.
model WorkflowEvent {
  id          String                 @id @default(cuid())
  eventName   String
  dedupKey    String                 @unique
  sourceType  AssignmentResourceType
  sourceId    String
  payload     Json?
  status      WorkflowEventStatus    @default(PENDING)
  task        AdminTask?             @relation(fields: [taskId], references: [id])
  taskId      String?
  attempts    Int                    @default(0)
  lastError   String?
  createdAt   DateTime               @default(now())
  processedAt DateTime?
  failures    WorkflowFailure[]

  @@index([status])
  @@index([sourceType, sourceId])
}

// Dead-letter queue (spec §65/§66) — Admin → Workflow Failures.
model WorkflowFailure {
  id               String               @id @default(cuid())
  workflowEvent    WorkflowEvent?       @relation(fields: [workflowEventId], references: [id])
  workflowEventId  String?
  task             AdminTask?           @relation(fields: [taskId], references: [id])
  taskId           String?
  stage            WorkflowFailureStage
  errorMessage     String
  resolvedAt       DateTime?
  resolvedBy       AdminUser?           @relation(fields: [resolvedById], references: [id])
  resolvedById     String?
  resolution       String?
  resolutionReason String?
  createdAt        DateTime             @default(now())

  @@index([resolvedAt])
}

// Temporary unavailability + backup routing (spec §44).
model StaffAvailability {
  id            String     @id @default(cuid())
  admin         AdminUser  @relation("StaffAvailabilityAdmin", fields: [adminId], references: [id])
  adminId       String
  startAt       DateTime
  endAt         DateTime
  reason        String?
  backupAdmin   AdminUser? @relation("StaffAvailabilityBackup", fields: [backupAdminId], references: [id])
  backupAdminId String?
  active        Boolean    @default(true)
  createdBy     AdminUser  @relation("StaffAvailabilityCreator", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime   @default(now())

  @@index([adminId, active])
}

// Controlled, time-limited, read-only support-impersonation grant (spec
// §18) — see src/lib/view-as.ts. Never grants access to passwords or OTPs.
model ViewAsSession {
  id            String    @id @default(cuid())
  superAdmin    AdminUser @relation("ViewAsInitiator", fields: [superAdminId], references: [id])
  superAdminId  String
  targetAdmin   AdminUser @relation("ViewAsTarget", fields: [targetAdminId], references: [id])
  targetAdminId String
  reason        String
  startedAt     DateTime  @default(now())
  expiresAt     DateTime
  endedAt       DateTime?

  @@index([superAdminId])
  @@index([targetAdminId])
}

// ---------- Support, Complaints, Safety & Case Management (STEP 12) ----------

// One unified table for every support request, complaint, safety report, and
// internal case (spec §6 — "every complaint, safety report, or support issue
// becomes a Case"). caseNumber's prefix is chosen by `type` at creation (see
// src/lib/case-code.ts): SUPPORT->LPP-SUP-, COMPLAINT->LPP-CMP-,
// SAFETY_REPORT/INTERNAL->LPP-CASE-. relatedProposalId/relatedMeetingId/
// relatedVerificationId/relatedCommunicationId are plain ids with no FK
// relation, mirroring AdminAssignment/AdminTask's resourceId convention —
// resolved by application code, not a Prisma include.
model Case {
  id              String       @id @default(cuid())
  caseNumber      String       @unique
  type            CaseType
  category        CaseCategory
  subject         String
  description     String
  priority        CasePriority @default(NORMAL)
  status          CaseStatus   @default(NEW)
  escalationLevel Int          @default(1)

  reporterProfile   Profile?   @relation("CaseReporterProfile", fields: [reporterProfileId], references: [id])
  reporterProfileId String?
  reportedProfile   Profile?   @relation("CaseReportedProfile", fields: [reportedProfileId], references: [id])
  reportedProfileId String?
  reportedAdmin     AdminUser? @relation("CaseReportedAdmin", fields: [reportedAdminId], references: [id])
  reportedAdminId   String?

  relatedProposalId      String?
  relatedMeetingId       String?
  relatedVerificationId  String?
  relatedCommunicationId String?
  relatedPaymentId       String? // STEP 14 — PAYMENT_BILLING cases, plain id, same convention
  relatedInvoiceId       String?

  preferredResponseMethod String?
  firstResponseDueAt      DateTime?
  resolutionDueAt         DateTime?
  firstRespondedAt        DateTime?

  mergedIntoCaseId String?
  createdBy        AdminUser? @relation("CaseCreatedBy", fields: [createdById], references: [id])
  createdById      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  closedAt         DateTime?
  softDeletedAt    DateTime?

  accessGrants  CaseAccessGrant[]
  comments      CaseComment[]
  internalNotes CaseInternalNote[]
  evidence      CaseEvidence[]
  statusHistory CaseStatusHistory[]
  escalations   CaseEscalation[]
  resolution    CaseResolution?
  accessLogs    CaseAccessLog[]
  linksFrom     CaseLink[]          @relation("CaseLinkSource")
  linksTo       CaseLink[]          @relation("CaseLinkTarget")

  @@index([type, status])
  @@index([category])
  @@index([priority, status])
  @@index([reporterProfileId])
  @@index([reportedProfileId])
  @@index([reportedAdminId])
  @@index([createdAt])
}

model CaseAccessGrant {
  id          String          @id @default(cuid())
  case        Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String
  admin       AdminUser       @relation("CaseAccessGrantee", fields: [adminId], references: [id])
  adminId     String
  level       CaseAccessLevel
  grantedBy   AdminUser       @relation("CaseAccessGranter", fields: [grantedById], references: [id])
  grantedById String
  grantedAt   DateTime        @default(now())

  @@unique([caseId, adminId])
}

// User-visible responses (visibleToUser: true) vs. internal back-and-forth
// among staff (false) — never confused with CaseInternalNote, which is
// staff-only investigation material, not conversational.
model CaseComment {
  id              String     @id @default(cuid())
  case            Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId          String
  authorAdmin     AdminUser? @relation(fields: [authorAdminId], references: [id])
  authorAdminId   String?
  authorProfile   Profile?   @relation(fields: [authorProfileId], references: [id])
  authorProfileId String?
  body            String
  visibleToUser   Boolean    @default(true)
  createdAt       DateTime   @default(now())

  @@index([caseId])
}

model CaseInternalNote {
  id        String        @id @default(cuid())
  case      Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  admin     AdminUser     @relation(fields: [adminId], references: [id])
  adminId   String
  body      String
  level     CaseNoteLevel @default(STAFF)
  createdAt DateTime      @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([caseId])
}

// Mirrors VerificationDocument's encrypt-then-blob shape exactly (spec §12) —
// see src/lib/case-evidence-storage.ts.
model CaseEvidence {
  id                     String     @id @default(cuid())
  case                   Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId                 String
  uploadedByAdmin        AdminUser? @relation(fields: [uploadedByAdminId], references: [id])
  uploadedByAdminId      String?
  uploadedByProfile      Profile?   @relation(fields: [uploadedByProfileId], references: [id])
  uploadedByProfileId    String?
  secureStorageReference String
  ivBase64               String
  authTagBase64          String
  mimeType               String
  sizeBytes              Int
  originalFilename       String?
  createdAt              DateTime   @default(now())

  @@index([caseId])
}

model CaseStatusHistory {
  id          String      @id @default(cuid())
  case        Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String
  fromStatus  CaseStatus?
  toStatus    CaseStatus
  // Nullable — a user-driven transition (e.g. responding to an info
  // request) has no admin actor; changedById is set only for admin-driven
  // status changes.
  changedBy   AdminUser?  @relation(fields: [changedById], references: [id])
  changedById String?
  reason      String?
  createdAt   DateTime    @default(now())

  @@index([caseId])
}

model CaseEscalation {
  id            String    @id @default(cuid())
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId        String
  previousLevel Int
  newLevel      Int
  reason        String
  escalatedBy   AdminUser @relation(fields: [escalatedById], references: [id])
  escalatedById String
  createdAt     DateTime  @default(now())

  @@index([caseId])
}

model CaseResolution {
  id               String             @id @default(cuid())
  case             Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId           String             @unique
  category         ResolutionCategory
  summary          String
  actionTaken      String?
  followUpRequired Boolean            @default(false)
  followUpDate     DateTime?
  resolvedBy       AdminUser          @relation(fields: [resolvedById], references: [id])
  resolvedById     String
  createdAt        DateTime           @default(now())
}

model CaseLink {
  id           String       @id @default(cuid())
  case         Case         @relation("CaseLinkSource", fields: [caseId], references: [id], onDelete: Cascade)
  caseId       String
  linkedCase   Case         @relation("CaseLinkTarget", fields: [linkedCaseId], references: [id])
  linkedCaseId String
  linkType     CaseLinkType
  createdBy    AdminUser    @relation(fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime     @default(now())

  @@unique([caseId, linkedCaseId, linkType])
}

// Preserves both cases' full history (spec §28 — "never silently delete the
// original case history"); the source case is closed with mergedIntoCaseId
// set, never deleted.
model CaseMerge {
  id           String    @id @default(cuid())
  sourceCaseId String
  targetCaseId String
  reason       String
  mergedBy     AdminUser @relation(fields: [mergedById], references: [id])
  mergedById   String
  createdAt    DateTime  @default(now())
}

// Thin per-case access trail (evidence/note views, downloads) kept separate
// from the global AuditLog so "who viewed this case" queries don't scan the
// whole audit table — every entry here is also mirrored into AuditLog via
// writeAudit() for the platform-wide trail (spec §12/§33).
model CaseAccessLog {
  id        String    @id @default(cuid())
  case      Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  admin     AdminUser @relation(fields: [adminId], references: [id])
  adminId   String
  action    String
  createdAt DateTime  @default(now())

  @@index([caseId])
}

// Independent, scoped, optionally time-boxed restrictions (spec §18) — NOT a
// replacement for the existing blunt Profile.status=SUSPENDED lifecycle
// (src/lib/verification/status.ts's suspendProfile()), which stays as the
// full-suspension path. endDate is evaluated lazily at check time (see
// src/lib/profile-restrictions.ts) — no cron sweep, matching this codebase's
// existing lazy-expiry convention for OTPs/documents.
model ProfileRestriction {
  id              String          @id @default(cuid())
  profile         Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId       String
  restrictionType RestrictionType
  reason          String
  appliedBy       AdminUser       @relation("RestrictionAppliedBy", fields: [appliedById], references: [id])
  appliedById     String
  startDate       DateTime        @default(now())
  endDate         DateTime?
  active          Boolean         @default(true)
  caseId          String?
  liftedBy        AdminUser?      @relation("RestrictionLiftedBy", fields: [liftedById], references: [id])
  liftedById      String?
  liftedAt        DateTime?
  createdAt       DateTime        @default(now())

  @@index([profileId, active])
}

// Rows keyed by prefix ("SUP","CMP","CASE") — mirrors ProposalCodeCounter's
// single-row-per-key pattern. See src/lib/case-code.ts.
model CaseCodeCounter {
  prefix  String @id
  lastSeq Int    @default(0)
}

// ---------- Support ----------

model SupportMessage {
  id          String   @id @default(cuid())
  profileCode String?
  email       String
  subject     String
  message     String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([resolved])
}

// ---------- Data Privacy, Consent, Account Management & Retention (STEP 13) ----------

// Append-only consent history ledger (spec §3/§4/§5) — never updated or
// deleted; a revocation is a new row with status=REVOKED, not an edit to the
// original grant. Additive to (not a replacement for) ConsentRecord and
// CommunicationConsent/NotificationPreference, which keep enforcing exactly
// what they enforce today — see src/lib/privacy/consent.ts.
model ConsentGrant {
  id         String             @id @default(cuid())
  profile    Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  category   ConsentCategory
  status     ConsentGrantStatus
  version    String
  source     String // "REGISTRATION" | "CONSENT_CENTER" | "BACKFILL" | ...
  ipHash     String?
  recordedAt DateTime           @default(now())

  @@index([profileId, category, recordedAt])
}

// LPP-DEL-###### (spec §14/§15).
model AccountDeletionRequest {
  id              String                @id @default(cuid())
  requestCode     String                @unique
  profile         Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId       String
  status          DeletionRequestStatus @default(SUBMITTED)
  mode            DeletionMode?
  reason          String?
  submittedAt     DateTime              @default(now())
  reviewedBy      AdminUser?            @relation(fields: [reviewedById], references: [id])
  reviewedById    String?
  reviewedAt      DateTime?
  scheduledFor    DateTime?
  completedAt     DateTime?
  rejectionReason String?

  @@index([profileId])
  @@index([status])
}

// LPP-PRIV-###### (spec §22) — a thin router: for request types with their
// own dedicated flow (Deletion/Export/Correction/Withdraw-Consent), this row
// tracks status and links to the underlying record rather than duplicating
// its logic. See src/lib/privacy/privacy-request.ts.
model PrivacyRequest {
  id               String               @id @default(cuid())
  requestCode      String               @unique
  profile          Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId        String
  type             PrivacyRequestType
  status           PrivacyRequestStatus @default(SUBMITTED)
  description      String?
  linkedRecordType String?
  linkedRecordId   String?
  handledBy        AdminUser?           @relation(fields: [handledById], references: [id])
  handledById      String?
  resolutionNote   String?
  submittedAt      DateTime             @default(now())
  resolvedAt       DateTime?

  @@index([profileId])
  @@index([status])
}

// Super-Admin configured per category (spec §16) — no hard-coded periods.
model RetentionPolicy {
  id            String          @id @default(cuid())
  category      DataCategory    @unique
  retentionDays Int
  action        RetentionAction
  isActive      Boolean         @default(true)
  updatedBy     AdminUser?      @relation(fields: [updatedById], references: [id])
  updatedById   String?
  updatedAt     DateTime        @updatedAt
}

// Legal/administrative hold (spec §18) — either profile-scoped or targeted
// at a specific record type+id. Lazy-checked by the retention job, no cron
// sweep of its own, mirroring ProfileRestriction's lazy-expiry precedent.
model DataHold {
  id         String     @id @default(cuid())
  profileId  String?
  recordType String?
  recordId   String?
  reason     String
  placedBy   AdminUser  @relation("DataHoldPlacedBy", fields: [placedById], references: [id])
  placedById String
  placedAt   DateTime   @default(now())
  liftedBy   AdminUser? @relation("DataHoldLiftedBy", fields: [liftedById], references: [id])
  liftedById String?
  liftedAt   DateTime?
  active     Boolean    @default(true)

  @@index([profileId, active])
  @@index([recordType, recordId, active])
}

// One row per record per retention-job outcome (spec §19) — never a
// destructive cross-record transaction; each record's action succeeds or
// fails independently and is logged here regardless.
model RetentionActionLog {
  id         String          @id @default(cuid())
  category   DataCategory
  recordType String
  recordId   String
  action     RetentionAction
  outcome    String // "APPLIED" | "SKIPPED_HOLD" | "SKIPPED_ERROR" | "REVIEW_FLAGGED"
  detail     String?
  runAt      DateTime        @default(now())

  @@index([category, runAt])
}

// "Download My Data" (spec §20/§21) — encrypted like case evidence; the
// "temporary secure download URL" is an HMAC-signed short-lived token (see
// src/lib/privacy/data-export.ts), not a stored, sweep-cleaned token row.
model DataExportRequest {
  id                     String    @id @default(cuid())
  profile                Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId              String
  format                 String // "JSON" | "CSV" | "PDF"
  secureStorageReference String?
  ivBase64               String?
  authTagBase64          String?
  status                 String    @default("PENDING") // PENDING | READY | DOWNLOADED | EXPIRED | FAILED
  expiresAt              DateTime?
  requestedAt            DateTime  @default(now())
  downloadedAt           DateTime?

  @@index([profileId])
}

// Focused, queryable-without-scanning-AuditLog access trail for
// high-sensitivity touchpoints (spec §30) — mirrors STEP 12's CaseAccessLog
// precedent. dataCategory is looked up from the static
// src/lib/privacy/data-classification.ts reference table, not computed by a
// runtime policy engine.
model PrivacyAccessLog {
  id              String             @id @default(cuid())
  actorAdmin      AdminUser?         @relation(fields: [actorAdminId], references: [id])
  actorAdminId    String?
  actorProfileId  String?
  action          String // "CONTACT_VIEWED" | "EXPORT_DOWNLOADED" | "PHOTO_VIEWED" | ...
  dataCategory    DataClassification
  targetProfileId String?
  reason          String?
  createdAt       DateTime           @default(now())

  @@index([targetProfileId, createdAt])
  @@index([actorAdminId, createdAt])
}

// Scoped narrowly to contact-reveal and case/privacy-incident access only
// (spec §31, scope confirmed with user) — not a platform-wide bypass. Fully
// audited, auto-expiring, lazy-checked like ProfileRestriction.
model BreakGlassAccess {
  id         String    @id @default(cuid())
  admin      AdminUser @relation(fields: [adminId], references: [id])
  adminId    String
  reason     String
  recordType String // "CONTACT" | "CASE"
  recordId   String
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?

  @@index([adminId])
  @@index([recordType, recordId])
}

// Makes "Active Sessions"/"Log Out Other Sessions" (spec §10/§32) real
// rather than cosmetic — mirrors AdminSession's shape. The applicant's
// signed cookie embeds this row's id; src/lib/profile-session.ts checks
// revocation on every request, same as AdminSession does for admins today.
model ProfileSession {
  id           String    @id @default(cuid())
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  deviceInfo   String?
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([profileId])
}

// Generic row-per-key counter shared by LPP-DEL-######/LPP-PRIV-###### codes
// (STEP 13) and, from STEP 14 on, LPP-PAY-/LPP-SUB-/LPP-ORD-/LPP-INV-/
// LPP-DISC-/LPP-PKG-/LPP-REF- codes too — mirrors CaseCodeCounter's exact
// shape with a reusable key instead of many near-identical single-purpose
// tables. See src/lib/privacy/codes.ts and src/lib/finance/codes.ts.
model SequenceCounter {
  key     String @id
  lastSeq Int    @default(0)
}

// ---------- Payment, Subscription, Packages & Financial Management (STEP 14) ----------
// Every amount field is an Int in minor currency units (e.g. paisa/cents) —
// never Float — per spec §4. See src/lib/finance/money.ts for the only place
// arithmetic on these happens.

model Currency {
  code             String  @id // ISO 4217, e.g. "PKR"
  symbol           String
  decimalPrecision Int     @default(2)
  active           Boolean @default(true)
}

// Super-Admin-configured receiving account(s) for the Manual/Bank Transfer
// provider (spec §43) — without at least one active row, ManualPaymentProvider
// has no real destination to show a payer, only a generic placeholder.
// Multiple active rows are all shown so a payer can choose whichever bank
// they can transfer from.
model BankAccount {
  id            String     @id @default(cuid())
  accountTitle  String
  accountNumber String
  bankName      String
  branchName    String?
  iban          String?
  active        Boolean    @default(true)
  displayOrder  Int        @default(0)
  createdBy     AdminUser? @relation(fields: [createdById], references: [id])
  createdById   String?
  createdAt     DateTime   @default(now())

  @@index([active, displayOrder])
}

model Package {
  id               String      @id @default(cuid())
  packageCode      String      @unique // LPP-PKG-######
  name             String
  description      String
  billingType      BillingType
  durationDays     Int? // null for ONE_TIME
  active           Boolean     @default(true)
  displayOrder     Int         @default(0)
  trialDays        Int         @default(0)
  refundPolicyNote String?
  createdBy        AdminUser?  @relation(fields: [createdById], references: [id])
  createdById      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  prices        PackagePrice[]
  entitlements  PackageEntitlement[]
  orderItems    OrderItem[]
  subscriptions Subscription[]

  @@index([active, displayOrder])
}

// Append-only (spec §46) — a price "change" is a new row, never an update to
// an old one. The package's current price is the latest active row ordered
// by effectiveFrom. OrderItem/InvoiceItem copy the charged amount as their
// own field, so a later price change never alters a historical invoice.
model PackagePrice {
  id            String   @id @default(cuid())
  package       Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId     String
  amountMinor   Int
  currencyCode  String
  taxInclusive  Boolean  @default(false)
  effectiveFrom DateTime @default(now())
  active        Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())

  @@index([packageId, effectiveFrom])
}

// Spec §8 — data, not code branches. featureKey is free text (e.g.
// "matching.priority", "support.priority") so a new feature never requires
// a schema change. limitValue null = unlimited.
model PackageEntitlement {
  id          String   @id @default(cuid())
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId   String
  featureKey  String
  limitValue  Int?
  resetPeriod String? // "MONTHLY" | "YEARLY" | null (lifetime for the subscription term)
  createdAt   DateTime @default(now())

  @@unique([packageId, featureKey])
}

model Subscription {
  id                     String              @id @default(cuid())
  subscriptionCode       String              @unique // LPP-SUB-######
  profile                Profile             @relation(fields: [profileId], references: [id], onDelete: Restrict)
  profileId              String
  package                Package             @relation(fields: [packageId], references: [id])
  packageId              String
  provider               PaymentProviderName
  providerSubscriptionId String?
  status                 SubscriptionStatus  @default(PENDING)
  startDate              DateTime?
  endDate                DateTime?
  renewalDate            DateTime?
  autoRenew              Boolean             @default(true)
  trialEndsAt            DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  events SubscriptionEvent[]
  orders Order[]

  @@index([profileId, status])
  @@index([status, renewalDate])
}

// Mirrors STEP 12's CaseStatusHistory precedent exactly.
model SubscriptionEvent {
  id             String              @id @default(cuid())
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  reason         String?
  createdAt      DateTime            @default(now())

  @@index([subscriptionId])
}

model Order {
  id             String        @id @default(cuid())
  orderCode      String        @unique // LPP-ORD-######
  profile        Profile       @relation(fields: [profileId], references: [id], onDelete: Restrict)
  profileId      String
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?
  status         OrderStatus   @default(DRAFT)
  currencyCode   String
  subtotalMinor  Int
  discountMinor  Int           @default(0)
  taxMinor       Int           @default(0)
  totalMinor     Int
  couponId       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?

  items    OrderItem[]
  payments Payment[]
  invoice  Invoice?

  @@index([profileId, status])
}

model OrderItem {
  id             String  @id @default(cuid())
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  package        Package @relation(fields: [packageId], references: [id])
  packageId      String
  packagePriceId String? // snapshot reference only, not a live FK dependency for amounts
  description    String
  quantity       Int     @default(1)
  unitPriceMinor Int
  discountMinor  Int     @default(0)
  taxMinor       Int     @default(0)
  totalMinor     Int

  @@index([orderId])
}

model Payment {
  id                    String              @id @default(cuid())
  paymentCode           String              @unique // LPP-PAY-######
  order                 Order               @relation(fields: [orderId], references: [id])
  orderId               String
  profile               Profile             @relation(fields: [profileId], references: [id], onDelete: Restrict)
  profileId             String
  amountMinor           Int
  currencyCode          String
  method                PaymentMethod
  provider              PaymentProviderName
  providerTransactionId String?
  status                PaymentStatus       @default(CREATED)
  createdAt             DateTime            @default(now())
  paidAt                DateTime?
  failedAt              DateTime?
  refundedAt            DateTime?

  attempts     PaymentAttempt[]
  manualDetail ManualPaymentDetail?
  invoice      Invoice?
  refunds      Refund[]

  @@unique([provider, providerTransactionId])
  @@index([profileId, status])
  @@index([orderId])
  @@index([status, createdAt]) // STEP 15 — health/cron/integrity queries
  @@index([paidAt])
}

// Provider-side retry tracking (spec §27) — never stores raw gateway
// error details, only a safe/sanitized message.
model PaymentAttempt {
  id                       String        @id @default(cuid())
  payment                  Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId                String
  attemptNumber            Int
  status                   PaymentStatus
  providerErrorCode        String?
  providerErrorMessageSafe String?
  createdAt                DateTime      @default(now())

  @@index([paymentId])
}

// 1:1 extension of a Payment with method=MANUAL — mirrors the Case+
// CaseEvidence extension-table pattern rather than a fully parallel
// manual_payments table (spec §43/§44).
model ManualPaymentDetail {
  id                   String              @id @default(cuid())
  payment              Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId            String              @unique
  referenceNumber      String
  evidenceDescription  String?
  // Either the applicant self-submitted (submittedByProfileId) or an admin
  // recorded it on the customer's behalf (enteredById) — never both.
  submittedByProfileId String?
  enteredBy            AdminUser?          @relation("ManualPaymentEnteredBy", fields: [enteredById], references: [id])
  enteredById          String?
  enteredAt            DateTime            @default(now())
  status               ManualPaymentStatus @default(PENDING_VERIFICATION)
  verifiedBy           AdminUser?          @relation("ManualPaymentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedById         String?
  verifiedAt           DateTime?
  rejectionReason      String?
}

// @@unique([provider, providerEventId]) IS the idempotency/replay-prevention
// mechanism (spec §28/§29) — a duplicate webhook delivery fails the unique
// insert and is treated as already-processed. Distinct from STEP 9's
// WebhookEvent (notification-delivery callbacks) — considered reusing it,
// rejected: payment webhooks need amount/currency-verification fields that
// model doesn't have.
model PaymentWebhookEvent {
  id              String              @id @default(cuid())
  provider        PaymentProviderName
  providerEventId String
  eventType       String
  payloadHash     String
  receivedAt      DateTime            @default(now())
  processedAt     DateTime?
  status          String              @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | IGNORED
  retryCount      Int                 @default(0)
  errorCode       String?

  @@unique([provider, providerEventId])
}

// Immutable once finalized (spec §47) — a correction is a new adjustment/
// credit record, never a silent edit to amount/currency/customer/tax here.
model Invoice {
  id               String        @id @default(cuid())
  invoiceCode      String        @unique // LPP-INV-######
  order            Order         @relation(fields: [orderId], references: [id])
  orderId          String        @unique
  profile          Profile       @relation(fields: [profileId], references: [id], onDelete: Restrict)
  profileId        String
  payment          Payment?      @relation(fields: [paymentId], references: [id])
  paymentId        String?       @unique
  subtotalMinor    Int
  discountMinor    Int
  taxMinor         Int
  totalMinor       Int
  currencyCode     String
  paymentStatus    PaymentStatus
  invoiceDate      DateTime      @default(now())
  dueDate          DateTime?
  paidDate         DateTime?
  paymentReference String?
  createdAt        DateTime      @default(now())

  items InvoiceItem[]

  @@index([profileId])
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  description    String
  quantity       Int     @default(1)
  unitPriceMinor Int
  discountMinor  Int     @default(0)
  taxMinor       Int     @default(0)
  totalMinor     Int

  @@index([invoiceId])
}

model Refund {
  id               String              @id @default(cuid())
  refundCode       String              @unique // LPP-REF-######
  payment          Payment             @relation(fields: [paymentId], references: [id])
  paymentId        String
  amountMinor      Int
  currencyCode     String
  type             RefundType
  reason           String
  provider         PaymentProviderName
  providerRefundId String?
  requestedBy      AdminUser           @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  requestedById    String
  approvedBy       AdminUser?          @relation("RefundApprovedBy", fields: [approvedById], references: [id])
  approvedById     String?
  executedBy       AdminUser?          @relation("RefundExecutedBy", fields: [executedById], references: [id])
  executedById     String?
  status           RefundStatus        @default(REQUESTED)
  createdAt        DateTime            @default(now())
  completedAt      DateTime?

  @@index([paymentId])
  @@index([status])
}

// Spec §20/§21 — a Coupon is a Discount that requires a redeemable code;
// discountCode is the internal admin-facing id, code is what a user types.
model Coupon {
  id                   String       @id @default(cuid())
  discountCode         String       @unique // LPP-DISC-######
  code                 String       @unique // e.g. "WELCOME10"
  description          String?
  discountType         DiscountType
  discountValue        Int // percent (0-100) or fixed minor-unit amount depending on discountType
  minPurchaseMinor     Int?
  maxDiscountMinor     Int?
  startDate            DateTime?
  endDate              DateTime?
  usageLimit           Int?
  perUserLimit         Int?
  applicablePackageIds Json? // array of Package ids; null = all packages
  active               Boolean      @default(true)
  createdBy            AdminUser?   @relation(fields: [createdById], references: [id])
  createdById          String?
  createdAt            DateTime     @default(now())

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id                   String   @id @default(cuid())
  coupon               Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId             String
  profile              Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId            String
  orderId              String
  discountAppliedMinor Int
  redeemedAt           DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([couponId, profileId])
}

// Rate stored in basis points (1/100 of a percent, e.g. 1700 = 17.00%) to
// avoid float precision issues (spec §19).
model TaxRule {
  id                     String     @id @default(cuid())
  name                   String
  ratePercentBasisPoints Int
  country                String
  region                 String?
  applicableService      String? // null = all services
  effectiveDate          DateTime   @default(now())
  expiryDate             DateTime?
  active                 Boolean    @default(true)
  createdBy              AdminUser? @relation(fields: [createdById], references: [id])
  createdById            String?
  createdAt              DateTime   @default(now())

  @@index([country, active])
}

// Atomic usage consumption (spec §40) — see consumeUsage() in
// src/lib/finance/entitlements.ts for the transactional WHERE-guarded update
// that prevents the race condition this table exists to track.
model FeatureUsage {
  id             String   @id @default(cuid())
  profileId      String
  featureKey     String
  subscriptionId String?
  usageCount     Int      @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([profileId, featureKey, periodStart])
}

model ReconciliationRun {
  id               String     @id @default(cuid())
  // Null for a scheduled/cron-triggered run (STEP 14 rollout-phases add-on
  // §77) — every admin-initiated run still has a real actor.
  startedBy        AdminUser? @relation(fields: [startedById], references: [id])
  startedById      String?
  startedAt        DateTime   @default(now())
  completedAt      DateTime?
  totalChecked     Int        @default(0)
  matchedCount     Int        @default(0)
  discrepancyCount Int        @default(0)

  items ReconciliationItem[]
}

model ReconciliationItem {
  id        String                   @id @default(cuid())
  run       ReconciliationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String
  paymentId String?
  status    ReconciliationItemStatus
  detail    String?
  createdAt DateTime                 @default(now())

  @@index([runId, status])
}

// =====================================================================
// STEP 15 — Production Deployment, DevOps, Monitoring, Backup & Recovery
// All additive. No relations into Steps 1-14 models except plain string
// ids (same convention as Case.relatedPaymentId), so nothing here can
// cascade into or alter existing data.
// =====================================================================

enum OperationalState {
  NORMAL
  DEGRADED
  MAINTENANCE
  RECOVERY
  EMERGENCY
}

enum MaintenanceMode {
  OFF
  ON
  SCHEDULED
}

enum ErrorCategory {
  AUTH_ERROR
  AUTHORIZATION_ERROR
  VALIDATION_ERROR
  DATABASE_ERROR
  STORAGE_ERROR
  PAYMENT_ERROR
  WEBHOOK_ERROR
  NOTIFICATION_ERROR
  MATCHING_ERROR
  PROPOSAL_ERROR
  VERIFICATION_ERROR
  SUPPORT_ERROR
  SECURITY_ERROR
  SYSTEM_ERROR
}

enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ErrorEventStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  RETRYING
  DEAD_LETTER
  CANCELLED
}

enum BackupType {
  DATABASE
  FILES
}

enum BackupStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum BackupTrigger {
  SCHEDULED
  MANUAL
}

enum BackupRetentionClass {
  DAILY
  WEEKLY
  MONTHLY
}

enum RestoreRequestStatus {
  PENDING
  APPROVED
  EXECUTED
  CANCELLED
  REJECTED
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  INVESTIGATING
  MITIGATING
  RESOLVED
  CLOSED
}

enum AlertSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum ReleaseStatus {
  PENDING_APPROVAL
  APPROVED
  DEPLOYING
  HEALTHY
  UNHEALTHY
  FAILED
  ROLLED_BACK
}

// Singleton (id = 1). Operational state, maintenance, emergency switches,
// DR targets, monitoring thresholds, backup policy and admin session length
// — kept apart from AppSettings (already 100+ product-config fields).
model SystemControl {
  id Int @id @default(1)

  operationalState       OperationalState @default(NORMAL)
  operationalStateReason String?

  maintenanceMode     MaintenanceMode @default(OFF)
  maintenanceStartsAt DateTime?
  maintenanceEndsAt   DateTime?
  maintenanceMessage  String?

  // Emergency switches (spec §56)
  emergencyPaymentsDisabled           Boolean @default(false)
  emergencyRegistrationsDisabled      Boolean @default(false)
  emergencyProfileSubmissionsDisabled Boolean @default(false)
  emergencyMatchingDisabled           Boolean @default(false)
  emergencyProposalsDisabled          Boolean @default(false)
  emergencyNotificationsDisabled      Boolean @default(false)
  emergencyUploadsDisabled            Boolean @default(false)
  emergencyPublicAccessDisabled       Boolean @default(false)

  // Disaster-recovery targets (spec §9) — targets, never guarantees
  rpoMinutes Int @default(1440)
  rtoMinutes Int @default(240)

  // Monitoring thresholds (spec §17/§38/§65)
  slowQueryThresholdMs         Int  @default(500)
  apiLatencyWarnMs             Int  @default(2000)
  errorRateWarnPerHour         Int  @default(50)
  failedLoginSpikeThreshold    Int  @default(10)
  paymentFailureSpikeThreshold Int  @default(5)
  webhookFailureSpikeThreshold Int  @default(5)
  queueBacklogThreshold        Int  @default(100)
  permissionViolationThreshold Int  @default(30)
  dbStorageLimitMb             Int?
  fileStorageLimitMb           Int?
  capacityWarnPercent          Int  @default(80)

  // Backup policy (spec §7) — retention is configurable, never hard-coded law
  backupsEnabled            Boolean @default(true)
  backupDailyKeep           Int     @default(7)
  backupWeeklyKeep          Int     @default(4)
  backupMonthlyKeep         Int     @default(6)
  backupStaleAfterHours     Int     @default(48)
  restoreTestStaleAfterDays Int     @default(30)

  monitoringPeriodHours Int @default(24)
  evidenceMaxAgeDays    Int @default(7)
  adminSessionMaxHours  Int @default(12)

  updatedById String?
  updatedAt   DateTime @updatedAt
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(true)
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Centralised, privacy-safe error record (spec §13/§14). message is already
// redacted + truncated by the capture helper; no stack parameters, no PII.
model ErrorEvent {
  id            String           @id @default(cuid())
  fingerprint   String
  category      ErrorCategory
  severity      ErrorSeverity
  service       String // API | FRONTEND | CRON | JOB | WEBHOOK | DATABASE | PROXY
  route         String?
  message       String
  environment   String
  appVersion    String?
  correlationId String?
  status        ErrorEventStatus @default(NEW)
  occurrences   Int              @default(1)
  firstSeenAt   DateTime         @default(now())
  lastSeenAt    DateTime         @default(now())
  resolvedById  String?
  resolvedAt    DateTime?

  @@unique([fingerprint, environment])
  @@index([status, lastSeenAt])
  @@index([category])
  @@index([severity])
  @@index([lastSeenAt])
}

// Aggregated slow-query stats (spec §18). Never stores SQL text or params.
model SlowQueryStat {
  id          String   @id @default(cuid())
  key         String   @unique // `${operation}:${table}:${route|-}`
  operation   String
  tableName   String
  route       String?
  count       Int      @default(1)
  totalMs     Int
  maxMs       Int
  lastMs      Int
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([lastSeenAt])
}

// Hourly latency/error buckets per instrumented route (spec §17).
model PerfSample {
  id          String   @id @default(cuid())
  route       String
  bucketStart DateTime
  count       Int      @default(0)
  errorCount  Int      @default(0)
  slowCount   Int      @default(0)
  sumMs       Int      @default(0)
  maxMs       Int      @default(0)

  @@unique([route, bucketStart])
  @@index([bucketStart])
}

// Persistent (cross-instance) rate-limit counter (spec §19).
model RateLimitBucket {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())

  @@index([windowStartedAt])
}

model BackgroundJob {
  id            String    @id @default(cuid())
  type          String
  status        JobStatus @default(PENDING)
  dedupKey      String?   @unique
  payload       Json? // safe metadata only — never PII/secrets
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  runAfter      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  lockedUntil   DateTime?
  failureReason String?
  correlationId String?
  resolved      Boolean   @default(false)
  resolvedById  String?
  createdById   String?

  @@index([status, runAfter])
  @@index([type, status])
}

// One row per named scheduled task: lock (prevents duplicate execution) +
// last-run summary (spec §31).
model CronTask {
  name                String    @id
  lockedUntil         DateTime?
  lastStartedAt       DateTime?
  lastCompletedAt     DateTime?
  lastStatus          String? // SUCCESS | FAILED
  lastDurationMs      Int?
  consecutiveFailures Int       @default(0)
  totalFailures       Int       @default(0)
  schedule            String?
  updatedAt           DateTime  @updatedAt
}

model CronTaskRun {
  id            String    @id @default(cuid())
  taskName      String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationMs    Int?
  status        String // SUCCESS | FAILED | SKIPPED_LOCKED
  error         String?
  correlationId String?

  @@index([taskName, startedAt])
}

model BackupRun {
  id                 String               @id @default(cuid())
  backupCode         String               @unique // LPP-BKP-######
  type               BackupType
  trigger            BackupTrigger
  status             BackupStatus         @default(RUNNING)
  retentionClass     BackupRetentionClass @default(DAILY)
  startedAt          DateTime             @default(now())
  completedAt        DateTime?
  sizeBytes          Int?
  checksumSha256     String?
  manifest           Json? // per-table row counts / file counts
  storageUrl         String? // ciphertext object only
  encrypted          Boolean              @default(true)
  separateStore      Boolean              @default(false)
  expiresAt          DateTime?
  triggeredById      String?
  failureReason      String?
  verifiedAt         DateTime?
  verificationStatus String? // PASSED | FAILED
  prunedAt           DateTime?

  restoreTests    RestoreTest[]
  restoreRequests RestoreRequest[]

  @@index([type, status, startedAt])
}

// Incremental mirror of encrypted blob objects (photos/documents/evidence).
model BackupFileCopy {
  id        String   @id @default(cuid())
  sourceUrl String   @unique
  backupUrl String
  sha256    String
  sizeBytes Int
  kind      String // PHOTO | DOCUMENT | EVIDENCE
  copiedAt  DateTime @default(now())
}

model RestoreTest {
  id            String    @id @default(cuid())
  backup        BackupRun @relation(fields: [backupId], references: [id])
  backupId      String
  mode          String // VERIFY_ONLY
  status        String // RUNNING | PASSED | FAILED
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  result        Json?
  performedById String?

  @@index([backupId])
  @@index([startedAt])
}

// Authorization record for a real restore — executing it is done outside the
// app (scripts/restore-backup.ts); nothing in the app overwrites live data.
model RestoreRequest {
  id            String               @id @default(cuid())
  backup        BackupRun            @relation(fields: [backupId], references: [id])
  backupId      String
  status        RestoreRequestStatus @default(PENDING)
  reason        String
  targetLabel   String
  requestedById String
  approvedById  String?
  requestedAt   DateTime             @default(now())
  decidedAt     DateTime?
  executedAt    DateTime?
  notes         String?

  @@index([status])
}

model Alert {
  id             String        @id @default(cuid())
  alertCode      String        @unique // LPP-ALT-######
  category       String // rule key, e.g. ERROR_RATE
  severity       AlertSeverity
  source         String
  service        String
  title          String
  detail         String? // safe text only
  status         AlertStatus   @default(NEW)
  dedupKey       String
  occurrences    Int           @default(1)
  firstSeenAt    DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  assignedToId   String?
  resolution     String?
  resolvedAt     DateTime?
  incidentCaseId String? // plain id of the Case opened for this alert
  createdAt      DateTime      @default(now())

  events AlertEvent[]

  @@index([status, severity])
  @@index([dedupKey])
}

model AlertEvent {
  id         String       @id @default(cuid())
  alert      Alert        @relation(fields: [alertId], references: [id], onDelete: Cascade)
  alertId    String
  actorId    String?
  fromStatus AlertStatus?
  toStatus   AlertStatus?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([alertId])
}

model IntegrityCheckRun {
  id            String    @id @default(cuid())
  trigger       String // SCHEDULED | MANUAL | POST_RESTORE
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  status        String // RUNNING | CLEAN | FINDINGS | FAILED
  totalChecks   Int       @default(0)
  findingCount  Int       @default(0)
  findings      Json?
  triggeredById String?

  @@index([startedAt])
}

model Release {
  id                 String        @id @default(cuid())
  releaseCode        String        @unique // LPP-REL-######
  version            String
  commitSha          String
  environment        String
  status             ReleaseStatus @default(DEPLOYING)
  deployedBy         String?
  deployedAt         DateTime      @default(now())
  notes              String?
  migrations         Json? // applied migration names at deploy time
  featureFlags       Json?
  paymentEnvironment String?
  testResults        Json?
  smokeResult        String?
  rollbackTargetId   String? // previous stable Release id
  monitoringUntil    DateTime?
  approvedById       String?
  approvedAt         DateTime?
  verifiedAt         DateTime?
  verificationResult Json?

  @@unique([commitSha, environment])
  @@index([environment, deployedAt])
}

// Evidence posted by CI / deploy-gate workflows (spec §22/§49/§68). The
// readiness evaluator never marks a gate PASS without fresh evidence.
model CiEvidence {
  id          String   @id @default(cuid())
  kind        String // BUILD | TYPECHECK | LINT | TESTS | SECURITY_SCAN | DEPENDENCY_AUDIT | MIGRATION_VALIDATION | SMOKE | SECURITY_SMOKE
  status      String // PASS | FAIL
  commitSha   String
  environment String?
  summary     Json?
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
}

// =====================================================================
// STEP 16 — AI-assisted matchmaking & admin assistant (additive only).
// AI recommends and explains; humans decide. None of these tables feeds the
// deterministic matcher, payments, verification or any profile field.
// Rows carry ids and metadata only — no contact details, no free-text PII.
// =====================================================================

enum AiProviderKind {
  RULES // built-in deterministic provider — no data leaves the system
  ANTHROPIC // external LLM adapter — off unless key + explicit config + per-profile consent
  DISABLED
}

enum AiFeature {
  PROFILE_SUMMARY
  MATCH_EXPLANATION
  COMPARE
  PROPOSAL_ASSISTANT
  COMMUNICATION_ASSISTANT
  FOLLOWUP_ASSISTANT
  COPILOT
  REPORT_ASSISTANT
  DATA_QUALITY
  PROFILE_IMPROVEMENT
}

enum AiRequestStatus {
  SUCCESS
  FAILED
  BLOCKED_SAFETY
  CONSENT_REQUIRED
  DENIED
  RATE_LIMITED
  QUOTA_EXCEEDED
  DISABLED
  FALLBACK
}

enum AiRolloutPhase {
  DISABLED
  INTERNAL_TEST
  STAFF_PILOT
  LIMITED_PRODUCTION
  PRODUCTION
}

enum AiStorageMode {
  DO_NOT_STORE
  SUMMARY_ONLY
  FULL_RESULT
  LIMITED_PERIOD
}

// Singleton configuration (id = 1). Provider secrets are NEVER stored here —
// the external adapter reads its key from the environment only.
model AiConfig {
  id Int @id @default(1)

  phase            AiRolloutPhase @default(DISABLED)
  killSwitchActive Boolean        @default(false)
  killSwitchReason String?
  killSwitchAt     DateTime?

  provider                AiProviderKind @default(RULES)
  externalProviderAllowed Boolean        @default(false)
  model                   String         @default("lpp-rules-v1")
  temperature             Float          @default(0.2)
  maxOutputTokens         Int            @default(1200)
  timeoutMs               Int            @default(15000)
  retryCount              Int            @default(1)

  dailyRequestCap   Int   @default(500)
  monthlyRequestCap Int   @default(10000)
  rateLimits        Json? // { "<feature>": { "limit": n, "windowSec": n }, roles: { "STAFF": { ... } } }

  storageModes    Json? // { "<feature>": AiStorageMode }
  retentionDays   Int   @default(30)
  cacheTtlMinutes Int   @default(60)

  pilotAdminIds         String[] // STAFF_PILOT / LIMITED_PRODUCTION allowlist
  priceInputPerMTokUsd  Float? // only used to ESTIMATE cost when the provider reports token usage
  priceOutputPerMTokUsd Float?

  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Activation history for the code-defined prompt templates (spec §65/§66).
// Templates live in src/lib/ai/prompts; this records which version was
// activated, when, by whom, and the passing test run that allowed it.
model AiPromptVersion {
  id            String    @id @default(cuid())
  promptId      String // e.g. LPP-AI-PROFILE-SUMMARY
  version       String // e.g. v1.0
  feature       AiFeature
  checksum      String
  active        Boolean   @default(false)
  testRunId     String?
  activatedById String?
  createdAt     DateTime  @default(now())

  @@unique([promptId, version])
  @@index([feature, active])
}

model AiRequest {
  id                    String          @id @default(cuid())
  actorAdminId          String
  actorRole             String
  feature               AiFeature
  status                AiRequestStatus
  provider              AiProviderKind
  model                 String
  promptVersion         String
  aiVersion             String
  appVersion            String?
  matchAlgorithmVersion String?
  latencyMs             Int?
  inputTokens           Int?
  outputTokens          Int?
  estimatedCostUsd      Float?
  costIsEstimate        Boolean         @default(false)
  correlationId         String?
  consentOutcome        String?
  errorCode             String?
  fromCache             Boolean         @default(false)
  profileIds            String[]
  createdAt             DateTime        @default(now())

  result AiResult?

  @@index([createdAt])
  @@index([actorAdminId, feature, createdAt])
  @@index([status, createdAt])
  @@index([profileIds], type: Gin)
}

model AiResult {
  id          String        @id @default(cuid())
  request     AiRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId   String        @unique
  feature     AiFeature
  profileIds  String[]
  structured  Json?
  storageMode AiStorageMode
  expiresAt   DateTime?
  cacheKey    String?
  createdAt   DateTime      @default(now())

  @@index([expiresAt])
  @@index([cacheKey])
  @@index([profileIds], type: Gin)
}

// Metadata only: which rule fired and what was done. The offending text is
// never stored.
model AiSafetyEvent {
  id           String     @id @default(cuid())
  requestId    String?
  actorAdminId String?
  feature      AiFeature?
  rule         String
  action       String // BLOCKED | REWRITTEN | DENIED
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@index([rule, createdAt])
}

model AiConfigHistory {
  id           String   @id @default(cuid())
  actorAdminId String?
  kind         String // CONFIG | ROLLOUT | KILL_SWITCH | PROMPT | MODEL
  before       Json?
  after        Json?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([kind, createdAt])
}

model AiTestRun {
  id             String         @id @default(cuid())
  suite          String // safety | privacy | security | reliability | analysis | all
  testVersion    String
  provider       AiProviderKind
  model          String
  promptVersions Json?
  passed         Int
  failed         Int
  status         String // PASS | FAIL
  failures       Json?
  triggeredById  String?
  commitSha      String?
  createdAt      DateTime       @default(now())

  @@index([suite, createdAt])
}

// ---------- Approval Governance (STEP 19) ----------
// Maker-checker / four-eyes / multi-level approval for high-risk admin
// actions. See src/lib/approvals/ (catalog, policy-engine, conflict, engine,
// gate, events) for the logic consuming these. actionType is a validated
// string (not a hard Postgres enum) so Super Admin governance configuration
// (spec §9) can enable/disable and reconfigure per action type without a
// schema migration — see src/lib/approvals/catalog.ts for the known-action
// registry. No existing STEP 1-18 model, enum, or function is modified by
// this section; a small number of existing routes call into
// src/lib/approvals/gate.ts as an additive pre-execution check (see those
// files' own STEP 19 comments).

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  PENDING_APPROVAL
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  EXPIRED
  CANCELLED
  EXECUTION_PENDING
  EXECUTING
  EXECUTED
  EXECUTION_FAILED
  REOPENED
  ARCHIVED
}

enum ApprovalRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// LEVEL_0 = no approval required; LEVEL_5 = multi-party/quorum (see
// ApprovalPolicy.minimumApprovers/quorum for the actual "N of M").
enum ApprovalLevel {
  LEVEL_0
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
  LEVEL_5
}

enum ApprovalReviewerDecision {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  RECUSED
}

enum ApprovalStepStatus {
  PENDING
  IN_PROGRESS
  SATISFIED
  FAILED
  SKIPPED
}

enum ApprovalExecutionStatus {
  NOT_STARTED
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

// spec §29 — detected by src/lib/approvals/conflict.ts before any decision
// is recorded; SELF_APPROVAL is the unconditional, always-checked-first case.
enum ApprovalConflictType {
  SELF_APPROVAL
  ASSIGNED_STAFF_CONFLICT
  FINANCIAL_REQUESTER_CONFLICT
  VERIFICATION_MAKER_CONFLICT
  ROLE_POLICY_CONFLICT
  OTHER
}

enum ApprovalDelegationStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model ApprovalRequest {
  id           String @id @default(cuid())
  approvalCode String @unique // LPP-APR-###### via src/lib/privacy/codes.ts

  actionType String // validated against src/lib/approvals/catalog.ts, not a DB enum (spec §9)
  sourceType AssignmentResourceType
  sourceId   String

  maker   AdminUser @relation("ApprovalMaker", fields: [makerId], references: [id])
  makerId String

  status    ApprovalStatus     @default(DRAFT)
  riskLevel ApprovalRiskLevel
  priority  AssignmentPriority @default(NORMAL)
  reason    String

  // Before/after snapshot for the Approval Detail page (spec §20) — never
  // the sole authorization source; execution always re-derives from the
  // live source record via src/lib/approvals/gate.ts.
  currentStatePayload Json?
  requestedPayload    Json?

  requiredLevel ApprovalLevel
  currentLevel  ApprovalLevel @default(LEVEL_0)

  assignedChecker      AdminUser?  @relation("ApprovalAssignedChecker", fields: [assignedCheckerId], references: [id])
  assignedCheckerId    String?
  assignedDepartment   Department? @relation(fields: [assignedDepartmentId], references: [id])
  assignedDepartmentId String?

  requestedAt DateTime  @default(now())
  expiresAt   DateTime?
  completedAt DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?

  createdTask   AdminTask? @relation(fields: [createdTaskId], references: [id])
  createdTaskId String?    @unique

  executionStatus ApprovalExecutionStatus @default(NOT_STARTED)
  // Dedup key for submit-twice / execute-twice protection (spec §36) —
  // e.g. `${actionType}:${sourceType}:${sourceId}:${makerId}` for most
  // actions; emergency overrides use a fresh uuid per use instead.
  idempotencyKey  String                  @unique

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps         ApprovalStep[]
  reviewers     ApprovalReviewer[]
  events        ApprovalEvent[]
  executionLogs ApprovalExecutionLog[]
  conflicts     ApprovalConflict[]

  @@index([status])
  @@index([actionType])
  @@index([sourceType, sourceId])
  @@index([makerId])
  @@index([expiresAt])
  @@index([assignedDepartmentId])
}

model ApprovalStep {
  id                String             @id @default(cuid())
  approvalRequest   ApprovalRequest    @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approvalRequestId String
  level             ApprovalLevel
  sequence          Int // execution order for sequential multi-level chains (e.g. Manager then Super Admin)
  requiredRoles     AdminRole[] // eligible reviewer roles for this step (empty = any policy-allowed role)
  requiredCount     Int                @default(1) // "M" — how many distinct eligible reviewers may decide
  quorumCount       Int                @default(1) // "N" — how many APPROVED decisions satisfy this step
  status            ApprovalStepStatus @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  reviewers ApprovalReviewer[]

  @@unique([approvalRequestId, sequence])
}

// Reviewers are recorded lazily as eligible admins actually decide (see
// plan architecture decision 3 — Level 2+ pools are eligibility-based, not a
// pre-assigned roster). @@unique([stepId, reviewerId]) makes a duplicate
// decision by the same reviewer an update, never a second counted vote.
model ApprovalReviewer {
  id                String                   @id @default(cuid())
  approvalRequest   ApprovalRequest          @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approvalRequestId String
  step              ApprovalStep             @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepId            String
  reviewer          AdminUser                @relation(fields: [reviewerId], references: [id])
  reviewerId        String
  roleAtDecision    AdminRole?
  decision          ApprovalReviewerDecision @default(PENDING)
  decisionReason    String?
  decidedAt         DateTime?
  createdAt         DateTime                 @default(now())

  @@unique([stepId, reviewerId])
  @@index([approvalRequestId])
}

// Super Admin-configurable governance rule per action type (spec §9) — the
// row read by src/lib/approvals/policy-engine.ts's getApprovalPolicy().
model ApprovalPolicy {
  id         String @id @default(cuid())
  actionType String @unique

  enabled       Boolean           @default(true)
  riskLevel     ApprovalRiskLevel
  requiredLevel ApprovalLevel

  minimumApprovers Int @default(1)
  quorum           Int @default(1)

  allowedRoles         AdminRole[]
  allowedDepartmentIds String[]    @default([])

  makerCheckerRequired Boolean @default(true)
  reauthRequired       Boolean @default(false)
  twoFactorRequired    Boolean @default(false)
  expirationMinutes    Int     @default(4320) // 3 days

  emergencyOverrideAllowed Boolean @default(false)

  createdBy   AdminUser? @relation("ApprovalPolicyCreator", fields: [createdById], references: [id])
  createdById String?
  updatedBy   AdminUser? @relation("ApprovalPolicyUpdater", fields: [updatedById], references: [id])
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Currency-aware, admin-configurable financial approval tiers (spec §10) —
// never hardcoded; amounts are integer minor units matching
// src/lib/finance/money.ts's convention (no floating-point money).
model ApprovalAmountThreshold {
  id               String        @id @default(cuid())
  actionType       String
  currencyCode     String
  minAmountMinor   Int
  maxAmountMinor   Int? // null = no upper bound
  requiredLevel    ApprovalLevel
  minimumApprovers Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([actionType, currencyCode])
}

// Time-limited decision-making delegation (spec §27) — scoped to eligibility
// only; never grants the delegate new Permission strings or a role (see
// plan architecture decision 10).
model ApprovalDelegation {
  id                 String                   @id @default(cuid())
  delegator          AdminUser                @relation("ApprovalDelegator", fields: [delegatorId], references: [id])
  delegatorId        String
  delegate           AdminUser                @relation("ApprovalDelegate", fields: [delegateId], references: [id])
  delegateId         String
  allowedActionTypes String[]                 @default([]) // empty = all action types the delegator could decide on
  startAt            DateTime
  endAt              DateTime
  reason             String
  status             ApprovalDelegationStatus @default(ACTIVE)
  createdBy          AdminUser                @relation("ApprovalDelegationCreator", fields: [createdById], references: [id])
  createdById        String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([delegatorId, status])
  @@index([delegateId, status])
}

model ApprovalExecutionLog {
  id                String                  @id @default(cuid())
  approvalRequest   ApprovalRequest         @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approvalRequestId String
  executionStatus   ApprovalExecutionStatus
  executedBy        AdminUser?              @relation(fields: [executedById], references: [id])
  executedById      String?
  startedAt         DateTime                @default(now())
  completedAt       DateTime?
  errorCode         String?
  errorMessage      String?

  @@index([approvalRequestId])
}

// Conflict-of-interest block (spec §29) — created whenever
// src/lib/approvals/conflict.ts denies a decision attempt; the actor sees
// only a neutral message, this row keeps the real reason for audit.
model ApprovalConflict {
  id                String               @id @default(cuid())
  approvalRequest   ApprovalRequest      @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approvalRequestId String
  actor             AdminUser            @relation(fields: [actorId], references: [id])
  actorId           String
  conflictType      ApprovalConflictType
  detectedAt        DateTime             @default(now())
  resolution        String?

  @@index([approvalRequestId])
}

// Fast, purpose-built per-request timeline (plan architecture decision 5) —
// written together with the central AuditLog by
// src/lib/approvals/events.ts's recordApprovalEvent(), never on its own.
model ApprovalEvent {
  id                String          @id @default(cuid())
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approvalRequestId String
  actor             AdminUser?      @relation(fields: [actorId], references: [id])
  actorId           String?
  eventType         String // mirrors the AuditAction Approval Governance block
  metadata          Json?
  createdAt         DateTime        @default(now())

  @@index([approvalRequestId, createdAt])
}

// ---------- Candidate Discovery & Matchmaking Workspace (STEP 20) ----------
// See src/lib/search/ (fields, filter-builder, candidate-search, audit) for
// the logic consuming these. No existing STEP 1-19 model, enum, or function
// is replaced by this section — src/lib/serializers.ts's toListDto/
// toDetailDto and src/lib/matching.ts's scoreMatch() gain small, additive
// enhancements (see those files' own STEP 20 comments); everything else here
// is new.

enum SavedSearchVisibility {
  PRIVATE
  TEAM
  DEPARTMENT
  ORGANIZATION
}

enum ShortlistStatus {
  DRAFT
  REVIEWING
  READY_FOR_PROPOSAL
  ARCHIVED
}

// Spec §19/§20 — a named, reusable filter configuration. filterJson stores a
// validated FilterGroup (src/lib/search/filter-builder.ts) — never raw SQL,
// never re-trusted without re-validation on read.
model SavedSearch {
  id           String                @id @default(cuid())
  searchCode   String                @unique // LPP-SRCH-###### via src/lib/privacy/codes.ts
  owner        AdminUser             @relation(fields: [ownerId], references: [id])
  ownerId      String
  name         String
  description  String?
  filterJson   Json
  visibility   SavedSearchVisibility @default(PRIVATE)
  department   Department?           @relation(fields: [departmentId], references: [id])
  departmentId String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([ownerId])
  @@index([visibility])
}

// Spec §21 — "Recent Searches" source. filterSummary is a compact, non-
// sensitive JSON summary (e.g. {"city":"Lahore","verifiedOnly":true}) — a
// sensitive-flagged search additionally gets a CandidateSearchAudit row
// (below); this table alone is never the sensitive-compliance record.
model SearchHistory {
  id              String    @id @default(cuid())
  actor           AdminUser @relation(fields: [actorId], references: [id])
  actorId         String
  searchType      String // "criteria" | "mutual" | "nl" | "profile_id"
  sourceProfile   Profile?  @relation(fields: [sourceProfileId], references: [id])
  sourceProfileId String?
  filterSummary   Json
  resultCount     Int
  createdAt       DateTime  @default(now())

  @@index([actorId, createdAt])
}

// Spec §28 — LPP-SHORT-######. Never auto-creates a proposal (spec §28's own
// explicit rule) — a shortlist is purely a staging area.
model Shortlist {
  id              String          @id @default(cuid())
  shortlistCode   String          @unique // LPP-SHORT-###### via src/lib/privacy/codes.ts
  owner           AdminUser       @relation(fields: [ownerId], references: [id])
  ownerId         String
  sourceProfile   Profile?        @relation(fields: [sourceProfileId], references: [id])
  sourceProfileId String?
  name            String
  description     String?
  status          ShortlistStatus @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items ShortlistItem[]

  @@index([ownerId])
  @@index([sourceProfileId])
}

// @@unique([shortlistId, profileId]) is the spec §45 duplicate-add
// protection — adding an already-present candidate is a no-op, not a second row.
model ShortlistItem {
  id          String    @id @default(cuid())
  shortlist   Shortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  shortlistId String
  profile     Profile   @relation(fields: [profileId], references: [id])
  profileId   String
  position    Int       @default(0)
  adminNote   String?
  addedBy     AdminUser @relation(fields: [addedById], references: [id])
  addedById   String
  createdAt   DateTime  @default(now())

  @@unique([shortlistId, profileId])
  @@index([shortlistId])
}

// Spec §39 — a dedicated compliance trail for sensitive-filter usage, kept
// separate from SearchHistory's general UX purpose. sensitiveFiltersUsed
// records WHICH sensitive categories were filtered on (e.g. ["income"]),
// never the raw threshold value (spec §38's explicit example).
model CandidateSearchAudit {
  id                   String    @id @default(cuid())
  actor                AdminUser @relation(fields: [actorId], references: [id])
  actorId              String
  searchType           String
  sourceProfile        Profile?  @relation(fields: [sourceProfileId], references: [id])
  sourceProfileId      String?
  sensitiveFiltersUsed String[]  @default([])
  resultCount          Int
  reason               String?
  createdAt            DateTime  @default(now())

  @@index([actorId, createdAt])
}
