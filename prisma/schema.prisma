// STEP 18 — the original 7 keep their exact meaning and resourceType pairing
// (see src/lib/notifications/events.ts's 8 existing createTask() call sites,
// unchanged); the 18 new values are additional source-domain checkpoints the
// STEP 18 spec asks for, created via WorkflowEngine.createFromEvent().
enum AdminTaskType {
  NEW_PROFILE_REVIEW // PROFILE — profile update pending review
  VERIFICATION_REQUEST // SECURITY_FLAG — a raised flag needs review
  PROPOSAL_FOLLOWUP // PROPOSAL — mutual interest reached
  MEETING_TASK // PROPOSAL — a meeting was confirmed
  CONTACT_REQUEST_TASK // PROPOSAL — contact permission requested
  FOLLOW_UP_DUE // FOLLOW_UP — a follow-up is overdue
  CASE_REVIEW // CASE — a case needs review
  PROFILE_UPDATE_REVIEW // PROFILE — an existing profile's edited fields need review
  VERIFICATION_REVIEW // PROFILE — initial verification submission review
  VERIFICATION_REVERIFICATION // PROFILE — re-verification required
  MATCH_REVIEW // PROFILE — admin match-quality review before a proposal
  PROPOSAL_REVIEW // PROPOSAL — new proposal needs initial review
  PROPOSAL_DECISION_REVIEW // PROPOSAL — a response/decision needs review
  CONTACT_PERMISSION_REVIEW // PROPOSAL — contact-sharing decision needs review
  MEETING_REQUEST_REVIEW // PROPOSAL — a meeting request needs review
  MEETING_FOLLOWUP // PROPOSAL — post-meeting follow-up
  COMMUNICATION_REVIEW // PROPOSAL — a communication needs review
  SUPPORT_CASE_TASK // CASE — a support case needs action
  SAFETY_REVIEW // CASE — a safety report needs review
  PAYMENT_ISSUE_REVIEW // PAYMENT — a payment issue needs review
  REFUND_REVIEW // PAYMENT — a refund request needs review
  RECONCILIATION_REVIEW // PAYMENT — a reconciliation mismatch needs review
  PRIVACY_REQUEST_TASK // PRIVACY_REQUEST — a privacy request needs action
  DELETION_REQUEST_TASK // PRIVACY_REQUEST — a deletion request needs review
  AI_SAFETY_REVIEW // AI_SAFETY_EVENT — a blocked/denied AI output needs human review
  GENERAL_ADMIN_TASK // any resourceType — manual "Create Task" catch-all

  // STEP 19 — approval-review work items created alongside an ApprovalRequest
  // (src/lib/approvals/engine.ts) so a checker's queue shows pending decisions
  // the same way every other work item does.
  APPROVAL_REVIEW // any resourceType — generic approval review
  HIGH_RISK_APPROVAL // any resourceType — HIGH risk_level approval
  CRITICAL_APPROVAL // any resourceType — CRITICAL risk_level approval
  FINANCE_APPROVAL // PAYMENT — refund/rollout/pricing approval review
  CONTACT_APPROVAL // PROPOSAL/PROFILE — contact-sharing approval review
  VERIFICATION_APPROVAL // PROFILE — verification decision approval review
  PRIVACY_APPROVAL // PRIVACY_REQUEST — deletion/export approval review
  SECURITY_APPROVAL // CASE/PROFILE — safety/restriction approval review
  AI_APPROVAL // AI_SAFETY_EVENT — AI governance approval review

  // STEP 20 — a candidate surfaced through search needs a distinct review
  // task from MATCH_REVIEW (which is specifically "admin match-quality
  // review before a proposal").
  CANDIDATE_REVIEW // PROFILE — a discovered candidate needs staff review
}

