// Life Partner Pro — database schema
// Production (Vercel) runs Postgres — serverless functions have no
// persistent writable disk, so SQLite doesn't work there. Local dev can
// point DATABASE_URL at any reachable Postgres instance (a free Neon/Vercel
// Postgres branch, or a local Postgres install) via `prisma db push`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

