// ---------- Core profile ----------

model Profile {
  id          String @id @default(cuid())
  profileCode String @unique // e.g. LPP-000001, cosmetic display id only

  fullName      String
  gender        Gender
  dateOfBirth   DateTime
  maritalStatus MaritalStatus
  heightCm      Int

  city        String
  area        String?
  country     String
  nationality String?

  hasChildren      Boolean? // only meaningful for Divorced/Widowed/Separated
  numberOfChildren Int?

  status            ProfileStatus @default(NEW)
  verified          Boolean       @default(false)
  softDeleted       Boolean       @default(false)
  // Orthogonal to `status` (STEP 13) — see AccountStatus enum comment.
  accountStatus     AccountStatus @default(ACTIVE)
  profileCompletion Int           @default(0) // 0-100, recomputed whenever the profile or its sections are written
  preferredLanguage Locale        @default(EN) // drives server-side notification template language (STEP 9)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact             ContactInfo?
  education           EducationInfo?
  profession          ProfessionInfo?
  family              FamilyInfo?
  lifestyle           LifestyleInfo?
  preference          PartnerPreference?
  photos              ProfilePhoto[]
  notes               ProfileNote[]
  consent             ConsentRecord?
  communications      Communication[]
  followUps           FollowUp[]
  pendingUpdate       PendingUpdate?
  dashboardPreference DashboardPreference?
  familyAccount       FamilyAccount?
  familyConsentsGiven FamilyConsent[]

  matchesAsA   Match[]    @relation("MatchProfileA")
  matchesAsB   Match[]    @relation("MatchProfileB")
  proposalsAsA Proposal[] @relation("ProposalProfileA")
  proposalsAsB Proposal[] @relation("ProposalProfileB")

  auditLogs        AuditLog[]
  contactSharesAsA ContactShareLog[] @relation("ShareProfileA")
  contactSharesAsB ContactShareLog[] @relation("ShareProfileB")

  proposalResponses       ProposalResponse[]
  contactPermissions      ContactPermission[]
  familyCommunications    FamilyCommunication[]
  performedProposalEvents ProposalEvent[]

  verification          ProfileVerification?
  otpVerifications      OtpVerification[]
  verificationDocuments VerificationDocument[]
  securityFlags         SecurityFlag[]         @relation("SecurityFlagProfile")
  relatedSecurityFlags  SecurityFlag[]         @relation("SecurityFlagRelatedProfile")

  // ---------- STEP 23 — Duplicate Detection & Account Relationships ----------
  duplicateCandidatesAsSubject   DuplicateCandidate[]  @relation("DuplicateCandidateProfile")
  duplicateCandidatesAsCandidate DuplicateCandidate[]  @relation("DuplicateCandidateCandidateProfile")
  accountRelationships           AccountRelationship[] @relation("AccountRelationshipProfile")
  relatedAccountRelationships    AccountRelationship[] @relation("AccountRelationshipRelatedProfile")

  notificationsReceived  Notification[]          @relation("NotificationRecipientProfile")
  notificationsRelated   Notification[]          @relation("NotificationRelatedProfile")
  communicationLogs      CommunicationLog[]
  notificationPreference NotificationPreference?
  communicationConsents  CommunicationConsent[]

  // ---------- Support, Complaints, Safety & Case Management (STEP 12) ----------
  casesFiled    Case[]               @relation("CaseReporterProfile")
  casesReported Case[]               @relation("CaseReportedProfile")
  caseComments  CaseComment[]
  caseEvidence  CaseEvidence[]
  restrictions  ProfileRestriction[]

  // ---------- Data Privacy, Consent, Account Management & Retention (STEP 13) ----------
  consentGrants      ConsentGrant[]
  deletionRequests   AccountDeletionRequest[]
  privacyRequests    PrivacyRequest[]
  dataExportRequests DataExportRequest[]
  sessions           ProfileSession[]

  // ---------- Payment, Subscription, Packages & Financial Management (STEP 14) ----------
  subscriptions     Subscription[]
  orders            Order[]
  payments          Payment[]
  invoices          Invoice[]
  couponRedemptions CouponRedemption[]

  // ---------- Candidate Discovery & Matchmaking Workspace (STEP 20) ----------
  searchHistoryAsSource         SearchHistory[]
  shortlistsAsSource            Shortlist[]
  shortlistAppearances          ShortlistItem[]
  candidateSearchAuditsAsSource CandidateSearchAudit[]

  @@index([gender, status])
  @@index([city])
  @@index([status])
  @@index([maritalStatus])
  @@index([dateOfBirth])
  @@index([verified])
  @@index([softDeleted, status]) // STEP 15 — matching candidate + admin list filters
  @@index([createdAt])
}

model ContactInfo {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String  @unique

  mobileNumber           String
  whatsappNumber         String?
  email                  String
  preferredContactMethod ContactMethod @default(PHONE)
  contactVerified        Boolean       @default(false)
}

model EducationInfo {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String  @unique

  level       String // e.g. Bachelor's, Master's, PhD
  degree      String?
  institution String?
}

model ProfessionInfo {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String  @unique

  profession         String
  jobTitle           String?
  companyName        String?
  employmentType     EmploymentType @default(PRIVATE)
  monthlyIncome      Int? // stored in smallest currency unit-agnostic integer (e.g. USD)
  annualIncome       Int?
  workLocation       String?
  businessDetails    String?
  program            String? // Student employment type only
  expectedGraduation String? // Student employment type only
}

model FamilyInfo {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String  @unique

  fatherOccupation String?
  motherOccupation String?
  numberOfBrothers Int          @default(0)
  numberOfSisters  Int          @default(0)
  familyType       FamilyType   @default(NUCLEAR)
  familyStatus     FamilyStatus @default(MIDDLE_CLASS)
  familyLocation   String?
  familyBackground String?
  additionalInfo   String?
}

model LifestyleInfo {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String  @unique

  religion          String?
  sect              String?
  religiousPractice String? // e.g. Practicing, Moderate, Liberal
  languages         String? // comma separated
  smoking           Boolean @default(false)
  drinking          Boolean @default(false)
  hobbies           String?
  personality       String?
  aboutMe           String?
  otherPreferences  String?
}

model PartnerPreference {
  id        String  @id @default(cuid())
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String  @unique

  minAge Int?
  maxAge Int?

  preferredCountry String?
  preferredCity    String?
  preferredArea    String?

  minEducation       String?
  preferredEducation String?

  professionPreference String? // free text or "ANY"

  minIncome      Int?
  maxIncome      Int?
  incomeFlexible Boolean @default(true)

  maritalStatusPreference String? // comma-separated MaritalStatus values or "ANY"

  minHeightCm Int?
  maxHeightCm Int?

  familyTypePreference       String?
  familyBackgroundPreference String?
  otherFamilyRequirements    String?

  additionalExpectations String? // large free text

  // Captured at registration for future matching-engine consumption — the
  // engine (src/lib/matching.ts) does not yet weight by these (spec §8).
  agePriority        PreferencePriority? @default(PREFERRED)
  locationPriority   PreferencePriority? @default(PREFERRED)
  professionPriority PreferencePriority? @default(PREFERRED)
  locationScope      String? // e.g. "Same City", "Anywhere in Country" — selected label, not scored yet
}

model ProfilePhoto {
  id            String   @id @default(cuid())
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId     String
  storageKey    String // Vercel Blob URL — never sent to the client directly, see src/lib/storage.ts
  mimeType      String
  sizeBytes     Int
  isPrimary     Boolean  @default(true)
  createdAt     DateTime @default(now())
  // STEP 13 — AES-256-GCM, nullable so existing pre-STEP-13 photos keep
  // working unencrypted until next replaced (see src/lib/privacy/photo-crypto.ts).
  ivBase64      String?
  authTagBase64 String?

  @@index([profileId])
}

// Granular consent, tracked separately per purpose rather than one blanket
// checkbox — a profile must not go ACTIVE without all four being true (see
// the status-change route). consentVersion records which wording the
// applicant agreed to, for future re-consent if the policy text changes.
model ConsentRecord {
  id                    String   @id @default(cuid())
  profile               Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId             String   @unique
  privacyConsent        Boolean  @default(false)
  matchmakingConsent    Boolean  @default(false)
  contactSharingConsent Boolean  @default(false)
  termsAccepted         Boolean  @default(false)
  consentVersion        String   @default("1.0")
  agreedAt              DateTime @default(now())
  ipHash                String?
}

// Pending, admin-reviewable edits to sensitive fields submitted by the applicant.
model PendingUpdate {
  id          String   @id @default(cuid())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String   @unique
  payload     String // JSON blob of the proposed changes
  submittedAt DateTime @default(now())
}

// STEP 21 — cosmetic, per-applicant dashboard layout state (pinned widgets,
// collapsed cards, last-visited tab). Never admin-reviewed, never affects
// matching/eligibility — distinct from PendingUpdate above.
model DashboardPreference {
  id             String   @id @default(cuid())
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId      String   @unique
  pinnedWidgets  String? // JSON array of widget keys
  collapsedCards String? // JSON array of collapsed card keys
  lastVisitedTab String?
  updatedAt      DateTime @updatedAt
}

model ProfileNote {
  id         String    @id @default(cuid())
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String?
  match      Match?    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId    String?
  admin      AdminUser @relation(fields: [adminId], references: [id])
  adminId    String
  text       String
  pinned     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([profileId])
  @@index([proposalId])
  @@index([matchId])
}

// ---------- Matching & proposals ----------

model Match {
  id         String  @id @default(cuid())
  profileA   Profile @relation("MatchProfileA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileAId String
  profileB   Profile @relation("MatchProfileB", fields: [profileBId], references: [id], onDelete: Cascade)
  profileBId String

  score              Int // overall mutual compatibility score, 0-100
  ageScore           Int
  locationScore      Int
  educationScore     Int
  professionScore    Int
  incomeScore        Int
  maritalStatusScore Int
  heightScore        Int
  familyScore        Int
  religiousScore     Int
  lifestyleScore     Int
  languagesScore     Int    @default(0)
  directionAToB      Int    @default(0) // how well B satisfies A's stated preference
  directionBToA      Int    @default(0) // how well A satisfies B's stated preference
  breakdown          String // JSON: [{category, weight, score, status, reason}] — full explanation, see src/lib/matching.ts

  // Versioning + recalculation audit trail (STEP 6 §33/§34) — historical
  // rows are never silently rewritten; recalculating snapshots the prior
  // score/breakdown here before overwriting the live fields above.
  algorithmVersion  String    @default("LPP-MATCH-v1.0")
  previousScore     Int?
  previousBreakdown String?
  recalculatedAt    DateTime?

  status         MatchStatus          @default(SUGGESTED)
  recommendation MatchRecommendation?

  createdBy   AdminUser? @relation(fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  notes     ProfileNote[]
  proposals Proposal[]

  @@unique([profileAId, profileBId])
  @@index([profileAId])
  @@index([profileBId])
  @@index([status])
}

model Proposal {
  id           String           @id @default(cuid())
  // LPP-RP-000001 style, cosmetic display id — see src/lib/proposal-code.ts.
  // Nullable: a live table already has rows when this column was added;
  // new proposals get one at creation, old rows are lazily backfilled by
  // ensureProposalCode() the first time they're read (see plan §Schema).
  proposalCode String?          @unique
  profileA     Profile          @relation("ProposalProfileA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileAId   String
  profileB     Profile          @relation("ProposalProfileB", fields: [profileBId], references: [id], onDelete: Cascade)
  profileBId   String
  match        Match?           @relation(fields: [matchId], references: [id])
  matchId      String?
  matchScore   Int? // snapshot of Match.score at proposal-creation time
  status       ProposalStatus   @default(DRAFT)
  priority     ProposalPriority @default(MEDIUM)
  createdBy    AdminUser        @relation(fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Staff assignment (spec §24) — STAFF admins may only edit proposals
  // assigned to them, enforced in src/lib/proposal-access.ts.
  assignedTo   AdminUser? @relation("AssignedProposals", fields: [assignedToId], references: [id])
  assignedToId String?

  finalizedAt   DateTime?
  finalizedById String?
  finalNotes    String?

  marriedAt     DateTime?
  marriedById   String?
  marriageNotes String?

  // rejectionReason is a short admin-chosen category; internalRejectionNote
  // is free text that must never be serialized to any applicant-facing API
  // response (spec §17 — "never expose sensitive rejection reasons").
  rejectedAt            DateTime?
  rejectedById          String?
  rejectionReason       String?
  internalRejectionNote String?

  closedAt   DateTime?
  archivedAt DateTime?

  // Anti-spam cooldown guard for the "still pending a response" reminder
  // (spec §23) — see src/app/api/cron/notifications/route.ts.
  lastPendingReminderAt DateTime?

  events               ProposalEvent[]
  notes                ProfileNote[]
  communications       Communication[]
  followUps            FollowUp[]
  responses            ProposalResponse[]
  contactPermissions   ContactPermission[]
  meetings             Meeting[]
  familyCommunications FamilyCommunication[]
  notifications        Notification[]
  communicationLogs    CommunicationLog[]
  familyDecisions      FamilyDecision[]

  @@index([profileAId])
  @@index([profileBId])
  @@index([matchId])
  @@index([assignedToId])
  @@index([status])
  @@index([status, updatedAt]) // STEP 15 — pending-proposal reminder sweep
}

model ProposalEvent {
  id         String         @id @default(cuid())
  proposal   Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId String
  status     ProposalStatus
  note       String?
  createdAt  DateTime       @default(now())

  // Exactly one of these is set — an admin action vs. an applicant's own
  // self-service response (spec §12 "Performed by").
  performedByAdmin     AdminUser? @relation(fields: [performedByAdminId], references: [id])
  performedByAdminId   String?
  performedByProfile   Profile?   @relation(fields: [performedByProfileId], references: [id])
  performedByProfileId String?

  @@index([proposalId])
}

// Per-profile Interested/Not Interested/Need More Info response (spec §6).
// Upserted — one row per profile per proposal, respondedAt tracks the
// latest response if a profile changes their mind.
model ProposalResponse {
  id          String                 @id @default(cuid())
  proposal    Proposal               @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId  String
  profile     Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  response    ProposalResponseType
  reason      ProposalDeclineReason?
  reasonNote  String?
  respondedAt DateTime               @default(now())

  @@unique([proposalId, profileId])
  @@index([proposalId])
}

// Per-profile contact consent state (spec §8) — distinct from
// ContactShareLog, which records the actual one-shot reveal of contact
// details once both sides here are approved.
model ContactPermission {
  id           String     @id @default(cuid())
  proposal     Proposal   @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId   String
  profile      Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  requestedAt  DateTime   @default(now())
  approvedAt   DateTime?
  approvedBy   AdminUser? @relation(fields: [approvedById], references: [id])
  approvedById String?
  revokedAt    DateTime?

  @@unique([proposalId, profileId])
  @@index([proposalId])
}

model Meeting {
  id           String        @id @default(cuid())
  proposal     Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId   String
  meetingType  MeetingType
  scheduledAt  DateTime
  locationInfo String?
  participants String?
  status       MeetingStatus @default(REQUESTED)
  notes        String?
  followUpDate DateTime?
  createdBy    AdminUser     @relation(fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Scheduled-reminder dedup guards (spec §23) — see
  // src/app/api/cron/notifications/route.ts.
  reminder24hSentAt DateTime?
  reminder2hSentAt  DateTime?

  @@index([proposalId])
  @@index([scheduledAt])
}

// Optional family-involvement log (spec §9) — kept separate from the
// general Communication model since its fields (contact person,
// relationship, outcome) are specific to family outreach.
model FamilyCommunication {
  id                  String    @id @default(cuid())
  proposal            Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId          String
  profile             Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId           String
  contactPerson       String
  relationship        String
  communicationMethod String
  communicationDate   DateTime
  outcome             String?
  notes               String?
  nextFollowUpDate    DateTime?
  createdBy           AdminUser @relation(fields: [createdById], references: [id])
  createdById         String
  createdAt           DateTime  @default(now())

  @@index([proposalId])
  @@index([profileId])
}

// Running counter backing LPP-RP-###### proposal codes — see
// src/lib/proposal-code.ts (mirrors ProfileCodeCounter).
model ProposalCodeCounter {
  id      Int @id @default(1)
  lastSeq Int @default(0)
}

model Communication {
  id           String            @id @default(cuid())
  profile      Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  proposal     Proposal?         @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  proposalId   String?
  admin        AdminUser         @relation(fields: [adminId], references: [id])
  adminId      String
  type         CommunicationType
  notes        String?
  occurredAt   DateTime          @default(now())
  followUpDate DateTime?
  createdAt    DateTime          @default(now())

  @@index([profileId])
  @@index([proposalId])
}

model FollowUp {
  id          String           @id @default(cuid())
  profile     Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  proposal    Proposal?        @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  proposalId  String?
  admin       AdminUser?       @relation(fields: [adminId], references: [id])
  adminId     String?
  title       String?
  note        String?
  purpose     String? // e.g. "Check on family discussion" — spec §11
  outcome     String? // recorded once the follow-up is completed
  dueDate     DateTime
  priority    FollowUpPriority @default(MEDIUM)
  status      FollowUpStatus   @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  // Scheduled-reminder dedup guard (spec §23).
  reminderSentAt DateTime?

  @@index([dueDate, status])
  @@index([profileId])
  @@index([proposalId])
}

// ---------- Contact sharing ----------

model ContactShareLog {
  id             String    @id @default(cuid())
  profileA       Profile   @relation("ShareProfileA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileAId     String
  profileB       Profile   @relation("ShareProfileB", fields: [profileBId], references: [id], onDelete: Cascade)
  profileBId     String
  phoneShared    Boolean   @default(false)
  whatsappShared Boolean   @default(false)
  emailShared    Boolean   @default(false)
  approvedBy     AdminUser @relation(fields: [approvedById], references: [id])
  approvedById   String
  sharedAt       DateTime  @default(now())

  @@index([profileAId])
  @@index([profileBId])
}

// ---------- Verification & Trust (STEP 8) ----------

// One-to-one with Profile — the real source of truth for verification state.
// Profile.verified stays a derived, auto-synced boolean (see
// src/lib/verification/status.ts's setVerificationStatus()) so every
// existing `profile.verified` read across matching/proposals/badges keeps
// working unchanged.
model ProfileVerification {
  id        String             @id @default(cuid())
  profile   Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String             @unique
  status    VerificationStatus @default(NOT_VERIFIED)

  assignedTo   AdminUser? @relation("VerificationAssignee", fields: [assignedToId], references: [id])
  assignedToId String?

  phoneVerifiedAt    DateTime?
  emailVerifiedAt    DateTime?
  whatsappVerifiedAt DateTime? // stub — stays null until a real WhatsApp provider exists

  // User-facing — shown verbatim on /my-verification (spec §15).
  requestedInfoItems String? // JSON array of checklist itemKeys

  // Internal only — never serialized to any applicant-facing route (spec §16).
  rejectionReasonCategory String?
  rejectionNote           String?
  suspensionReason        String?
  reVerificationReason    String?

  expiresAt           DateTime?
  verificationVersion Int       @default(1)

  lastReviewedAt   DateTime?
  lastReviewedBy   AdminUser? @relation("VerificationReviewer", fields: [lastReviewedById], references: [id])
  lastReviewedById String?

  // ---------- STEP 23 — Identity Verification Provider session tracking ----------
  // Additive columns on the row they track, matching how assignedToId/expiresAt/
  // verificationVersion were already added — never split into a 1:1 satellite
  // model. Only ever set when IDENTITY_VERIFICATION_ENABLED and a provider is
  // configured; null otherwise (today's manual-document-review path, unchanged).
  providerName      String? // e.g. "mock" — see src/lib/verification/provider/
  providerSessionId String?
  providerReference String?
  providerStatus    String? // the provider's own status string, stored as-is for display; never itself sufficient to reach VERIFIED — see setVerificationStatus()

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items VerificationItem[]

  @@index([status])
  @@index([assignedToId])
}

model VerificationItem {
  id                    String                 @id @default(cuid())
  profileVerification   ProfileVerification    @relation(fields: [profileVerificationId], references: [id], onDelete: Cascade)
  profileVerificationId String
  itemKey               String // matches a key in src/lib/verification/checklist-catalog.ts
  status                VerificationItemStatus @default(PENDING)
  document              VerificationDocument?  @relation(fields: [documentId], references: [id])
  documentId            String?                @unique
  note                  String?
  completedBy           AdminUser?             @relation(fields: [completedById], references: [id])
  completedById         String?
  completedAt           DateTime?

  @@unique([profileVerificationId, itemKey])
}

// Covers both phone OTP (6-digit code) and email verification (long token) —
// same hash-and-compare mechanism, distinguished by `channel`.
model OtpVerification {
  id                String     @id @default(cuid())
  profile           Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId         String
  channel           OtpChannel
  codeHash          String // bcrypt hash — the raw code/token is never stored
  destinationMasked String // e.g. "+92*****017" or "j***@example.com", display-only
  attempts          Int        @default(0)
  maxAttempts       Int        @default(5)
  status            OtpStatus  @default(PENDING)
  expiresAt         DateTime
  verifiedAt        DateTime?
  createdAt         DateTime   @default(now())

  @@index([profileId, channel])
}

model VerificationDocument {
  id                     String               @id @default(cuid())
  profile                Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId              String
  documentType           DocumentType
  secureStorageReference String // Vercel Blob key — never sent to the client, see document-storage.ts
  ivBase64               String // AES-256-GCM nonce
  authTagBase64          String
  mimeType               String
  sizeBytes              Int
  uploadedAt             DateTime             @default(now())
  reviewStatus           DocumentReviewStatus @default(PENDING)
  reviewedBy             AdminUser?           @relation(fields: [reviewedById], references: [id])
  reviewedById           String?
  reviewedAt             DateTime?
  reviewNote             String?
  expiresAt              DateTime?

  item VerificationItem?

  @@index([profileId])
}

model SecurityFlag {
  id               String               @id @default(cuid())
  profile          Profile              @relation("SecurityFlagProfile", fields: [profileId], references: [id], onDelete: Cascade)
  profileId        String
  flagType         SecurityFlagType
  severity         SecurityFlagSeverity @default(MEDIUM)
  status           SecurityFlagStatus   @default(OPEN)
  assignedTo       AdminUser?           @relation("SecurityFlagAssignee", fields: [assignedToId], references: [id])
  assignedToId     String?
  // The other profile in a suspected duplicate pair (spec §12 — no separate
  // duplicate-detection table, a duplicate is just this flag type).
  relatedProfile   Profile?             @relation("SecurityFlagRelatedProfile", fields: [relatedProfileId], references: [id])
  relatedProfileId String?
  description      String
  resolution       String?
  resolvedBy       AdminUser?           @relation("SecurityFlagResolver", fields: [resolvedById], references: [id])
  resolvedById     String?
  resolvedAt       DateTime?
  createdAt        DateTime             @default(now())

  // ---------- STEP 24 — risk_signals extension (this model IS the signal store) ----------
  // All nullable/defaulted so every existing reader and row keeps working.
  signalCode          String?              @unique // LPP-SIGNAL-###### via nextSequenceCode("SIGNAL")
  category            RiskSignalCategory?
  confidence          RiskConfidence?
  source              String? // e.g. "rule-engine", "security-event-bus", "user-report", "admin-manual"
  evidenceRef         String? // loose pointer to a RiskEvidence.id / SecurityEvent.id — no FK (evidence outlives profiles)
  reviewRequired      Boolean              @default(true)
  ruleVersion         Int?
  // Idempotency: ruleKey:subject:windowBucket. A unique constraint (not a
  // check-then-insert) so concurrent detections can never double-create.
  dedupKey            String?              @unique
  riskCase            RiskCase?            @relation(fields: [riskCaseId], references: [id])
  riskCaseId          String?
  falsePositiveReason FalsePositiveReason?
  updatedAt           DateTime             @default(now()) @updatedAt

  // STEP 23 — the richer evidence companion, when this flag is a duplicate signal.
  duplicateCandidate DuplicateCandidate?

  @@index([profileId])
  @@index([status])
  @@index([riskCaseId])
  @@index([category, status])
  @@index([flagType, createdAt])
}

// ---------- STEP 23 — KYC, Identity Verification, Duplicate Detection & Safety Intelligence ----------

// The richer evidence companion to a SecurityFlag(DUPLICATE_PROFILE_SUSPECTED)
// row (see decision 3 in the STEP 23 plan) — the flag is what the existing
// Security Flags page/notifications/permission already handle unchanged;
// this carries the weighted confidence band, raw matching signals, and its
// own richer review lifecycle for the new Duplicate Detection workspace.
model DuplicateCandidate {
  id                  String                   @id @default(cuid())
  candidateCode       String                   @unique // LPP-DUPC-###### via src/lib/privacy/codes.ts
  profile             Profile                  @relation("DuplicateCandidateProfile", fields: [profileId], references: [id], onDelete: Cascade)
  profileId           String
  candidateProfile    Profile                  @relation("DuplicateCandidateCandidateProfile", fields: [candidateProfileId], references: [id], onDelete: Cascade)
  candidateProfileId  String
  securityFlag        SecurityFlag?            @relation(fields: [securityFlagId], references: [id])
  securityFlagId      String?                  @unique
  confidenceBand      DuplicateConfidenceBand
  confidenceScore     Int // 0-100, normalized weighted score — see computeDuplicateConfidence()
  matchingSignals     String // JSON array of signal names, e.g. ["MOBILE","EMAIL"]
  status              DuplicateCandidateStatus @default(POTENTIAL_DUPLICATE)
  reviewer            AdminUser?               @relation("DuplicateCandidateReviewer", fields: [reviewerId], references: [id])
  reviewerId          String?
  reviewedAt          DateTime?
  resolution          String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  // STEP 24 — structured reason when a reviewer marks the pair NOT_DUPLICATE
  // (feeds rule tuning in aggregate, never used to single out a user).
  falsePositiveReason FalsePositiveReason?

  @@unique([profileId, candidateProfileId])
  @@index([profileId])
  @@index([candidateProfileId])
  @@index([status])
}

// A confirmed, lasting relationship between two profiles — distinct from a
// transient SecurityFlag/DuplicateCandidate review. Created automatically
// when a DuplicateCandidate resolves (CONFIRMED_DUPLICATE or, so an
// already-cleared pair is never re-flagged, UNKNOWN_RELATIONSHIP for
// NOT_DUPLICATE), and manually creatable by an admin for the other types.
model AccountRelationship {
  id               String                    @id @default(cuid())
  profile          Profile                   @relation("AccountRelationshipProfile", fields: [profileId], references: [id], onDelete: Cascade)
  profileId        String
  relatedProfile   Profile                   @relation("AccountRelationshipRelatedProfile", fields: [relatedProfileId], references: [id], onDelete: Cascade)
  relatedProfileId String
  relationshipType AccountRelationshipType
  confidenceBand   DuplicateConfidenceBand?
  source           String // e.g. "duplicate_scan", "admin_manual"
  status           AccountRelationshipStatus @default(ACTIVE)
  evidenceRef      String? // loose pointer to the originating DuplicateCandidate.id or a note — no enforced FK, matching this codebase's existing polymorphic-reference convention
  notes            String?
  createdBy        AdminUser?                @relation("AccountRelationshipCreator", fields: [createdById], references: [id])
  createdById      String?
  reviewedBy       AdminUser?                @relation("AccountRelationshipReviewer", fields: [reviewedById], references: [id])
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([profileId, relatedProfileId, relationshipType])
  @@index([profileId])
  @@index([relatedProfileId])
}

// Admin-configurable, versioned verification policy — mirrors ApprovalPolicy's
// (STEP 19) never-overwrite-in-place pattern: a change creates a new version
// row rather than mutating one, so the effective-date/audit trail the spec
// requires falls out of the model shape itself.
model VerificationPolicy {
  id            String                   @id @default(cuid())
  policyKey     String // e.g. "identityVerification.enabled", "reverification.intervalDays"
  policyVersion Int                      @default(1)
  configuration String // JSON value for this key
  status        VerificationPolicyStatus @default(ACTIVE)
  effectiveFrom DateTime                 @default(now())
  effectiveTo   DateTime?
  createdBy     AdminUser?               @relation("VerificationPolicyCreator", fields: [createdById], references: [id])
  createdById   String?
  createdAt     DateTime                 @default(now())

  @@index([policyKey, status])
}

// Idempotency/replay ledger for identity-verification provider webhooks —
// mirrors STEP 14's finance-webhook event-log shape exactly (checked before
// adding this, per the "don't duplicate an existing system" instruction: this
// is a distinct table because it protects a distinct webhook source).
model VerificationProviderEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String    @unique
  eventType       String
  payloadHash     String
  signatureValid  Boolean
  processed       Boolean   @default(false)
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([provider, eventType])
}

// ---------- Audit ----------

model AuditLog {
  id                  String        @id @default(cuid())
  admin               AdminUser?    @relation(fields: [adminId], references: [id])
  adminId             String?
  action              AuditAction
  targetProfile       Profile?      @relation(fields: [targetProfileId], references: [id])
  targetProfileId     String?
  meta                String? // JSON blob of extra context
  createdAt           DateTime      @default(now())
  // STEP 15 — populated automatically by writeAudit() for admin actions only
  ipAddress           String?
  userAgent           String?
  correlationId       String?
  // STEP 22 — distinguishes "a family member acted on this profile's data"
  // from "the profile owner acted on themselves" (the latter is still just
  // adminId omitted, by the pre-existing convention). Nullable, additive —
  // reused instead of a separate family_activity_logs table.
  actorFamilyMember   FamilyMember? @relation(fields: [actorFamilyMemberId], references: [id])
  actorFamilyMemberId String?

  @@index([targetProfileId])
  @@index([adminId])
  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorFamilyMemberId])
}

// ---------- App-wide settings (single row) ----------

model AppSettings {
  id                  Int     @id @default(1)
  appName             String  @default("Life Partner Pro")
  contactEmail        String?
  contactWhatsapp     String?
  contactAddress      String?
  weightAge           Int     @default(15)
  weightLocation      Int     @default(15)
  weightEducation     Int     @default(10)
  weightProfession    Int     @default(10)
  weightIncome        Int     @default(10)
  weightMaritalStatus Int     @default(10)
  weightHeight        Int     @default(5)
  weightFamily        Int     @default(10)
  weightReligious     Int     @default(10)
  weightLifestyle     Int     @default(5)
  weightLanguages     Int     @default(5)

  // Match tier cutoffs (spec §30) — admin-configurable, must stay descending.
  thresholdExcellent Int @default(90)
  thresholdVeryGood  Int @default(80)
  thresholdGood      Int @default(65)
  thresholdPossible  Int @default(50)

  // Hard requirement vs soft preference per category (spec §27). When true,
  // a candidate failing that category is excluded from results rather than
  // just scored low — see src/lib/matching.ts.
  hardRequirementAge           Boolean @default(false)
  hardRequirementLocation      Boolean @default(false)
  hardRequirementEducation     Boolean @default(false)
  hardRequirementProfession    Boolean @default(false)
  hardRequirementIncome        Boolean @default(false)
  hardRequirementMaritalStatus Boolean @default(false)
  hardRequirementHeight        Boolean @default(false)
  hardRequirementFamily        Boolean @default(false)
  hardRequirementReligious     Boolean @default(false)
  hardRequirementLifestyle     Boolean @default(false)
  hardRequirementLanguages     Boolean @default(false)

  // Per-category on/off (STEP 6 §5) — distinct from weight/hard-requirement:
  // a disabled category is skipped entirely (not scored, not shown), and its
  // weight no longer counts toward the normalization denominator in
  // src/lib/matching.ts.
  categoryEnabledAge           Boolean @default(true)
  categoryEnabledLocation      Boolean @default(true)
  categoryEnabledEducation     Boolean @default(true)
  categoryEnabledProfession    Boolean @default(true)
  categoryEnabledIncome        Boolean @default(true)
  categoryEnabledMaritalStatus Boolean @default(true)
  categoryEnabledHeight        Boolean @default(true)
  categoryEnabledFamily        Boolean @default(true)
  categoryEnabledReligious     Boolean @default(true)
  categoryEnabledLifestyle     Boolean @default(true)
  categoryEnabledLanguages     Boolean @default(true)

  // Matching Center behavior (STEP 6 §19/§43).
  maxMatchResults                Int     @default(10)
  excludeHardRequirementFailures Boolean @default(false)

  // Verification & Trust (STEP 8).
  documentVerificationEnabled        Boolean @default(false)
  acceptedDocumentTypes              String? // JSON array of DocumentType strings
  allowPartiallyVerifiedManualMatch  Boolean @default(false)
  removeFromPoolDuringReVerification Boolean @default(true)
  autoReVerificationOnKeyFieldChange Boolean @default(true)
  otpExpiryMinutes                   Int     @default(10)
  otpMaxAttempts                     Int     @default(5)

  // Notification & Communication (STEP 9). SMS/WhatsApp default off since no
  // real provider is configured in this environment — see
  // src/lib/notifications/providers/.
  emailNotificationsEnabled    Boolean @default(true)
  smsNotificationsEnabled      Boolean @default(false)
  whatsappNotificationsEnabled Boolean @default(false)
  inAppNotificationsEnabled    Boolean @default(true)
  defaultNotificationLanguage  Locale  @default(EN)
  meetingReminder24hEnabled    Boolean @default(true)
  meetingReminder2hEnabled     Boolean @default(true)
  followUpReminderEnabled      Boolean @default(true)
  pendingProposalReminderDays  Int     @default(3)
  notificationRetryLimit       Int     @default(3)
  quietHoursStart              Int? // hour of day, 0-23 — applied only to cron-triggered non-essential reminders
  quietHoursEnd                Int?

  // Reports & Analytics (STEP 10) — admin-configurable bucket definitions;
  // null means "use the built-in defaults" (see src/lib/reports/buckets.ts).
  ageRangeBuckets      Json?
  incomeRangeBuckets   Json?
  professionCategories Json?

  // Staff Management & Permissions (STEP 11). Session duration is NOT
  // configurable here — NextAuth's JWT maxAge is fixed at Edge config
  // construction time (src/lib/auth.config.ts) and can't do a DB read there
  // without breaking the Edge/Node split that keeps middleware under
  // Vercel's bundle limit; the 30-day default stays hardcoded.
  loginMaxAttempts       Int   @default(5)
  loginLockoutMinutes    Int   @default(15)
  twoFactorRequiredRoles Json? // array of AdminRole strings
  passwordMinLength      Int   @default(8)

  // Support, Complaints, Safety & Case Management (STEP 12) — SLA is elapsed
  // wall-clock hours, not a business-hours/holiday calendar (no such
  // infrastructure exists anywhere in this codebase — see src/lib/case-sla.ts).
  caseSlaNormalFirstResponseHours   Int @default(24)
  caseSlaNormalResolutionHours      Int @default(72)
  caseSlaHighFirstResponseHours     Int @default(8)
  caseSlaHighResolutionHours        Int @default(24)
  caseSlaUrgentFirstResponseHours   Int @default(2)
  caseSlaUrgentResolutionHours      Int @default(8)
  caseSlaCriticalFirstResponseHours Int @default(1)
  caseSlaCriticalResolutionHours    Int @default(4)

  // Payments & Billing (STEP 14). paidFeatureKeys is the Super-Admin
  // "which features currently require an entitlement" switch (spec §1) —
  // empty by default, so nothing is gated unless explicitly turned on.
  activePaymentProvider                 PaymentProviderName @default(MANUAL)
  defaultCurrencyCode                   String              @default("PKR")
  subscriptionGracePeriodDays           Int                 @default(7)
  paymentRetryLimit                     Int                 @default(3)
  refundApprovalRequiredAboveMinorUnits Int?
  paidFeatureKeys                       Json?

  // Payment Rollout Phases (STEP 14 add-on). Stage gates new checkout
  // sessions only — never touches existing subscriptions/invoices/refunds.
  // Defaults reflect the honest current state: nothing has been through
  // sandbox testing yet, so payments start fully DISABLED.
  paymentRolloutStage              PaymentRolloutStage @default(DISABLED)
  paymentsEnabled                  Boolean             @default(false)
  checkoutEnabled                  Boolean             @default(false)
  subscriptionsEnabled             Boolean             @default(false)
  refundsEnabled                   Boolean             @default(true)
  manualPaymentEnabled             Boolean             @default(true)
  betaEnabled                      Boolean             @default(false)
  publicCheckoutEnabled            Boolean             @default(false)
  providerWebhooksEnabled          Boolean             @default(true)
  // STEP 27 — membership/entitlements kill switches, same open AppSettings
  // pattern as the payment flags above (never SystemControl.emergency's
  // fixed Zod shape, which would need a migration per new switch).
  renewalsEnabled                  Boolean             @default(true)
  couponsEnabled                   Boolean             @default(true)
  referralsEnabled                 Boolean             @default(true)
  promotionsEnabled                Boolean             @default(true)
  creditsEnabled                   Boolean             @default(true)
  paymentBetaPercentage            Int                 @default(0)
  paymentBetaAllowedProfileIds     Json?
  paymentBetaAllowedCountries      Json?
  paymentBetaAllowedPackageIds     Json?
  paymentInternalAllowedProfileIds Json?
  reconciliationFrequency          String              @default("DAILY")
  lastScheduledReconciliationAt    DateTime?

  updatedAt DateTime @updatedAt
}

enum PaymentRolloutStage {
  DISABLED
  SANDBOX
  INTERNAL
  BETA
  PRODUCTION
}

// Audit trail for payment rollout-stage transitions (STEP 14 add-on §78),
// distinct from the generic AuditLog entry written alongside it — this one
// captures the state-machine history specifically.
model PaymentRolloutEvent {
  id        String               @id @default(cuid())
  fromStage PaymentRolloutStage?
  toStage   PaymentRolloutStage
  reason    String?
  actorId   String
  actor     AdminUser            @relation(fields: [actorId], references: [id])
  createdAt DateTime             @default(now())

  @@index([createdAt])
}

// Running counter backing the human-readable LPP-###### profile codes.
model ProfileCodeCounter {
  id      Int @id @default(1)
  lastSeq Int @default(0)
}

// ---------- Notification & Communication (STEP 9) ----------

// Persisted, per-recipient in-app notification — drives the user and admin
// bells. Exactly one of recipientProfileId/recipientAdminId is set, mirroring
// ProposalEvent's performedByAdmin/performedByProfile pattern. Never created
// directly — always via src/lib/notifications/notification-service.ts.
model Notification {
  id                      String           @id @default(cuid())
  recipientProfileId      String?
  recipientAdminId        String?
  // STEP 22 — third recipient kind, additive nullable column (see
  // sendNotification()'s new branch); never set together with the other two.
  recipientFamilyMemberId String?
  type                    NotificationType
  title                   String
  body                    String // privacy-safe, generic copy only — see spec §33
  relatedProposalId       String?
  relatedProfileId        String?
  actionUrl               String?
  readAt                  DateTime?
  createdAt               DateTime         @default(now())
  // STEP 25 - notification center metadata (optional / defaulted)
  priority                String           @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  category                String? // PROPOSAL | MEETING | VERIFICATION | SUPPORT | PRIVACY | SECURITY | FAMILY | PAYMENT | SYSTEM
  archivedAt              DateTime?

  recipientProfile      Profile?      @relation("NotificationRecipientProfile", fields: [recipientProfileId], references: [id], onDelete: Cascade)
  recipientAdmin        AdminUser?    @relation("NotificationRecipientAdmin", fields: [recipientAdminId], references: [id])
  recipientFamilyMember FamilyMember? @relation(fields: [recipientFamilyMemberId], references: [id], onDelete: Cascade)
  relatedProposal       Proposal?     @relation(fields: [relatedProposalId], references: [id], onDelete: SetNull)
  relatedProfile        Profile?      @relation("NotificationRelatedProfile", fields: [relatedProfileId], references: [id], onDelete: SetNull)

  @@index([recipientProfileId, readAt, createdAt])
  @@index([recipientAdminId, readAt, createdAt])
  @@index([recipientFamilyMemberId, readAt, createdAt])
  @@index([type])
}

// The automated outbound-notification delivery record (spec §15) — distinct
// from the pre-existing Communication model, which is an admin's manual
// "I called/emailed the applicant" log. One row per channel per
// sendNotification() call, including IN_APP (so per-profile communication
// history, spec §26, is complete).
model CommunicationLog {
  id                 String              @id @default(cuid())
  profileId          String
  proposalId         String?
  channel            NotificationChannel
  notificationType   NotificationType
  templateKey        String?
  recipientReference String? // masked, e.g. "+92*****017" — never a raw destination
  deliveryStatus     DeliveryStatus      @default(QUEUED)
  messageBody        String? // access-gated by communication:message:view in the serializer
  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  createdById        String? // set only for admin-composed manual sends (spec §12); null for system-triggered
  providerMessageId  String?
  failureReason      String?
  retryCount         Int                 @default(0)
  isTest             Boolean             @default(false) // spec §32 — excluded from analytics totals
  createdAt          DateTime            @default(now())

  // ---------- STEP 25 - this row is also the queue entry and the dead-letter record ----------
  communicationId String? // correlation id shared by every channel of one logical message
  purpose         CommunicationPurpose?
  messageType     CommunicationMessageType?
  recipientType   CommunicationRecipientType @default(PROFILE)
  templateId      String?
  templateVersion Int?
  provider        String? // CommunicationProvider.providerKey used for the last attempt
  queuedAt        DateTime?
  failedAt        DateTime?
  attempts        Int                        @default(0)
  nextAttemptAt   DateTime? // set for QUEUED rows waiting on backoff / quiet hours
  lockedUntil     DateTime? // claim marker so two drains never send the same row
  failureClass    CommunicationFailureClass?
  deadLetteredAt  DateTime?
  blockedReason   String? // BLOCKED_* code when the policy engine refused to send
  bodyEncrypted   Boolean                    @default(false)
  bodyRedactedAt  DateTime?
  threadId        String?
  campaignId      String?

  deliveryEvents CommunicationDeliveryEvent[]

  profile   Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  proposal  Proposal?  @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  createdBy AdminUser? @relation(fields: [createdById], references: [id])

  @@index([profileId, createdAt])
  @@index([proposalId])
  @@index([deliveryStatus])
  @@index([providerMessageId])
  @@index([deliveryStatus, nextAttemptAt])
  @@index([campaignId])
  @@index([communicationId])
  @@index([deadLetteredAt])
}

// One row per profile (spec §10) — non-essential notification opt-in/out per
// channel x category. Essential Account/Verification/Security types bypass
// this entirely (see src/lib/notifications/classification.ts).
model NotificationPreference {
  id        String @id @default(cuid())
  profileId String @unique

  inAppProposalUpdates   Boolean @default(true)
  inAppMeetingUpdates    Boolean @default(true)
  inAppFollowUpReminders Boolean @default(true)
  inAppMarketing         Boolean @default(false)

  emailProposalUpdates   Boolean @default(true)
  emailMeetingUpdates    Boolean @default(true)
  emailFollowUpReminders Boolean @default(true)
  emailMarketing         Boolean @default(false)

  smsProposalUpdates   Boolean @default(true)
  smsMeetingUpdates    Boolean @default(true)
  smsFollowUpReminders Boolean @default(true)
  smsMarketing         Boolean @default(false)

  whatsappProposalUpdates   Boolean @default(true)
  whatsappMeetingUpdates    Boolean @default(true)
  whatsappFollowUpReminders Boolean @default(true)
  whatsappMarketing         Boolean @default(false)

  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// Per-channel consent CURRENT STATE (spec §25) — distinct from preferences
// above. In-app needs no consent row; only EMAIL/SMS/WHATSAPP are tracked
// here at the application layer.
model CommunicationConsent {
  id            String              @id @default(cuid())
  profileId     String
  channel       NotificationChannel
  status        ConsentStatus       @default(GRANTED)
  consentedAt   DateTime            @default(now())
  consentSource String
  revokedAt     DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, channel])
}

// Admin-editable override for a (event, channel, language) combination
// (spec §19). If no ACTIVE row exists, src/lib/notifications/template-resolver.ts
// falls back to the built-in default-templates.ts dictionary, then to English.
model NotificationTemplate {
  id          String              @id @default(cuid())
  name        String
  event       String // matches an event key in src/lib/notifications/events.ts
  channel     NotificationChannel
  language    Locale
  subject     String?
  message     String
  status      TemplateStatus      @default(ACTIVE)
  variables   Json // allow-listed {{variable}} names only — never arbitrary/sensitive
  updatedById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  updatedBy AdminUser? @relation(fields: [updatedById], references: [id])

  @@unique([event, channel, language])
}

// Idempotent webhook intake log (spec §28) — no real provider exists in this
// environment; the admin "Simulate Webhook" action exercises this same path.
model WebhookEvent {
  id                String               @id @default(cuid())
  provider          String
  eventType         String // DELIVERED | READ | FAILED | BOUNCED
  providerMessageId String?
  idempotencyKey    String               @unique
  payload           Json?
  processedAt       DateTime?
  createdAt         DateTime             @default(now())
  // STEP 25 - replay protection / audit of inbound provider events (all optional)
  providerEventId   String?
  payloadHash       String?
  status            String               @default("PROCESSED") // RECEIVED | PROCESSED | REJECTED | FAILED
  attempts          Int                  @default(0)
  signatureValid    Boolean              @default(true)
  channel           NotificationChannel?
  failureReason     String?

  @@index([provider, providerEventId])
  @@index([createdAt])
}

// ---------- Reports & Analytics (STEP 10) ----------

enum ReportExportType {
  CSV
  EXCEL
  PDF
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// One row per generated/exported report (spec §24 "Report History"). Never
// stores the actual exported file bytes — only enough metadata to audit and
// regenerate (spec §24 "do not store unnecessary sensitive copies").
model ReportExecution {
  id          String            @id @default(cuid())
  name        String
  reportKey   String // "overview" | "registration" | ... | "custom"
  dataSource  String? // set only when reportKey="custom": Profiles|Verification|Matches|Proposals|Meetings|Communications|FollowUps
  filters     Json
  columns     Json?
  groupBy     String?
  sortBy      String?
  exportType  ReportExportType?
  recordCount Int
  createdById String
  createdBy   AdminUser         @relation(fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([createdById])
  @@index([createdAt])
  @@index([reportKey])
}

// Super-Admin-configured recurring report delivery (spec §25). Evaluated by
// the existing once-daily notifications cron tick (this Vercel account's
// Hobby plan rejects any more-frequent cron job) — see
// src/lib/reports/scheduler.ts.
model ScheduledReport {
  id                String           @id @default(cuid())
  name              String
  reportKey         String
  dataSource        String?
  filters           Json
  frequency         ReportFrequency
  dayOfWeek         Int? // 0-6, WEEKLY only
  dayOfMonth        Int? // 1-28, MONTHLY only (capped to dodge month-length edge cases)
  hourUtc           Int
  exportType        ReportExportType @default(CSV)
  recipientAdminIds Json // string[] of AdminUser ids
  lastRunAt         DateTime?
  nextRunAt         DateTime
  active            Boolean          @default(true)
  createdById       String
  createdBy         AdminUser        @relation(fields: [createdById], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([active, nextRunAt])
}

// ---------- Staff Management & Permissions (STEP 11) ----------

// Metadata-only registry for the Permission Matrix UI's checkbox grid — NOT
// the authorization source of truth (that's the `Permission` TS union in
// src/lib/permissions.ts). Keys must match those strings exactly.
model PermissionDef {
  key         String  @id
  module      String
  action      String
  description String?

  customRoles CustomRolePermission[]
}

// Additive on top of the 4 hardcoded system roles (SUPER_ADMIN/ADMIN/STAFF/
// VIEWER) — see src/lib/effective-permissions.ts. baseRole determines
// row-scoping shape (STAFF-style assigned-only access) and must be STAFF or
// VIEWER, enforced in the API route, not the DB.
model CustomRole {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  baseRole    AdminRole @default(STAFF)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // STEP 17 §42 — closes out the custom-role fields the spec asks for beyond
  // what STEP 11 already built (id/name/description/permissions/active above).
  // Both optional/defaulted: an existing custom role with neither set behaves
  // exactly as before.
  allowedRecordTypes AssignmentResourceType[] @default([])
  defaultAccessLevel AccessLevel?

  permissions CustomRolePermission[]
  admins      AdminUser[]
}

model CustomRolePermission {
  customRole    CustomRole    @relation(fields: [customRoleId], references: [id], onDelete: Cascade)
  customRoleId  String
  permission    PermissionDef @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  permissionKey String

  @@id([customRoleId, permissionKey])
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  admins           AdminUser[]
  tasks            AdminTask[]
  approvalRequests ApprovalRequest[]
  savedSearches    SavedSearch[]
}

// Tracks a live JWT session for revocation (spec §13) — the JWT itself
// embeds this row's id as `sid`; requireAdmin() checks it on every request
// (see src/lib/route-guard.ts). Not read by the Edge-safe auth callbacks.
model AdminSession {
  id           String    @id @default(cuid())
  admin        AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId      String
  deviceInfo   String?
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedById  String?

  @@index([adminId])
}

// Durable login-attempt ledger (spec §14) — also the source of truth for
// lockout (see src/lib/auth.ts's precheck), deliberately not the in-memory
// rateLimit() helper, which doesn't survive serverless cold starts.
model AdminLoginHistory {
  id        String            @id @default(cuid())
  admin     AdminUser?        @relation(fields: [adminId], references: [id])
  adminId   String?
  email     String
  event     LoginHistoryEvent
  ipAddress String?
  userAgent String?
  createdAt DateTime          @default(now())

  @@index([adminId])
  @@index([email, createdAt])
}

// Email-OTP 2FA challenge (spec §12) — mirrors STEP 8's
// src/lib/verification/otp.ts hashed-code/expiry/max-attempts convention.
model AdminOtpChallenge {
  id          String    @id @default(cuid())
  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId     String
  purpose     String    @default("LOGIN_2FA")
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminId])
}

// Unified assignment-tracking table (spec §7/§8/§20) — additive alongside
// the existing Proposal/ProfileVerification/SecurityFlag assignedToId
// columns (those + their access-check helpers are untouched). This is the
// ONLY backing store for Profile and FollowUp assignment, which have no FK
// column of their own.
model AdminAssignment {
  id           String                 @id @default(cuid())
  admin        AdminUser              @relation("AdminAssignmentAssignee", fields: [adminId], references: [id])
  adminId      String
  resourceType AssignmentResourceType
  resourceId   String
  priority     AssignmentPriority     @default(NORMAL)
  status       AssignmentStatus       @default(ASSIGNED)
  // STEP 17 §3 — the level this assignment grants; defaults to MANAGE, i.e. the
  // full "owner" access every assignment has always implicitly granted, so
  // every pre-STEP-17 row keeps its current effective behavior unchanged.
  accessLevel  AccessLevel            @default(MANAGE)
  assignedAt   DateTime               @default(now())
  dueAt        DateTime?
  // STEP 17 §20 — temporary access. Checked lazily at read time by every
  // access-check helper (an assignment past expiresAt is treated as if it
  // doesn't exist) — same lazy-expiry convention as BreakGlassAccess.expiresAt
  // and ProfileRestriction.endDate. No cron sweep; null = never expires.
  expiresAt    DateTime?
  notes        String?
  createdBy    AdminUser              @relation("AdminAssignmentCreator", fields: [createdById], references: [id])
  createdById  String

  @@index([adminId, resourceType])
  @@index([resourceType, resourceId])
  @@index([status])
}

// Discrete staff work items (spec §23/§24), auto-created at existing STEP 9
// notification trigger points — see src/lib/admin-tasks.ts. STEP 18 extends
// this table additively into the full Workflow & Task Management system
// (src/lib/workflow/engine.ts) rather than replacing it — every column below
// this line is nullable/defaulted so pre-STEP-18 rows keep their exact
// current behavior.
model AdminTask {
  id           String                 @id @default(cuid())
  assignedTo   AdminUser?             @relation("AdminTaskAssignee", fields: [assignedToId], references: [id])
  assignedToId String?
  taskType     AdminTaskType
  resourceType AssignmentResourceType
  resourceId   String
  priority     AssignmentPriority     @default(NORMAL)
  status       AdminTaskStatus        @default(PENDING)
  dueAt        DateTime?
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime               @default(now())

  // ---------- STEP 18 additions (all nullable/defaulted) ----------
  taskCode             String?              @unique // LPP-TASK-###### via src/lib/privacy/codes.ts
  title                String?
  description          String?
  startedAt            DateTime?
  completionNotes      String?
  escalationLevel      Int                  @default(1)
  escalationStatus     TaskEscalationStatus @default(NONE)
  parentTask           AdminTask?           @relation("TaskParent", fields: [parentTaskId], references: [id])
  parentTaskId         String?
  childTasks           AdminTask[]          @relation("TaskParent")
  accessLevel          AccessLevel          @default(MANAGE)
  visibility           TaskVisibility       @default(STANDARD)
  version              Int                  @default(1)
  createdBy            AdminUser?           @relation("AdminTaskCreator", fields: [createdById], references: [id])
  createdById          String?
  assignedDepartment   Department?          @relation(fields: [assignedDepartmentId], references: [id])
  assignedDepartmentId String?
  outcome              String?
  updatedAt            DateTime             @updatedAt

  comments         TaskComment[]
  checklistItems   TaskChecklistItem[]
  dependsOn        TaskDependency[]    @relation("TaskDependent")
  dependedOnBy     TaskDependency[]    @relation("TaskDependsOn")
  escalations      TaskEscalation[]
  statusHistory    TaskStatusHistory[]
  attachments      TaskAttachment[]
  accessLogs       TaskAccessLog[]
  workflowEvents   WorkflowEvent[]
  workflowFailures WorkflowFailure[]
  approvalRequest  ApprovalRequest? // STEP 19 — the approval this review task was created for, if any

  @@index([assignedToId, status])
  @@index([resourceType, resourceId])
  @@index([status, dueAt])
  @@index([escalationLevel, escalationStatus])
  @@index([parentTaskId])
  @@index([assignedDepartmentId])
}

enum TaskEscalationStatus {
  NONE
  ESCALATED
  RESOLVED
}

enum TaskVisibility {
  STANDARD
  RESTRICTED
}

enum TaskCommentVisibility {
  INTERNAL
  TEAM
  MANAGER_ONLY
  SYSTEM
}

enum TaskDependencyType {
  BLOCKS
  DEPENDS_ON
}

enum WorkflowFailureStage {
  EVENT_RECEIVED
  TASK_CREATION
  ASSIGNMENT
  NOTIFICATION
  TRANSITION
}

enum WorkflowEventStatus {
  PENDING
  PROCESSED
  FAILED
}

// Internal task discussion — never exposed through any user/applicant-facing
// API (spec §17). Mirrors CaseComment's visibility-tiering convention.
model TaskComment {
  id                String                @id @default(cuid())
  task              AdminTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId            String
  author            AdminUser             @relation(fields: [authorId], references: [id])
  authorId          String
  body              String
  visibility        TaskCommentVisibility @default(INTERNAL)
  mentionedAdminIds String[]              @default([])
  createdAt         DateTime              @default(now())
  editedAt          DateTime?
  deletedAt         DateTime?

  @@index([taskId])
}

// Flat checklist rows (spec §27) — no separate "checklist" grouping row;
// TaskTemplate.defaultChecklist seeds these at task-creation time.
model TaskChecklistItem {
  id            String     @id @default(cuid())
  task          AdminTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId        String
  label         String
  required      Boolean    @default(false)
  order         Int        @default(0)
  completedAt   DateTime?
  completedBy   AdminUser? @relation(fields: [completedById], references: [id])
  completedById String?

  @@index([taskId])
}

// BLOCKED_BY / DEPENDS_ON (spec §18) — cycle detection enforced in
// src/lib/workflow/dependencies.ts, not at the DB level.
model TaskDependency {
  id              String             @id @default(cuid())
  task            AdminTask          @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  taskId          String
  dependsOnTask   AdminTask          @relation("TaskDependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String
  type            TaskDependencyType @default(DEPENDS_ON)
  createdAt       DateTime           @default(now())
  createdBy       AdminUser          @relation(fields: [createdById], references: [id])
  createdById     String

  @@unique([taskId, dependsOnTaskId])
}

// Mirrors CaseEscalation's shape exactly (spec §22/§46).
model TaskEscalation {
  id            String     @id @default(cuid())
  task          AdminTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId        String
  previousLevel Int
  newLevel      Int
  reason        String
  escalatedBy   AdminUser? @relation(fields: [escalatedById], references: [id])
  escalatedById String?
  createdAt     DateTime   @default(now())

  @@index([taskId])
}

// Mirrors CaseStatusHistory's shape exactly (spec §10/§46 timeline).
model TaskStatusHistory {
  id             String          @id @default(cuid())
  task           AdminTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId         String
  previousStatus AdminTaskStatus
  newStatus      AdminTaskStatus
  changedBy      AdminUser?      @relation(fields: [changedById], references: [id])
  changedById    String?
  reason         String?
  createdAt      DateTime        @default(now())

  @@index([taskId])
}

// Mirrors case-evidence-storage.ts's shape exactly (spec §49) — encrypted
// Blob storage, opaque storageKey, never a public URL.
model TaskAttachment {
  id            String    @id @default(cuid())
  task          AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId        String
  filename      String
  mimeType      String
  sizeBytes     Int
  storageKey    String
  ivBase64      String
  authTagBase64 String
  uploadedBy    AdminUser @relation(fields: [uploadedById], references: [id])
  uploadedById  String
  createdAt     DateTime  @default(now())

  @@index([taskId])
}

// Mirrors CaseAccessLog — written on every task-access-chain evaluation,
// allow or deny (spec §14), independent of the global AuditLog.
model TaskAccessLog {
  id         String    @id @default(cuid())
  task       AdminTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  admin      AdminUser @relation(fields: [adminId], references: [id])
  adminId    String
  action     String
  allowed    Boolean
  denyReason String?
  createdAt  DateTime  @default(now())

  @@index([taskId])
  @@index([adminId])
}

// Admin-configurable task templates (spec §26/§27).
model TaskTemplate {
  id                  String             @id @default(cuid())
  name                String
  taskType            AdminTaskType
  titleTemplate       String
  descriptionTemplate String?
  defaultPriority     AssignmentPriority @default(NORMAL)
  defaultChecklist    Json?
  active              Boolean            @default(true)
  createdBy           AdminUser?         @relation(fields: [createdById], references: [id])
  createdById         String?
  createdAt           DateTime           @default(now())
}

// Admin-configurable SLA targets per task type (spec §20) — deliberately a
// real table, not flat AppSettings columns (unlike Case's 5-priority scheme,
// ~25 task types would mean 50+ flat columns).
model TaskSlaConfig {
  id                    String        @id @default(cuid())
  taskType              AdminTaskType @unique
  targetResponseHours   Int?
  targetResolutionHours Int?
  warningThresholdHours Int?
  active                Boolean       @default(true)
}

// Admin-configurable event→task-type automation table (spec §19), seeded
// with the spec's default rules and editable afterward.
model WorkflowRule {
  id                          String             @id @default(cuid())
  eventName                   String             @unique
  taskType                    AdminTaskType
  defaultPriority             AssignmentPriority @default(NORMAL)
  defaultAssignedRole         AdminRole?
  defaultAssignedDepartmentId String?
  active                      Boolean            @default(true)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt
}

// Idempotency ledger for automatic task creation (spec §53/§54) — dedupKey
// is derived from sourceType+sourceId+eventName so re-delivering the same
// event never creates a duplicate task.
model WorkflowEvent {
  id          String                 @id @default(cuid())
  eventName   String
  dedupKey    String                 @unique
  sourceType  AssignmentResourceType
  sourceId    String
  payload     Json?
  status      WorkflowEventStatus    @default(PENDING)
  task        AdminTask?             @relation(fields: [taskId], references: [id])
  taskId      String?
  attempts    Int                    @default(0)
  lastError   String?
  createdAt   DateTime               @default(now())
  processedAt DateTime?
  failures    WorkflowFailure[]

  @@index([status])
  @@index([sourceType, sourceId])
}

// Dead-letter queue (spec §65/§66) — Admin → Workflow Failures.
model WorkflowFailure {
  id               String               @id @default(cuid())
  workflowEvent    WorkflowEvent?       @relation(fields: [workflowEventId], references: [id])
  workflowEventId  String?
  task             AdminTask?           @relation(fields: [taskId], references: [id])
  taskId           String?
  stage            WorkflowFailureStage
  errorMessage     String
  resolvedAt       DateTime?
  resolvedBy       AdminUser?           @relation(fields: [resolvedById], references: [id])
  resolvedById     String?
  resolution       String?
  resolutionReason String?
  createdAt        DateTime             @default(now())

  @@index([resolvedAt])
}

// Temporary unavailability + backup routing (spec §44).
model StaffAvailability {
  id            String     @id @default(cuid())
  admin         AdminUser  @relation("StaffAvailabilityAdmin", fields: [adminId], references: [id])
  adminId       String
  startAt       DateTime
  endAt         DateTime
  reason        String?
  backupAdmin   AdminUser? @relation("StaffAvailabilityBackup", fields: [backupAdminId], references: [id])
  backupAdminId String?
  active        Boolean    @default(true)
  createdBy     AdminUser  @relation("StaffAvailabilityCreator", fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime   @default(now())

  @@index([adminId, active])
}

// Controlled, time-limited, read-only support-impersonation grant (spec
// §18) — see src/lib/view-as.ts. Never grants access to passwords or OTPs.
model ViewAsSession {
  id            String    @id @default(cuid())
  superAdmin    AdminUser @relation("ViewAsInitiator", fields: [superAdminId], references: [id])
  superAdminId  String
  targetAdmin   AdminUser @relation("ViewAsTarget", fields: [targetAdminId], references: [id])
  targetAdminId String
  reason        String
  startedAt     DateTime  @default(now())
  expiresAt     DateTime
  endedAt       DateTime?

  @@index([superAdminId])
  @@index([targetAdminId])
}

// ---------- Support, Complaints, Safety & Case Management (STEP 12) ----------

// One unified table for every support request, complaint, safety report, and
// internal case (spec §6 — "every complaint, safety report, or support issue
// becomes a Case"). caseNumber's prefix is chosen by `type` at creation (see
// src/lib/case-code.ts): SUPPORT->LPP-SUP-, COMPLAINT->LPP-CMP-,
// SAFETY_REPORT/INTERNAL->LPP-CASE-. relatedProposalId/relatedMeetingId/
// relatedVerificationId/relatedCommunicationId are plain ids with no FK
// relation, mirroring AdminAssignment/AdminTask's resourceId convention —
// resolved by application code, not a Prisma include.
model Case {
  id              String       @id @default(cuid())
  caseNumber      String       @unique
  type            CaseType
  category        CaseCategory
  subject         String
  description     String
  priority        CasePriority @default(NORMAL)
  status          CaseStatus   @default(NEW)
  escalationLevel Int          @default(1)

  reporterProfile   Profile?   @relation("CaseReporterProfile", fields: [reporterProfileId], references: [id])
  reporterProfileId String?
  reportedProfile   Profile?   @relation("CaseReportedProfile", fields: [reportedProfileId], references: [id])
  reportedProfileId String?
  reportedAdmin     AdminUser? @relation("CaseReportedAdmin", fields: [reportedAdminId], references: [id])
  reportedAdminId   String?

  relatedProposalId      String?
  relatedMeetingId       String?
  relatedVerificationId  String?
  relatedCommunicationId String?
  relatedPaymentId       String? // STEP 14 — PAYMENT_BILLING cases, plain id, same convention
  relatedInvoiceId       String?

  preferredResponseMethod String?
  firstResponseDueAt      DateTime?
  resolutionDueAt         DateTime?
  firstRespondedAt        DateTime?

  mergedIntoCaseId String?
  createdBy        AdminUser? @relation("CaseCreatedBy", fields: [createdById], references: [id])
  createdById      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  closedAt         DateTime?
  softDeletedAt    DateTime?

  accessGrants  CaseAccessGrant[]
  comments      CaseComment[]
  internalNotes CaseInternalNote[]
  evidence      CaseEvidence[]
  statusHistory CaseStatusHistory[]
  escalations   CaseEscalation[]
  resolution    CaseResolution?
  accessLogs    CaseAccessLog[]
  linksFrom     CaseLink[]          @relation("CaseLinkSource")
  linksTo       CaseLink[]          @relation("CaseLinkTarget")

  @@index([type, status])
  @@index([category])
  @@index([priority, status])
  @@index([reporterProfileId])
  @@index([reportedProfileId])
  @@index([reportedAdminId])
  @@index([createdAt])
}

model CaseAccessGrant {
  id          String          @id @default(cuid())
  case        Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String
  admin       AdminUser       @relation("CaseAccessGrantee", fields: [adminId], references: [id])
  adminId     String
  level       CaseAccessLevel
  grantedBy   AdminUser       @relation("CaseAccessGranter", fields: [grantedById], references: [id])
  grantedById String
  grantedAt   DateTime        @default(now())

  @@unique([caseId, adminId])
}

// User-visible responses (visibleToUser: true) vs. internal back-and-forth
// among staff (false) — never confused with CaseInternalNote, which is
// staff-only investigation material, not conversational.
model CaseComment {
  id              String     @id @default(cuid())
  case            Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId          String
  authorAdmin     AdminUser? @relation(fields: [authorAdminId], references: [id])
  authorAdminId   String?
  authorProfile   Profile?   @relation(fields: [authorProfileId], references: [id])
  authorProfileId String?
  body            String
  visibleToUser   Boolean    @default(true)
  createdAt       DateTime   @default(now())

  @@index([caseId])
}

model CaseInternalNote {
  id        String        @id @default(cuid())
  case      Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  admin     AdminUser     @relation(fields: [adminId], references: [id])
  adminId   String
  body      String
  level     CaseNoteLevel @default(STAFF)
  createdAt DateTime      @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([caseId])
}

// Mirrors VerificationDocument's encrypt-then-blob shape exactly (spec §12) —
// see src/lib/case-evidence-storage.ts.
model CaseEvidence {
  id                     String     @id @default(cuid())
  case                   Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId                 String
  uploadedByAdmin        AdminUser? @relation(fields: [uploadedByAdminId], references: [id])
  uploadedByAdminId      String?
  uploadedByProfile      Profile?   @relation(fields: [uploadedByProfileId], references: [id])
  uploadedByProfileId    String?
  secureStorageReference String
  ivBase64               String
  authTagBase64          String
  mimeType               String
  sizeBytes              Int
  originalFilename       String?
  createdAt              DateTime   @default(now())

  @@index([caseId])
}

model CaseStatusHistory {
  id          String      @id @default(cuid())
  case        Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String
  fromStatus  CaseStatus?
  toStatus    CaseStatus
  // Nullable — a user-driven transition (e.g. responding to an info
  // request) has no admin actor; changedById is set only for admin-driven
  // status changes.
  changedBy   AdminUser?  @relation(fields: [changedById], references: [id])
  changedById String?
  reason      String?
  createdAt   DateTime    @default(now())

  @@index([caseId])
}

model CaseEscalation {
  id            String    @id @default(cuid())
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId        String
  previousLevel Int
  newLevel      Int
  reason        String
  escalatedBy   AdminUser @relation(fields: [escalatedById], references: [id])
  escalatedById String
  createdAt     DateTime  @default(now())

  @@index([caseId])
}

model CaseResolution {
  id               String             @id @default(cuid())
  case             Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId           String             @unique
  category         ResolutionCategory
  summary          String
  actionTaken      String?
  followUpRequired Boolean            @default(false)
  followUpDate     DateTime?
  resolvedBy       AdminUser          @relation(fields: [resolvedById], references: [id])
  resolvedById     String
  createdAt        DateTime           @default(now())
}

model CaseLink {
  id           String       @id @default(cuid())
  case         Case         @relation("CaseLinkSource", fields: [caseId], references: [id], onDelete: Cascade)
  caseId       String
  linkedCase   Case         @relation("CaseLinkTarget", fields: [linkedCaseId], references: [id])
  linkedCaseId String
  linkType     CaseLinkType
  createdBy    AdminUser    @relation(fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime     @default(now())

  @@unique([caseId, linkedCaseId, linkType])
}

// Preserves both cases' full history (spec §28 — "never silently delete the
// original case history"); the source case is closed with mergedIntoCaseId
// set, never deleted.
model CaseMerge {
  id           String    @id @default(cuid())
  sourceCaseId String
  targetCaseId String
  reason       String
  mergedBy     AdminUser @relation(fields: [mergedById], references: [id])
  mergedById   String
  createdAt    DateTime  @default(now())
}

// Thin per-case access trail (evidence/note views, downloads) kept separate
// from the global AuditLog so "who viewed this case" queries don't scan the
// whole audit table — every entry here is also mirrored into AuditLog via
// writeAudit() for the platform-wide trail (spec §12/§33).
model CaseAccessLog {
  id        String    @id @default(cuid())
  case      Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  admin     AdminUser @relation(fields: [adminId], references: [id])
  adminId   String
  action    String
  createdAt DateTime  @default(now())

  @@index([caseId])
}

// Independent, scoped, optionally time-boxed restrictions (spec §18) — NOT a
// replacement for the existing blunt Profile.status=SUSPENDED lifecycle
// (src/lib/verification/status.ts's suspendProfile()), which stays as the
// full-suspension path. endDate is evaluated lazily at check time (see
// src/lib/profile-restrictions.ts) — no cron sweep, matching this codebase's
// existing lazy-expiry convention for OTPs/documents.
model ProfileRestriction {
  id              String          @id @default(cuid())
  profile         Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId       String
  restrictionType RestrictionType
  reason          String
  appliedBy       AdminUser       @relation("RestrictionAppliedBy", fields: [appliedById], references: [id])
  appliedById     String
  startDate       DateTime        @default(now())
  endDate         DateTime?
  active          Boolean         @default(true)
  caseId          String?
  liftedBy        AdminUser?      @relation("RestrictionLiftedBy", fields: [liftedById], references: [id])
  liftedById      String?
  liftedAt        DateTime?
  createdAt       DateTime        @default(now())

  // ---------- STEP 24 — risk-driven restriction metadata (all optional) ----------
  source      String? // "admin_manual" | "risk_case" — how this restriction originated
  riskCaseId  String? // loose pointer to RiskCase.id
  approvalId  String? // loose pointer to the STEP 19 ApprovalRequest.id when a gate was involved
  isPermanent Boolean @default(false) // only ever true after a PERMANENT_RESTRICTION approval; otherwise endDate is required

  @@index([profileId, active])
  @@index([riskCaseId])
}

// Rows keyed by prefix ("SUP","CMP","CASE") — mirrors ProposalCodeCounter's
// single-row-per-key pattern. See src/lib/case-code.ts.
model CaseCodeCounter {
  prefix  String @id
  lastSeq Int    @default(0)
}

// ---------- Support ----------

model SupportMessage {
  id          String   @id @default(cuid())
  profileCode String?
  email       String
  subject     String
  message     String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([resolved])
}

// ---------- Data Privacy, Consent, Account Management & Retention (STEP 13) ----------

// Append-only consent history ledger (spec §3/§4/§5) — never updated or
// deleted; a revocation is a new row with status=REVOKED, not an edit to the
// original grant. Additive to (not a replacement for) ConsentRecord and
// CommunicationConsent/NotificationPreference, which keep enforcing exactly
// what they enforce today — see src/lib/privacy/consent.ts.
model ConsentGrant {
  id         String             @id @default(cuid())
  profile    Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId  String
  category   ConsentCategory
  status     ConsentGrantStatus
  version    String
  source     String // "REGISTRATION" | "CONSENT_CENTER" | "BACKFILL" | ...
  ipHash     String?
  recordedAt DateTime           @default(now())

  // ---------- STEP 23 Add-on — Legal Jurisdiction & Regulatory Compliance ----------
  // All nullable/additive — every existing call site (registration, family
  // invitation acceptance, etc.) keeps working unchanged without passing
  // these; this wires the columns/API, not a retrofit of prior consent
  // history (see the plan's disclosed decision 5).
  jurisdiction           Jurisdiction?          @relation(fields: [jurisdictionId], references: [id])
  jurisdictionId         String?
  purpose                DataProcessingPurpose?
  legalBasis             LegalBasis?            @default(CONSENT)
  privacyNoticeVersion   LegalDocumentVersion?  @relation(fields: [privacyNoticeVersionId], references: [id])
  privacyNoticeVersionId String?
  method                 String? // "CHECKBOX" | "SIGNATURE" | "VERBAL" | ...
  withdrawnAt            DateTime?

  @@index([profileId, category, recordedAt])
}

// LPP-DEL-###### (spec §14/§15).
model AccountDeletionRequest {
  id              String                @id @default(cuid())
  requestCode     String                @unique
  profile         Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId       String
  status          DeletionRequestStatus @default(SUBMITTED)
  mode            DeletionMode?
  reason          String?
  submittedAt     DateTime              @default(now())
  reviewedBy      AdminUser?            @relation(fields: [reviewedById], references: [id])
  reviewedById    String?
  reviewedAt      DateTime?
  scheduledFor    DateTime?
  completedAt     DateTime?
  rejectionReason String?

  @@index([profileId])
  @@index([status])
}

// LPP-PRIV-###### (spec §22) — a thin router: for request types with their
// own dedicated flow (Deletion/Export/Correction/Withdraw-Consent), this row
// tracks status and links to the underlying record rather than duplicating
// its logic. See src/lib/privacy/privacy-request.ts.
model PrivacyRequest {
  id               String               @id @default(cuid())
  requestCode      String               @unique
  profile          Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId        String
  type             PrivacyRequestType
  status           PrivacyRequestStatus @default(SUBMITTED)
  description      String?
  linkedRecordType String?
  linkedRecordId   String?
  handledBy        AdminUser?           @relation(fields: [handledById], references: [id])
  handledById      String?
  resolutionNote   String?
  submittedAt      DateTime             @default(now())
  resolvedAt       DateTime?

  @@index([profileId])
  @@index([status])
}

// Super-Admin configured per category (spec §16) — no hard-coded periods.
model RetentionPolicy {
  id            String          @id @default(cuid())
  category      DataCategory    @unique
  retentionDays Int
  action        RetentionAction
  isActive      Boolean         @default(true)
  updatedBy     AdminUser?      @relation(fields: [updatedById], references: [id])
  updatedById   String?
  updatedAt     DateTime        @updatedAt
}

// Legal/administrative hold (spec §18) — either profile-scoped or targeted
// at a specific record type+id. Lazy-checked by the retention job, no cron
// sweep of its own, mirroring ProfileRestriction's lazy-expiry precedent.
model DataHold {
  id         String     @id @default(cuid())
  profileId  String?
  recordType String?
  recordId   String?
  reason     String
  placedBy   AdminUser  @relation("DataHoldPlacedBy", fields: [placedById], references: [id])
  placedById String
  placedAt   DateTime   @default(now())
  liftedBy   AdminUser? @relation("DataHoldLiftedBy", fields: [liftedById], references: [id])
  liftedById String?
  liftedAt   DateTime?
  active     Boolean    @default(true)

  // ---------- STEP 23 Add-on ----------
  // holdStatus is kept in lockstep with `active` (never a replacement for
  // it — hasActiveHold() and every existing caller keep reading `active`
  // unchanged). RELEASE_PENDING is the new state a maker-checker release
  // request sits in before an approver executes it (see legal-hold.ts).
  holdStatus   DataHoldStatus @default(ACTIVE)
  authority    String? // e.g. "Court Order #123", "Regulator XYZ"
  dataClasses  String? // JSON array of DataClassification values
  scope        String?
  approvedBy   AdminUser?     @relation("DataHoldApprovedBy", fields: [approvedById], references: [id])
  approvedById String?

  @@index([profileId, active])
  @@index([recordType, recordId, active])
}

// One row per record per retention-job outcome (spec §19) — never a
// destructive cross-record transaction; each record's action succeeds or
// fails independently and is logged here regardless.
model RetentionActionLog {
  id         String          @id @default(cuid())
  category   DataCategory
  recordType String
  recordId   String
  action     RetentionAction
  outcome    String // "APPLIED" | "SKIPPED_HOLD" | "SKIPPED_ERROR" | "REVIEW_FLAGGED"
  detail     String?
  runAt      DateTime        @default(now())

  @@index([category, runAt])
}

// "Download My Data" (spec §20/§21) — encrypted like case evidence; the
// "temporary secure download URL" is an HMAC-signed short-lived token (see
// src/lib/privacy/data-export.ts), not a stored, sweep-cleaned token row.
model DataExportRequest {
  id                     String    @id @default(cuid())
  profile                Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId              String
  format                 String // "JSON" | "CSV" | "PDF"
  secureStorageReference String?
  ivBase64               String?
  authTagBase64          String?
  status                 String    @default("PENDING") // PENDING | READY | DOWNLOADED | EXPIRED | FAILED
  expiresAt              DateTime?
  requestedAt            DateTime  @default(now())
  downloadedAt           DateTime?

  @@index([profileId])
}

// Focused, queryable-without-scanning-AuditLog access trail for
// high-sensitivity touchpoints (spec §30) — mirrors STEP 12's CaseAccessLog
// precedent. dataCategory is looked up from the static
// src/lib/privacy/data-classification.ts reference table, not computed by a
// runtime policy engine.
model PrivacyAccessLog {
  id              String                 @id @default(cuid())
  actorAdmin      AdminUser?             @relation(fields: [actorAdminId], references: [id])
  actorAdminId    String?
  actorProfileId  String?
  action          String // "CONTACT_VIEWED" | "EXPORT_DOWNLOADED" | "PHOTO_VIEWED" | ...
  dataCategory    DataClassification
  targetProfileId String?
  reason          String?
  // STEP 23 Add-on §14 — purpose-limitation tagging, derived from the
  // permission the caller already checked (see
  // src/lib/compliance/purpose-mapping.ts). Additive and nullable: this
  // records WHY an access happened, it never gates it (see this model's own
  // header comment in access-log.ts).
  purpose         DataProcessingPurpose?
  createdAt       DateTime               @default(now())

  @@index([targetProfileId, createdAt])
  @@index([actorAdminId, createdAt])
}

// Scoped narrowly to contact-reveal and case/privacy-incident access only
// (spec §31, scope confirmed with user) — not a platform-wide bypass. Fully
// audited, auto-expiring, lazy-checked like ProfileRestriction.
model BreakGlassAccess {
  id         String    @id @default(cuid())
  admin      AdminUser @relation(fields: [adminId], references: [id])
  adminId    String
  reason     String
  recordType String // "CONTACT" | "CASE"
  recordId   String
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?

  @@index([adminId])
  @@index([recordType, recordId])
}

// Makes "Active Sessions"/"Log Out Other Sessions" (spec §10/§32) real
// rather than cosmetic — mirrors AdminSession's shape. The applicant's
// signed cookie embeds this row's id; src/lib/profile-session.ts checks
// revocation on every request, same as AdminSession does for admins today.
model ProfileSession {
  id           String    @id @default(cuid())
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  deviceInfo   String?
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([profileId])
}

// Generic row-per-key counter shared by LPP-DEL-######/LPP-PRIV-###### codes
// (STEP 13) and, from STEP 14 on, LPP-PAY-/LPP-SUB-/LPP-ORD-/LPP-INV-/
// LPP-DISC-/LPP-PKG-/LPP-REF- codes too — mirrors CaseCodeCounter's exact
// shape with a reusable key instead of many near-identical single-purpose
// tables. See src/lib/privacy/codes.ts and src/lib/finance/codes.ts.
model SequenceCounter {
  key     String @id
  lastSeq Int    @default(0)
}

// ---------- Legal Jurisdiction Safeguards & Regulatory Compliance Framework (STEP 23 Add-on) ----------
// Research confirmed ZERO existing concept of jurisdiction, legal basis, or
// policy versioning anywhere in the app before this — STEP 13's consent/
// retention/hold system is real but jurisdiction-blind by design. This block
// is genuinely new; everywhere it touches an existing system it extends that
// system's own models (ConsentGrant/DataHold above) rather than duplicating
// them. See the plan's "Architecture decisions" for the full disclosure.

enum JurisdictionStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

// spec §6 — only ACTIVE rules (with effectiveFrom/To in range) may affect
// production behavior; APPROVED is a distinct, inert intermediate state so a
// rule can be legally signed off ahead of its effective date without going
// live early.
enum ComplianceRuleStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  ACTIVE
  SUSPENDED
  EXPIRED
  RETIRED
}

enum ComplianceSourceType {
  LAW
  REGULATION
  REGULATOR_GUIDANCE
  COURT_DECISION
  CONTRACT
  PROVIDER_REQUIREMENT
  INTERNAL_POLICY
  LEGAL_COUNSEL_ADVICE
}

// spec §13 — never auto-selected; a configured value an admin/legal reviewer
// assigns, not something the system infers.
enum LegalBasis {
  CONSENT
  CONTRACT
  LEGAL_OBLIGATION
  LEGITIMATE_INTEREST
  VITAL_INTEREST
  PUBLIC_TASK
  OTHER_CONFIGURED_BASIS
}

// spec §11 — purpose limitation. Framework + new call sites use this; not a
// retrofit of the ~200 existing profile-data routes in one pass (disclosed).
enum DataProcessingPurpose {
  ACCOUNT_OPERATION
  IDENTITY_VERIFICATION
  SECURITY
  MATCHMAKING
  PROPOSAL_MANAGEMENT
  CONTACT_SHARING
  CUSTOMER_SUPPORT
  PAYMENT_PROCESSING
  LEGAL_COMPLIANCE
  FRAUD_PREVENTION
  SAFETY
  ANALYTICS
  AI_ASSISTANCE
}

enum ComplianceReviewStatus {
  DRAFT
  PENDING_REVIEW
  LEGAL_REVIEW
  COMPLIANCE_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  REVIEW_REQUIRED
}

// spec §19 — never defaults to ALLOWED; UNKNOWN/REVIEW_REQUIRED is the
// conservative return whenever no active rule resolves a transfer.
enum TransferStatus {
  ALLOWED
  ALLOWED_WITH_CONTROLS
  REVIEW_REQUIRED
  BLOCKED
  UNKNOWN
}

enum AuthorityRequestType {
  LAW_ENFORCEMENT
  REGULATOR
  COURT_ORDER
  LEGAL_NOTICE
  OTHER_AUTHORITY
}

enum LegalDocumentType {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
  CONSENT_NOTICE
  VERIFICATION_NOTICE
  COOKIE_NOTICE
  AI_PROCESSING_NOTICE
  FAMILY_SHARING_NOTICE
  PAYMENT_NOTICE
}

// spec §25 — RELEASE_PENDING is new: a hold release now requires a
// maker-checker approval before it actually takes effect (see DataHold above
// and src/lib/compliance/legal-hold.ts) — closing a real, disclosed gap
// where liftHold() was previously a single unilateral admin action.
enum DataHoldStatus {
  ACTIVE
  RELEASE_PENDING
  RELEASED
  EXPIRED
}

// spec §3 — a real table, not a hardcoded list. Deliberately unseeded by
// this migration: an empty jurisdiction table is the conservative, honest
// starting state (spec §37 — unknown jurisdiction must never default to a
// guess).
model Jurisdiction {
  id               String             @id @default(cuid())
  jurisdictionCode String             @unique // e.g. "PK", "US-CA", "EU" — examples only, never assumed
  countryCode      String
  regionCode       String?
  name             String
  status           JurisdictionStatus @default(DRAFT)
  effectiveFrom    DateTime           @default(now())
  effectiveTo      DateTime?
  configuration    String // JSON — e.g. { "minAge": 18 } (spec §16's configurable age policy lives here)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  rules               ComplianceRule[]
  consentGrants       ConsentGrant[]
  legalDocuments      LegalDocumentVersion[]
  transfersAsSource   DataTransferAssessment[] @relation("TransferSourceJurisdiction")
  transfersAsDest     DataTransferAssessment[] @relation("TransferDestJurisdiction")
  processorAgreements ProcessorAgreement[]
  authorityRequests   AuthorityRequest[]

  @@index([status])
  @@index([countryCode])
}

// The actual "law" table (spec §6/§7) — every rule carries its own source
// reference directly (always 1:1, no separate source-reference table).
model ComplianceRule {
  id              String       @id @default(cuid())
  ruleCode        String       @unique // LPP-CRULE-######
  jurisdiction    Jurisdiction @relation(fields: [jurisdictionId], references: [id])
  jurisdictionId  String
  subject         String // dotted scope, e.g. "verification.document.CNIC", "consent.matchmaking"
  requirementType String // free string per spec's own openness — "AGE_MINIMUM" | "RETENTION_PERIOD" | "CONSENT_REQUIRED" | "VERIFICATION_REQUIRED" | "CROSS_BORDER_TRANSFER" | "DISCLOSURE_REQUIREMENT" | ...
  description     String

  sourceType            ComplianceSourceType
  sourceTitle           String?
  sourceAuthority       String?
  sourceReference       String?
  sourceUrl             String?
  sourcePublicationDate DateTime?
  internalReviewNote    String?

  effectiveFrom DateTime
  effectiveTo   DateTime?
  reviewDate    DateTime?

  status        ComplianceRuleStatus @default(DRAFT)
  ruleVersion   Int                  @default(1)
  configuration String // JSON — the actual requirement payload (e.g. { "minAge": 21 })

  createdBy    AdminUser? @relation("ComplianceRuleCreatedBy", fields: [createdById], references: [id])
  createdById  String?
  approvedBy   AdminUser? @relation("ComplianceRuleApprovedBy", fields: [approvedById], references: [id])
  approvedById String?
  approvalDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews           ComplianceReview[]
  transfersGoverned DataTransferAssessment[]

  @@index([jurisdictionId, status])
  @@index([status, effectiveFrom, effectiveTo])
  @@index([requirementType])
}

// spec §8/§24/§39 — reviews a rule, a processor, an authority request, etc.
// Polymorphic subjectType/subjectId string pair, matching this codebase's
// existing loose-reference convention (AdminAssignment.resourceType/Id,
// FamilySharedRecord.recordType/Id) rather than a nullable FK per subject type.
model ComplianceReview {
  id          String                 @id @default(cuid())
  reviewCode  String                 @unique // LPP-CREV-######
  subjectType String // "COMPLIANCE_RULE" | "PROCESSOR" | "TRANSFER_ASSESSMENT" | "AUTHORITY_REQUEST" | ...
  subjectId   String
  status      ComplianceReviewStatus @default(DRAFT)
  reviewType  String? // "PRIVACY_POLICY_REVIEW" | "RETENTION_REVIEW" | "PROVIDER_REVIEW" | ...
  notes       String?
  dueDate     DateTime?
  completedAt DateTime?

  reviewer   AdminUser? @relation("ComplianceReviewReviewer", fields: [reviewerId], references: [id])
  reviewerId String?
  approvalId String? // loose pointer to an ApprovalRequest.id when a STEP 19 gate was involved

  ruleRef   ComplianceRule? @relation(fields: [ruleRefId], references: [id])
  ruleRefId String?

  createdBy   AdminUser? @relation("ComplianceReviewCreatedBy", fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([subjectType, subjectId])
  @@index([status, dueDate])
}

// spec §19 — a real, persisted decision record; assessTransfer() creates one
// row every time, never just a function return. UNKNOWN/REVIEW_REQUIRED is
// the default whenever no ComplianceRule resolves the pair — never ALLOWED.
model DataTransferAssessment {
  id                   String             @id @default(cuid())
  assessmentCode       String             @unique // LPP-XFER-######
  sourceJurisdiction   Jurisdiction?      @relation("TransferSourceJurisdiction", fields: [sourceJurisdictionId], references: [id])
  sourceJurisdictionId String?
  destJurisdiction     Jurisdiction?      @relation("TransferDestJurisdiction", fields: [destJurisdictionId], references: [id])
  destJurisdictionId   String?
  dataClass            DataClassification
  dataType             String
  purpose              String
  provider             String?
  storageLocation      String?
  transferMechanism    String?
  userConsentRequired  Boolean            @default(false)
  userConsentObtained  Boolean            @default(false)
  contractualControls  String?
  governingRule        ComplianceRule?    @relation(fields: [governingRuleId], references: [id])
  governingRuleId      String?
  status               TransferStatus     @default(UNKNOWN)

  assessedBy   AdminUser? @relation(fields: [assessedById], references: [id])
  assessedById String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@index([sourceJurisdictionId, destJurisdictionId])
}

// spec §20/§21 — deliberately NOT auto-populated from PaymentProviderName/
// OtpChannel/AI-provider config; an admin manually records each real
// processor, since auto-generating rows would misrepresent an unreviewed
// technical integration as a reviewed compliance record.
model ComplianceProcessor {
  id                String    @id @default(cuid())
  processorCode     String    @unique // LPP-PROC-######
  name              String
  serviceType       String // "IDENTITY_VERIFICATION" | "EMAIL" | "SMS" | "WHATSAPP" | "PAYMENT" | "CLOUD_STORAGE" | "ANALYTICS" | "AI" | ...
  legalEntity       String?
  country           String
  processingRegions String // JSON array
  dataTypes         String // JSON array
  subprocessors     String? // JSON array
  transferMechanism String?
  contractStatus    String    @default("NOT_RECORDED")
  complianceStatus  String    @default("REVIEW_REQUIRED") // never "COMPLIANT" merely because a certification exists (spec §52) — an explicit reviewer-set value
  lastReviewedAt    DateTime?
  nextReviewDue     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  agreements ProcessorAgreement[]

  @@index([serviceType])
  @@index([complianceStatus])
}

model ProcessorAgreement {
  id                String              @id @default(cuid())
  agreementCode     String              @unique // LPP-AGRMT-######
  processor         ComplianceProcessor @relation(fields: [processorId], references: [id], onDelete: Cascade)
  processorId       String
  agreementType     String // "DPA" | "SCC" | "BAA" | "MSA" | ...
  agreementStatus   String              @default("DRAFT")
  effectiveDate     DateTime?
  expiryDate        DateTime?
  jurisdiction      Jurisdiction?       @relation(fields: [jurisdictionId], references: [id])
  jurisdictionId    String?
  dataCategories    String // JSON array
  subprocessorTerms String?
  securityTerms     String?
  transferTerms     String?
  approvedBy        AdminUser?          @relation(fields: [approvedById], references: [id])
  approvedById      String?
  createdAt         DateTime            @default(now())

  @@index([processorId])
}

// spec §29/§30/§31 — verificationStatus and legalReviewStatus are separate
// fields so a request can never be disclosed against based solely on an
// informal/unverified email. No "emergency bypass" model/field exists at all
// (spec §30 explicitly says not to build a generic one) — a genuine
// emergency is still just a row here with requestType OTHER_AUTHORITY,
// through the same gated review.
model AuthorityRequest {
  id                      String               @id @default(cuid())
  requestCode             String               @unique // LPP-AUTHREQ-######
  requestType             AuthorityRequestType
  authority               String
  jurisdiction            Jurisdiction?        @relation(fields: [jurisdictionId], references: [id])
  jurisdictionId          String?
  receivedAt              DateTime             @default(now())
  requestReference        String?
  scope                   String
  deadline                DateTime?
  verificationStatus      String               @default("UNVERIFIED")
  legalReviewStatus       String               @default("PENDING")
  approvedDisclosureScope String?
  disclosedData           String? // JSON — only ever populated after approval
  disclosureDate          DateTime?

  reviewer   AdminUser? @relation(fields: [reviewerId], references: [id])
  reviewerId String?
  approvalId String? // loose pointer to an ApprovalRequest.id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestType, legalReviewStatus])
  @@index([jurisdictionId])
}

// spec §15 — versioned per document type + jurisdiction; never overwritten
// in place, mirrors VerificationPolicy's (STEP 23) own versioned-row pattern.
// contentReference is a storage/URL pointer, never the full document text.
model LegalDocumentVersion {
  id               String            @id @default(cuid())
  documentType     LegalDocumentType
  version          String
  jurisdiction     Jurisdiction?     @relation(fields: [jurisdictionId], references: [id])
  jurisdictionId   String?
  effectiveDate    DateTime          @default(now())
  retirementDate   DateTime?
  language         String            @default("EN")
  contentReference String
  approvalStatus   String            @default("DRAFT")

  createdBy   AdminUser? @relation(fields: [createdById], references: [id])
  createdById String?
  createdAt   DateTime   @default(now())

  consentGrants ConsentGrant[]

  @@index([documentType, jurisdictionId, language])
}

// ---------- Payment, Subscription, Packages & Financial Management (STEP 14) ----------
// Every amount field is an Int in minor currency units (e.g. paisa/cents) —
// never Float — per spec §4. See src/lib/finance/money.ts for the only place
// arithmetic on these happens.

model Currency {
  code             String  @id // ISO 4217, e.g. "PKR"
  symbol           String
  decimalPrecision Int     @default(2)
  active           Boolean @default(true)
}

// Super-Admin-configured receiving account(s) for the Manual/Bank Transfer
// provider (spec §43) — without at least one active row, ManualPaymentProvider
// has no real destination to show a payer, only a generic placeholder.
// Multiple active rows are all shown so a payer can choose whichever bank
// they can transfer from.
model BankAccount {
  id            String     @id @default(cuid())
  accountTitle  String
  accountNumber String
  bankName      String
  branchName    String?
  iban          String?
  active        Boolean    @default(true)
  displayOrder  Int        @default(0)
  createdBy     AdminUser? @relation(fields: [createdById], references: [id])
  createdById   String?
  createdAt     DateTime   @default(now())

  @@index([active, displayOrder])
}

model Package {
  id                    String                @id @default(cuid())
  packageCode           String                @unique // LPP-PKG-######
  name                  String
  description           String
  billingType           BillingType
  durationDays          Int? // null for ONE_TIME
  active                Boolean               @default(true) // STEP 27 — derived mirror of status === ACTIVE, kept so existing `!pkg.active` guards never change
  displayOrder          Int                   @default(0)
  trialDays             Int                   @default(0)
  // STEP 27 — repeat-trial abuse guard scope (spec §19); default PER_ACCOUNT
  // matches the pre-STEP-27 unconditional-per-subscription behavior most closely.
  trialEligibilityScope TrialEligibilityScope @default(PER_ACCOUNT)
  refundPolicyNote      String?
  // STEP 27 §2/§4 — package type/lifecycle status, additive. `active` above
  // stays in sync (written by the same code path) so nothing else has to change.
  packageType           PackageType           @default(SUBSCRIPTION)
  status                PackageStatus         @default(ACTIVE)
  currentVersion        Int                   @default(1)
  createdBy             AdminUser?            @relation(fields: [createdById], references: [id])
  createdById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  prices        PackagePrice[]
  entitlements  PackageEntitlement[]
  orderItems    OrderItem[]
  subscriptions Subscription[]
  versions      PackageVersion[]
  promotions    PromotionPackage[]

  @@index([active, displayOrder])
  @@index([status])
}

enum PackageType {
  FREE
  ONE_TIME
  SUBSCRIPTION
  TRIAL
  PROMOTIONAL
  CUSTOM
  ENTERPRISE
}

enum PackageStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SCHEDULED
  EXPIRED
  ARCHIVED
}

enum TrialEligibilityScope {
  PER_PACKAGE
  PER_ACCOUNT
}

// STEP 27 §5 — the real "never silently change an active package" mechanism;
// PackagePrice (below) only versions price. One row per activated change to
// a package's feature/limit set, with maker-checker approval for anything
// beyond a pure price change (see APPROVAL_CATALOG's PACKAGE_VERSION_ACTIVATION).
model PackageVersion {
  id               String               @id @default(cuid())
  versionCode      String               @unique // LPP-PKGV-######
  package          Package              @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId        String
  versionNumber    Int
  previousVersion  Int?
  name             String
  description      String
  packageType      PackageType
  priceMinor       Int
  currencyCode     String
  featuresSnapshot Json // denormalized PackageEntitlement rows at the time of this version
  limitsSnapshot   Json
  changeReason     String
  status           PackageVersionStatus @default(DRAFT)
  createdBy        AdminUser?           @relation("PackageVersionCreatedBy", fields: [createdById], references: [id])
  createdById      String?
  approvedBy       AdminUser?           @relation("PackageVersionApprovedBy", fields: [approvedById], references: [id])
  approvedById     String?
  effectiveAt      DateTime?
  createdAt        DateTime             @default(now())

  subscriptions Subscription[]

  @@index([packageId, versionNumber])
}

enum PackageVersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  SUPERSEDED
  REJECTED
}

// Append-only (spec §46) — a price "change" is a new row, never an update to
// an old one. The package's current price is the latest active row ordered
// by effectiveFrom. OrderItem/InvoiceItem copy the charged amount as their
// own field, so a later price change never alters a historical invoice.
model PackagePrice {
  id            String   @id @default(cuid())
  package       Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId     String
  amountMinor   Int
  currencyCode  String
  taxInclusive  Boolean  @default(false)
  effectiveFrom DateTime @default(now())
  active        Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())

  subscriptions Subscription[]

  @@index([packageId, effectiveFrom])
}

// Spec §8 — data, not code branches. featureKey is free text (e.g.
// "matching.priority", "support.priority") so a new feature never requires
// a schema change. limitValue null = unlimited.
model PackageEntitlement {
  id          String   @id @default(cuid())
  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId   String
  featureKey  String
  limitValue  Int?
  resetPeriod String? // "MONTHLY" | "YEARLY" | null (lifetime for the subscription term)
  createdAt   DateTime @default(now())

  @@unique([packageId, featureKey])
}

model Subscription {
  id                     String              @id @default(cuid())
  subscriptionCode       String              @unique // LPP-SUB-######
  profile                Profile             @relation(fields: [profileId], references: [id], onDelete: Restrict)
  profileId              String
  package                Package             @relation(fields: [packageId], references: [id])
  packageId              String
  // STEP 27 §1/§23 — the exact price/version this subscription was created
  // under, so a later package/price change never retroactively alters an
  // existing subscriber's terms. Nullable for backward compat with rows
  // created before STEP 27; entitlement resolution falls back to the live
  // package when null.
  packagePrice           PackagePrice?       @relation(fields: [packagePriceId], references: [id])
  packagePriceId         String?
  packageVersion         PackageVersion?     @relation(fields: [packageVersionId], references: [id])
  packageVersionId       String?
  // STEP 27 §23 — a scheduled (NEXT_CYCLE) package change, applied by the
  // renewal tick rather than immediately.
  pendingPackageId       String?
  provider               PaymentProviderName
  providerSubscriptionId String?
  status                 SubscriptionStatus  @default(PENDING)
  startDate              DateTime?
  endDate                DateTime?
  renewalDate            DateTime?
  autoRenew              Boolean             @default(true)
  trialEndsAt            DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?
  // STEP 27 §22 — audit/notification clarity only, no new state machine.
  cancelInitiatedBy      String? // "USER" | "ADMIN" | "PROVIDER"
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  events SubscriptionEvent[]
  orders Order[]

  @@index([profileId, status])
  @@index([status, renewalDate])
}

// Mirrors STEP 12's CaseStatusHistory precedent exactly.
model SubscriptionEvent {
  id             String              @id @default(cuid())
  subscription   Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus
  reason         String?
  createdAt      DateTime            @default(now())

  @@index([subscriptionId])
}

model Order {
  id             String        @id @default(cuid())
  orderCode      String        @unique // LPP-ORD-######
  profile        Profile       @relation(fields: [profileId], references: [id], onDelete: Restrict)
  profileId      String
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?
  status         OrderStatus   @default(DRAFT)
  currencyCode   String
  subtotalMinor  Int
  discountMinor  Int           @default(0)
  taxMinor       Int           @default(0)
  totalMinor     Int
  couponId       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  completedAt    DateTime?

  items    OrderItem[]
  payments Payment[]
  invoice  Invoice?

  @@index([profileId, status])
}

model OrderItem {
  id               String  @id @default(cuid())
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId          String
  package          Package @relation(fields: [packageId], references: [id])
  packageId        String
  packagePriceId   String? // snapshot reference only, not a live FK dependency for amounts
  packageVersionId String? // STEP 27 §47 — snapshot reference only, same convention as packagePriceId
  description      String
  quantity         Int     @default(1)
  unitPriceMinor   Int
  discountMinor    Int     @default(0)
  taxMinor         Int     @default(0)
  totalMinor       Int

  @@index([orderId])
}

model Payment {
  id                    String              @id @default(cuid())
  paymentCode           String              @unique // LPP-PAY-######
  order                 Order               @relation(fields: [orderId], references: [id])
  orderId               String
  profile               Profile             @relation(fields: [profileId], references: [id], onDelete: Restrict)
  profileId             String
  amountMinor           Int
  currencyCode          String
  method                PaymentMethod
  provider              PaymentProviderName
  providerTransactionId String?
  status                PaymentStatus       @default(CREATED)
  createdAt             DateTime            @default(now())
  paidAt                DateTime?
  failedAt              DateTime?
  refundedAt            DateTime?

  attempts     PaymentAttempt[]
  manualDetail ManualPaymentDetail?
  invoice      Invoice?
  refunds      Refund[]

  @@unique([provider, providerTransactionId])
  @@index([profileId, status])
  @@index([orderId])
  @@index([status, createdAt]) // STEP 15 — health/cron/integrity queries
  @@index([paidAt])
}

// Provider-side retry tracking (spec §27) — never stores raw gateway
// error details, only a safe/sanitized message.
model PaymentAttempt {
  id                       String        @id @default(cuid())
  payment                  Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId                String
  attemptNumber            Int
  status                   PaymentStatus
  providerErrorCode        String?
  providerErrorMessageSafe String?
  createdAt                DateTime      @default(now())

  @@index([paymentId])
}

// 1:1 extension of a Payment with method=MANUAL — mirrors the Case+
// CaseEvidence extension-table pattern rather than a fully parallel
// manual_payments table (spec §43/§44).
model ManualPaymentDetail {
  id                   String              @id @default(cuid())
  payment              Payment             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId            String              @unique
  referenceNumber      String
  evidenceDescription  String?
  // Either the applicant self-submitted (submittedByProfileId) or an admin
  // recorded it on the customer's behalf (enteredById) — never both.
  submittedByProfileId String?
  enteredBy            AdminUser?          @relation("ManualPaymentEnteredBy", fields: [enteredById], references: [id])
  enteredById          String?
  enteredAt            DateTime            @default(now())
  status               ManualPaymentStatus @default(PENDING_VERIFICATION)
  verifiedBy           AdminUser?          @relation("ManualPaymentVerifiedBy", fields: [verifiedById], references: [id])
  verifiedById         String?
  verifiedAt           DateTime?
  rejectionReason      String?
}

// @@unique([provider, providerEventId]) IS the idempotency/replay-prevention
// mechanism (spec §28/§29) — a duplicate webhook delivery fails the unique
// insert and is treated as already-processed. Distinct from STEP 9's
// WebhookEvent (notification-delivery callbacks) — considered reusing it,
// rejected: payment webhooks need amount/currency-verification fields that
// model doesn't have.
model PaymentWebhookEvent {
  id              String              @id @default(cuid())
  provider        PaymentProviderName
  providerEventId String
  eventType       String
  payloadHash     String
  receivedAt      DateTime            @default(now())
  processedAt     DateTime?
  status          String              @default("RECEIVED") // RECEIVED | PROCESSED | FAILED | IGNORED
  retryCount      Int                 @default(0)
  errorCode       String?

  @@unique([provider, providerEventId])
}

// Immutable once finalized (spec §47) — a correction is a new adjustment/
// credit record, never a silent edit to amount/currency/customer/tax here.
model Invoice {
  id               String        @id @default(cuid())
  invoiceCode      String        @unique // LPP-INV-######
  order            Order         @relation(fields: [orderId], references: [id])
  orderId          String        @unique
  profile          Profile       @relation(fields: [profileId], references: [id], onDelete: Restrict)
  profileId        String
  payment          Payment?      @relation(fields: [paymentId], references: [id])
  paymentId        String?       @unique
  subtotalMinor    Int
  discountMinor    Int
  taxMinor         Int
  totalMinor       Int
  currencyCode     String
  paymentStatus    PaymentStatus
  invoiceDate      DateTime      @default(now())
  dueDate          DateTime?
  paidDate         DateTime?
  paymentReference String?
  createdAt        DateTime      @default(now())

  items InvoiceItem[]

  @@index([profileId])
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  description    String
  quantity       Int     @default(1)
  unitPriceMinor Int
  discountMinor  Int     @default(0)
  taxMinor       Int     @default(0)
  totalMinor     Int

  @@index([invoiceId])
}

model Refund {
  id               String              @id @default(cuid())
  refundCode       String              @unique // LPP-REF-######
  payment          Payment             @relation(fields: [paymentId], references: [id])
  paymentId        String
  amountMinor      Int
  currencyCode     String
  type             RefundType
  reason           String
  provider         PaymentProviderName
  providerRefundId String?
  requestedBy      AdminUser           @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  requestedById    String
  approvedBy       AdminUser?          @relation("RefundApprovedBy", fields: [approvedById], references: [id])
  approvedById     String?
  executedBy       AdminUser?          @relation("RefundExecutedBy", fields: [executedById], references: [id])
  executedById     String?
  status           RefundStatus        @default(REQUESTED)
  createdAt        DateTime            @default(now())
  completedAt      DateTime?

  @@index([paymentId])
  @@index([status])
}

// Spec §20/§21 — a Coupon is a Discount that requires a redeemable code;
// discountCode is the internal admin-facing id, code is what a user types.
model Coupon {
  id                          String       @id @default(cuid())
  discountCode                String       @unique // LPP-DISC-######
  code                        String       @unique // e.g. "WELCOME10"
  description                 String?
  discountType                DiscountType
  discountValue               Int // percent (0-100) or fixed minor-unit amount depending on discountType
  minPurchaseMinor            Int?
  maxDiscountMinor            Int?
  startDate                   DateTime?
  endDate                     DateTime?
  usageLimit                  Int?
  perUserLimit                Int?
  applicablePackageIds        Json? // array of Package ids; null = all packages
  active                      Boolean      @default(true)
  // STEP 27 §31 — additive coupon conditions; null/false on any of these
  // means "unrestricted on that axis", matching applicablePackageIds' own
  // convention above. See src/lib/finance/coupon.ts's fail-closed rule: if
  // the column is set but the caller didn't supply the matching input, the
  // coupon is rejected rather than silently treated as unrestricted.
  currencyCode                String?
  allowedCountries            Json? // array of ISO country codes; null = any
  firstTimeUserOnly           Boolean      @default(false)
  allowedSubscriptionTypes    Json? // array of PackageType values; null = any
  campaignKey                 String?
  requiresReferralEligibility Boolean      @default(false)
  // STEP 27 §30 — dispatch target for discountType=FREE_FEATURE (an
  // EntitlementOverride grant, not a checkout price reduction); for
  // FREE_TRIAL/CREDIT, discountValue itself is reinterpreted as trial-days
  // / credit-minor-amount respectively — see src/lib/finance/coupon.ts.
  freeFeatureKey              String?
  createdBy                   AdminUser?   @relation(fields: [createdById], references: [id])
  createdById                 String?
  createdAt                   DateTime     @default(now())

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id                   String                 @id @default(cuid())
  coupon               Coupon                 @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId             String
  profile              Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId            String
  // STEP 27 §34 — nullable so a RESERVED redemption can exist before the
  // Order it will attach to is created (e.g. a provider-hosted checkout
  // redirect flow). REDEEMED rows always have one.
  orderId              String?
  discountAppliedMinor Int
  status               CouponRedemptionStatus @default(REDEEMED)
  reservedAt           DateTime?
  expiresAt            DateTime?
  redeemedAt           DateTime               @default(now())

  @@unique([couponId, orderId])
  @@index([couponId, profileId])
  @@index([couponId, status])
}

// STEP 27 §34 — a reservation and its eventual redemption are the SAME row
// transitioning status, never two rows. resolveCouponForOrder's usage-count
// queries filter to REDEEMED only, so a cancelled/reversed/expired
// redemption never counts toward usageLimit/perUserLimit (closes the
// cancel-and-retry coupon-abuse loophole, spec §33).
enum CouponRedemptionStatus {
  RESERVED
  REDEEMED
  RELEASED
  REVERSED
  EXPIRED
}

// Rate stored in basis points (1/100 of a percent, e.g. 1700 = 17.00%) to
// avoid float precision issues (spec §19).
model TaxRule {
  id                     String     @id @default(cuid())
  name                   String
  ratePercentBasisPoints Int
  country                String
  region                 String?
  applicableService      String? // null = all services
  effectiveDate          DateTime   @default(now())
  expiryDate             DateTime?
  active                 Boolean    @default(true)
  createdBy              AdminUser? @relation(fields: [createdById], references: [id])
  createdById            String?
  createdAt              DateTime   @default(now())

  @@index([country, active])
}

// Atomic usage consumption (spec §40) — see consumeUsage() in
// src/lib/finance/entitlements.ts for the transactional WHERE-guarded update
// that prevents the race condition this table exists to track.
model FeatureUsage {
  id             String   @id @default(cuid())
  profileId      String
  featureKey     String
  subscriptionId String?
  usageCount     Int      @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([profileId, featureKey, periodStart])
}

// =====================================================================
// STEP 27 — Membership, Packages, Feature Entitlements, Coupons, Referral
// & Revenue Growth Management. Extends STEP 14's payment foundation above
// (Package/PackagePrice/PackageEntitlement/Subscription/Coupon/
// CouponRedemption/FeatureUsage/TaxRule) — see the REUSE/EXTEND/NEW ledger
// in the plan for what this deliberately does NOT duplicate.
// =====================================================================

// STEP 27 §6 — admin-configurable feature registry, never an enum, mirrors
// DocumentCategoryConfig/DocumentTypeConfig exactly (src/lib/documents/catalog.ts).
// PackageEntitlement.featureKey stays free-text; src/lib/finance/catalog.ts
// validates writes against this table.
model FeatureDefinition {
  id             String           @id @default(cuid())
  key            String           @unique // e.g. PROFILE_CREATE, MATCHING, AI_ASSISTANCE, DOCUMENT_UPLOAD
  label          String
  description    String?
  category       String? // free-text grouping for the admin UI, e.g. "Matching", "AI"
  usageLimitType FeatureLimitType @default(UNLIMITED)
  active         Boolean          @default(true)
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([active])
}

enum FeatureLimitType {
  UNLIMITED
  PER_DAY
  PER_WEEK
  PER_MONTH
  PER_BILLING_PERIOD
  LIFETIME
  PER_TRANSACTION
}

// STEP 27 §10/§11 — append-only ledger for idempotency/audit/refund,
// alongside (never replacing) FeatureUsage's atomic race-safe counter above.
model FeatureUsageLedger {
  id               String             @id @default(cuid())
  profileId        String
  featureKey       String
  subscriptionId   String?
  action           FeatureUsageAction
  quantity         Int                @default(1)
  requestId        String // caller-supplied idempotency key
  referenceType    String? // loose pointer, e.g. "PROPOSAL" | "AI_QUERY" | "DOCUMENT_UPLOAD"
  referenceId      String?
  reversedLedgerId String?
  createdAt        DateTime           @default(now())

  @@unique([featureKey, requestId])
  @@index([profileId, featureKey, createdAt])
}

enum FeatureUsageAction {
  CONSUMED
  REFUNDED
  ADMIN_RESET
}

// STEP 27 §5/§8/§27 — the one place a real persistent entitlement grant/
// revoke exists, on top of the normal package-derived entitlements.
// expiresAt is deliberately NEVER nullable: "never grant hidden permanent
// entitlements" is structural here, not a convention — a genuinely
// long-lived override is just a far-future, admin-chosen, always-visible date.
model EntitlementOverride {
  id              String                  @id @default(cuid())
  profileId       String
  featureKey      String
  overrideType    EntitlementOverrideType
  limitValue      Int? // used when overrideType = LIMIT_ADJUST
  reason          String
  // Nullable: most overrides are admin-granted, but a few are system-granted
  // (e.g. a referral reward's FEATURE_UNLOCK/DISCOUNT dispatch in
  // src/lib/referrals/referral-service.ts) — those have no real AdminUser
  // actor and must not be forced to fabricate one.
  createdBy       AdminUser?              @relation("EntitlementOverrideCreatedBy", fields: [createdById], references: [id])
  createdById     String?
  createdBySystem Boolean                 @default(false)
  approvedBy      AdminUser?              @relation("EntitlementOverrideApprovedBy", fields: [approvedById], references: [id])
  approvedById    String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime                @default(now())

  @@index([profileId, featureKey, expiresAt])
}

enum EntitlementOverrideType {
  GRANT
  REVOKE
  LIMIT_ADJUST
}

// STEP 27 §28/§29 — service credits; not cash unless explicitly configured
// (spec §28). One running balance per profile per currency.
model MembershipCredit {
  id           String   @id @default(cuid())
  creditCode   String   @unique // LPP-CREDIT-######
  profileId    String
  balanceMinor Int      @default(0)
  currencyCode String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions CreditTransaction[]

  @@unique([profileId, currencyCode])
}

model CreditTransaction {
  id            String                @id @default(cuid())
  credit        MembershipCredit      @relation(fields: [creditId], references: [id], onDelete: Cascade)
  creditId      String
  type          CreditTransactionType
  amountMinor   Int // always positive; `type` determines its effect on balance
  reason        String
  referenceType String? // "ORDER" | "REFERRAL_REWARD" | "PROMOTION" | "ADMIN_ADJUST"
  referenceId   String?
  createdById   String?
  createdAt     DateTime              @default(now())

  @@index([creditId, createdAt])
}

enum CreditTransactionType {
  GRANTED
  USED
  REFUNDED
  EXPIRED
  REVOKED
  ADJUSTED
}

// STEP 27 §35-43 — referral program. Confirmed zero prior art anywhere in
// the codebase before this STEP.
model ReferralProgram {
  id                    String                  @id @default(cuid())
  programCode           String                  @unique // LPP-REFPR-######
  name                  String
  description           String?
  rewardType            ReferralRewardType
  rewardConfig          Json // shape depends on rewardType, e.g. { days: 30 } or { creditMinor: 50000, currencyCode: "PKR" }
  qualifyingEvent       ReferralQualifyingEvent
  qualifyingEventConfig Json?
  maxRewardsPerReferrer Int?
  maxReferralsPerPeriod Int?
  periodDays            Int?
  status                PromotionLikeStatus     @default(DRAFT)
  startDate             DateTime?
  endDate               DateTime?
  createdById           String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  codes     ReferralCode[]
  referrals Referral[]
}

enum ReferralRewardType {
  FREE_DAYS
  CREDIT
  FEATURE_UNLOCK
  DISCOUNT
  COUPON
  POINTS
}

enum ReferralQualifyingEvent {
  REGISTRATION
  FIRST_PAYMENT
  VERIFICATION_COMPLETE
  SUBSCRIPTION_ACTIVE_N_DAYS
}

// Shared DRAFT/SCHEDULED/ACTIVE/PAUSED/ENDED/ARCHIVED lifecycle for
// ReferralProgram and Promotion (spec §44/§35 use the same status shape).
enum PromotionLikeStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

// Per-user referral codes (e.g. LPP-MUNAWAR-7QX2) are NOT sequence-counter
// codes — see src/lib/referrals/referral-service.ts for the unpredictable
// generation (readable slug + crypto-random suffix, spec §35's explicit
// "do not use predictable referral codes").
model ReferralCode {
  id        String          @id @default(cuid())
  code      String          @unique
  program   ReferralProgram @relation(fields: [programId], references: [id])
  programId String
  profileId String // the referrer
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())

  referrals Referral[]

  @@index([profileId])
}

model Referral {
  id                String          @id @default(cuid())
  referralCode      ReferralCode    @relation(fields: [referralCodeId], references: [id])
  referralCodeId    String
  program           ReferralProgram @relation(fields: [programId], references: [id])
  programId         String
  referrerProfileId String
  refereeProfileId  String          @unique // one referral relationship per new account
  status            ReferralStatus  @default(PENDING)
  linkedAt          DateTime?
  qualifiedAt       DateTime?
  rewardedAt        DateTime?
  fraudFlags        Json? // populated by the STEP 24 risk integration; never auto-accusatory in status alone
  createdAt         DateTime        @default(now())

  events  ReferralEvent[]
  rewards ReferralReward[]

  @@index([referrerProfileId])
  @@index([status])
}

enum ReferralStatus {
  PENDING
  LINKED
  QUALIFIED
  REWARDED
  REFERRAL_REVIEW_REQUIRED
  REJECTED
  EXPIRED
}

model ReferralEvent {
  id         String   @id @default(cuid())
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referralId String
  eventType  String // CODE_ENTERED | ELIGIBILITY_CHECKED | LINKED | QUALIFYING_EVENT_MET | FRAUD_CHECK_RUN | REWARD_TRIGGERED
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([referralId])
}

model ReferralReward {
  id                   String               @id @default(cuid())
  referral             Referral             @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referralId           String
  beneficiaryProfileId String // referrer or referee, depending on program config
  rewardType           ReferralRewardType
  rewardConfig         Json
  status               ReferralRewardStatus @default(PENDING)
  grantedAt            DateTime?
  createdAt            DateTime             @default(now())

  transactions ReferralRewardTransaction[]
}

enum ReferralRewardStatus {
  PENDING
  GRANTED
  REVERSED
  EXPIRED
}

model ReferralRewardTransaction {
  id        String         @id @default(cuid())
  reward    ReferralReward @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  rewardId  String
  action    String // GRANTED | REVERSED
  detail    Json?
  createdAt DateTime       @default(now())
}

// STEP 27 §44/§45 — promotions. Server-validated eligibility only
// (src/lib/promotions/eligibility.ts); never a client-trusted flag.
model Promotion {
  id            String              @id @default(cuid())
  promotionCode String              @unique // LPP-PROMO-######
  name          String
  promotionType PromotionType
  config        Json // shape depends on promotionType
  status        PromotionLikeStatus @default(DRAFT)
  startDate     DateTime?
  endDate       DateTime?
  createdById   String?
  approvedById  String? // maker-checker for large promotions (PROMOTION_APPROVAL)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  rules    PromotionRule[]
  packages PromotionPackage[]
}

enum PromotionType {
  PACKAGE_DISCOUNT
  TRIAL_EXTENSION
  CREDIT_GRANT
  FEATURE_UNLOCK
}

model PromotionRule {
  id          String    @id @default(cuid())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId String
  ruleType    String // FIRST_TIME_USER | COUNTRY | CURRENCY | MIN_ACCOUNT_AGE_DAYS | SUBSCRIPTION_TYPE
  ruleConfig  Json
}

model PromotionPackage {
  id          String    @id @default(cuid())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId String
  package     Package   @relation(fields: [packageId], references: [id])
  packageId   String

  @@unique([promotionId, packageId])
}

model ReconciliationRun {
  id               String     @id @default(cuid())
  // Null for a scheduled/cron-triggered run (STEP 14 rollout-phases add-on
  // §77) — every admin-initiated run still has a real actor.
  startedBy        AdminUser? @relation(fields: [startedById], references: [id])
  startedById      String?
  startedAt        DateTime   @default(now())
  completedAt      DateTime?
  totalChecked     Int        @default(0)
  matchedCount     Int        @default(0)
  discrepancyCount Int        @default(0)

  items ReconciliationItem[]
}

model ReconciliationItem {
  id        String                   @id @default(cuid())
  run       ReconciliationRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String
  paymentId String?
  status    ReconciliationItemStatus
  detail    String?
  createdAt DateTime                 @default(now())

  @@index([runId, status])
}

// =====================================================================
// STEP 15 — Production Deployment, DevOps, Monitoring, Backup & Recovery
// All additive. No relations into Steps 1-14 models except plain string
// ids (same convention as Case.relatedPaymentId), so nothing here can
// cascade into or alter existing data.
// =====================================================================

enum OperationalState {
  NORMAL
  DEGRADED
  MAINTENANCE
  RECOVERY
  EMERGENCY
}

enum MaintenanceMode {
  OFF
  ON
  SCHEDULED
}

enum ErrorCategory {
  AUTH_ERROR
  AUTHORIZATION_ERROR
  VALIDATION_ERROR
  DATABASE_ERROR
  STORAGE_ERROR
  PAYMENT_ERROR
  WEBHOOK_ERROR
  NOTIFICATION_ERROR
  MATCHING_ERROR
  PROPOSAL_ERROR
  VERIFICATION_ERROR
  SUPPORT_ERROR
  SECURITY_ERROR
  SYSTEM_ERROR
}

enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ErrorEventStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  RETRYING
  DEAD_LETTER
  CANCELLED
}

enum BackupType {
  DATABASE
  FILES
}

enum BackupStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum BackupTrigger {
  SCHEDULED
  MANUAL
}

enum BackupRetentionClass {
  DAILY
  WEEKLY
  MONTHLY
}

enum RestoreRequestStatus {
  PENDING
  APPROVED
  EXECUTED
  CANCELLED
  REJECTED
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  INVESTIGATING
  MITIGATING
  RESOLVED
  CLOSED
}

enum AlertSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum ReleaseStatus {
  PENDING_APPROVAL
  APPROVED
  DEPLOYING
  HEALTHY
  UNHEALTHY
  FAILED
  ROLLED_BACK
}

// Singleton (id = 1). Operational state, maintenance, emergency switches,
// DR targets, monitoring thresholds, backup policy and admin session length
// — kept apart from AppSettings (already 100+ product-config fields).
model SystemControl {
  id Int @id @default(1)

  operationalState       OperationalState @default(NORMAL)
  operationalStateReason String?

  maintenanceMode     MaintenanceMode @default(OFF)
  maintenanceStartsAt DateTime?
  maintenanceEndsAt   DateTime?
  maintenanceMessage  String?

  // Emergency switches (spec §56)
  emergencyPaymentsDisabled           Boolean @default(false)
  emergencyRegistrationsDisabled      Boolean @default(false)
  emergencyProfileSubmissionsDisabled Boolean @default(false)
  emergencyMatchingDisabled           Boolean @default(false)
  emergencyProposalsDisabled          Boolean @default(false)
  emergencyNotificationsDisabled      Boolean @default(false)
  emergencyUploadsDisabled            Boolean @default(false)
  emergencyPublicAccessDisabled       Boolean @default(false)

  // Disaster-recovery targets (spec §9) — targets, never guarantees
  rpoMinutes Int @default(1440)
  rtoMinutes Int @default(240)

  // Monitoring thresholds (spec §17/§38/§65)
  slowQueryThresholdMs         Int  @default(500)
  apiLatencyWarnMs             Int  @default(2000)
  errorRateWarnPerHour         Int  @default(50)
  failedLoginSpikeThreshold    Int  @default(10)
  paymentFailureSpikeThreshold Int  @default(5)
  webhookFailureSpikeThreshold Int  @default(5)
  queueBacklogThreshold        Int  @default(100)
  permissionViolationThreshold Int  @default(30)
  dbStorageLimitMb             Int?
  fileStorageLimitMb           Int?
  capacityWarnPercent          Int  @default(80)

  // Backup policy (spec §7) — retention is configurable, never hard-coded law
  backupsEnabled            Boolean @default(true)
  backupDailyKeep           Int     @default(7)
  backupWeeklyKeep          Int     @default(4)
  backupMonthlyKeep         Int     @default(6)
  backupStaleAfterHours     Int     @default(48)
  restoreTestStaleAfterDays Int     @default(30)

  monitoringPeriodHours Int @default(24)
  evidenceMaxAgeDays    Int @default(7)
  adminSessionMaxHours  Int @default(12)

  updatedById String?
  updatedAt   DateTime @updatedAt
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(true)
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Centralised, privacy-safe error record (spec §13/§14). message is already
// redacted + truncated by the capture helper; no stack parameters, no PII.
model ErrorEvent {
  id            String           @id @default(cuid())
  fingerprint   String
  category      ErrorCategory
  severity      ErrorSeverity
  service       String // API | FRONTEND | CRON | JOB | WEBHOOK | DATABASE | PROXY
  route         String?
  message       String
  environment   String
  appVersion    String?
  correlationId String?
  status        ErrorEventStatus @default(NEW)
  occurrences   Int              @default(1)
  firstSeenAt   DateTime         @default(now())
  lastSeenAt    DateTime         @default(now())
  resolvedById  String?
  resolvedAt    DateTime?

  @@unique([fingerprint, environment])
  @@index([status, lastSeenAt])
  @@index([category])
  @@index([severity])
  @@index([lastSeenAt])
}

// Aggregated slow-query stats (spec §18). Never stores SQL text or params.
model SlowQueryStat {
  id          String   @id @default(cuid())
  key         String   @unique // `${operation}:${table}:${route|-}`
  operation   String
  tableName   String
  route       String?
  count       Int      @default(1)
  totalMs     Int
  maxMs       Int
  lastMs      Int
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@index([lastSeenAt])
}

// Hourly latency/error buckets per instrumented route (spec §17).
model PerfSample {
  id          String   @id @default(cuid())
  route       String
  bucketStart DateTime
  count       Int      @default(0)
  errorCount  Int      @default(0)
  slowCount   Int      @default(0)
  sumMs       Int      @default(0)
  maxMs       Int      @default(0)

  @@unique([route, bucketStart])
  @@index([bucketStart])
}

// Persistent (cross-instance) rate-limit counter (spec §19).
model RateLimitBucket {
  key             String   @id
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())

  @@index([windowStartedAt])
}

// ---------- STEP 24 — Fraud Prevention, Risk Scoring & Account Safety Intelligence ----------
// Design notes (see the approved STEP 24 plan):
//  - SecurityFlag (above) IS the risk-signal store; these models add the
//    case/assessment/evidence/config layers around it.
//  - Risk records reference profiles/admins by LOOSE string ids (this
//    codebase's polymorphic-reference convention), not cascading FKs: risk
//    evidence must survive profile/admin deletion for retention, legal holds
//    and disputes, and must never be silently removed by a cascade.
//  - Signal ≠ assessment ≠ case ≠ report ≠ verification result ≠ decision:
//    nothing here ever concludes fraud or applies an adverse action by itself.

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskState {
  NOT_ASSESSED
  LOW
  MEDIUM
  HIGH
  CRITICAL
  UNDER_REVIEW
  CLEARED
  RESTRICTED
  SUSPENDED
}

enum RiskConfidence {
  EXACT
  VERY_HIGH
  HIGH
  MEDIUM
  LOW
}

enum RiskSignalCategory {
  IDENTITY
  CONTACT
  ACCOUNT
  DUPLICATE
  DOCUMENT
  LOGIN_SECURITY
  PROFILE_ACTIVITY
  COMMUNICATION
  PROPOSAL_ACTIVITY
  MEETING_ACTIVITY
  PAYMENT
  PRIVACY
  FAMILY_ACCESS
  ADMIN_ACCESS
  DEVICE
  NETWORK
  AUTOMATION
  ABUSE
  SAFETY
}

enum RiskCaseStatus {
  OPEN
  ACKNOWLEDGED
  UNDER_INVESTIGATION
  INFORMATION_REQUESTED
  ESCALATED
  CLEARED
  RESTRICTED
  SUSPENDED
  DISMISSED
  FALSE_POSITIVE
  CLOSED
}

enum RiskReviewDecisionType {
  ACKNOWLEDGE
  INVESTIGATE
  REQUEST_INFORMATION
  REQUEST_REVERIFICATION
  DISMISS
  MARK_FALSE_POSITIVE
  CLEAR
  RESTRICT
  SUSPEND
  ESCALATE
  CLOSE
}

enum RiskEvidenceType {
  VERIFICATION_RESULT
  AUDIT_EVENT
  LOGIN_EVENT
  SECURITY_EVENT
  PROFILE_CHANGE
  CONTACT_CHANGE
  API_EVENT
  PAYMENT_EVENT
  SUPPORT_CASE
  USER_REPORT
  ADMIN_NOTE
  PROVIDER_RESULT
}

enum FalsePositiveReason {
  SHARED_FAMILY_DEVICE
  SHARED_FAMILY_PHONE
  SHARED_HOME_NETWORK
  DATA_ENTRY_ERROR
  PROVIDER_ERROR
  LEGITIMATE_DUPLICATE_CONTEXT
  INCORRECT_SIGNAL
  OTHER
}

enum RiskConfigStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum SecurityEventType {
  ACCOUNT_CREATED
  LOGIN_SUCCESS
  LOGIN_FAILED
  OTP_REQUESTED
  OTP_FAILED
  PASSWORD_RESET
  PROFILE_UPDATED
  CONTACT_UPDATED
  VERIFICATION_STARTED
  VERIFICATION_FAILED
  DOCUMENT_UPLOADED
  PROPOSAL_CREATED
  CONTACT_REQUESTED
  FAMILY_INVITE_CREATED
  FAMILY_ACCESS_REQUESTED
  PAYMENT_FAILED
  ADMIN_SENSITIVE_ACCESS
  API_AUTH_FAILURE
  PERMISSION_DENIED
  CONTACT_BYPASS_ATTEMPT
  NEW_DEVICE_SESSION

  // ---------- STEP 26 — Secure Document Management ----------
  DOCUMENT_UPLOAD_REJECTED // failed validation / repeated failed uploads
  DOCUMENT_SCAN_SUSPICIOUS // security scanner flagged embedded script / polyglot signature
  DOCUMENT_TAMPER_DETECTED // stored hash no longer matches the file's current hash
  DOCUMENT_UNAUTHORIZED_ACCESS // an access/download was attempted without permission
  DOCUMENT_SHARE_ANOMALY // repeated / unusual sharing attempts

  // ---------- STEP 27 — Membership, Subscriptions, Coupons & Referrals ----------
  COUPON_ABUSE_SUSPECTED // reused/expired/manipulated coupon attempt, or repeated validation failures
  REFERRAL_ABUSE_SUSPECTED // self-referral, device reuse, reward-duplication attempt
  ENTITLEMENT_BYPASS_ATTEMPT // frontend claimed access the backend check denied
  UNUSUAL_TRANSACTION_PATTERN // rapid upgrade/downgrade/cancel cycling, proration abuse pattern
}

enum SecurityIncidentControl {
  SESSION_REVOCATION
  SUBJECT_THROTTLE
  IP_BLOCK
  OTP_THROTTLE
  LOGIN_PROTECTION
}

enum SecurityIncidentStatus {
  ACTIVE
  EXPIRED
  LIFTED
}

enum DuplicateClusterStatus {
  UNRESOLVED
  CONFIRMED
  FALSE_POSITIVE
  RESOLVED
  SUPERSEDED
}

enum UserReportType {
  SUSPICIOUS_PROFILE
  INAPPROPRIATE_COMMUNICATION
  IDENTITY_CONCERN
  CONTACT_ABUSE
  HARASSMENT
  IMPERSONATION
  OTHER
}

enum UserReportStatus {
  RECEIVED
  UNDER_REVIEW
  ACTION_TAKEN
  NO_ACTION_NEEDED
  CLOSED
}

// A human-reviewed safety case. Opened by a signal/assessment/user report/
// admin; only a human moves it to a decision state, and every consequential
// action goes through the STEP 19 gate (see src/lib/risk/case-service.ts).
model RiskCase {
  id               String             @id @default(cuid())
  riskCode         String             @unique // LPP-RISK-###### via nextSequenceCode("RISK")
  subjectProfileId String? // loose reference — see the header note
  subjectAdminId   String? // set for ADMIN_SECURITY_REVIEW cases; that admin can never view/act on it
  category         RiskSignalCategory
  title            String
  status           RiskCaseStatus     @default(OPEN)
  riskLevel        RiskLevel
  riskState        RiskState          @default(UNDER_REVIEW)
  reviewRequired   Boolean            @default(true)
  assignedToId     String?
  jurisdictionId   String?
  caseId           String? // loose pointer to a STEP 12 Case (LPP-CASE-######) for safety-report-originated cases
  userReportId     String? // loose pointer to UserReport.id
  openedBy         String // "signal:<id>" | "assessment" | "user_report" | "admin_manual"
  dueAt            DateTime?
  outcome          String?
  closedAt         DateTime?
  closedById       String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  signals     SecurityFlag[]
  assessments RiskAssessment[]
  events      RiskCaseEvent[]
  evidence    RiskEvidence[]
  reviews     RiskReview[]

  @@index([subjectProfileId, status])
  @@index([subjectAdminId])
  @@index([status, riskLevel])
  @@index([category, status])
  @@index([jurisdictionId])
  @@index([createdAt])
}

// Chronological, append-only timeline. A dismissed signal or cleared case
// never deletes history (spec §28).
model RiskCaseEvent {
  id           String   @id @default(cuid())
  riskCase     RiskCase @relation(fields: [riskCaseId], references: [id])
  riskCaseId   String
  eventType    String // CASE_OPENED | SIGNAL_LINKED | ASSESSMENT_RECORDED | REVIEW_ACTION | NOTE | EVIDENCE_ADDED | RESTRICTION_APPLIED | ...
  actorAdminId String?
  summary      String
  payload      String? // JSON, redacted at write time
  createdAt    DateTime @default(now())

  @@index([riskCaseId, createdAt])
}

// Persisted, explainable assessment: "why was this account flagged?" is always
// answerable from this row (top signals, rules triggered, versions).
model RiskAssessment {
  id                   String         @id @default(cuid())
  riskCase             RiskCase?      @relation(fields: [riskCaseId], references: [id])
  riskCaseId           String?
  subjectProfileId     String?
  riskLevel            RiskLevel
  score                Int? // internal 0-100; null when scoring is disabled. NEVER shown to applicants, NEVER a probability of wrongdoing
  topSignals           String // JSON: [{signalId, type, severity, confidence}]
  evidence             String // JSON: evidence reference ids
  rulesTriggered       String // JSON: [{ruleKey, version}]
  ruleVersion          Int // highest rule version used — makes historical evaluations reproducible
  configurationVersion Int
  confidence           RiskConfidence
  cappedBySingleSignal Boolean        @default(false) // the no-single-low-confidence-signal rule lowered the level
  reviewStatus         String         @default("PENDING")
  reviewerId           String?
  decision             String?
  createdAt            DateTime       @default(now())

  @@index([subjectProfileId, createdAt])
  @@index([riskCaseId])
  @@index([riskLevel, createdAt])
}

// Integrity-protected evidence record: contentHash covers source + summary +
// occurredAt + canonical payload, so later tampering is detectable.
model RiskEvidence {
  id             String           @id @default(cuid())
  riskCase       RiskCase?        @relation(fields: [riskCaseId], references: [id])
  riskCaseId     String?
  evidenceType   RiskEvidenceType
  source         String
  summary        String
  payload        String? // JSON, redacted (never raw contact details / documents)
  contentHash    String // sha256 hex
  retentionClass String           @default("RISK_EVIDENCE") // DataCategory.RISK_EVIDENCE
  createdById    String?
  occurredAt     DateTime
  createdAt      DateTime         @default(now())

  @@index([riskCaseId])
  @@index([evidenceType, createdAt])
}

// One review pass on a case (folds the spec's risk_review_decisions table).
model RiskReview {
  id         String                 @id @default(cuid())
  riskCase   RiskCase               @relation(fields: [riskCaseId], references: [id])
  riskCaseId String
  reviewerId String
  decision   RiskReviewDecisionType
  notes      String?
  checklist  String? // JSON — the required review checklist and its completion
  approvalId String? // loose pointer to the STEP 19 ApprovalRequest.id when gated
  createdAt  DateTime               @default(now())

  @@index([riskCaseId, createdAt])
}

// Versioned risk rule configuration — never overwritten in place: a change
// creates version+1 and supersedes the previous row (same pattern as
// VerificationPolicy / ComplianceRule; folds the spec's *_versions tables).
model RiskRule {
  id                String              @id @default(cuid())
  ruleKey           String
  version           Int
  name              String
  category          RiskSignalCategory?
  description       String?
  configuration     String // JSON — thresholds, windows, enable flags
  status            RiskConfigStatus    @default(ACTIVE)
  jurisdictionScope String              @default("GLOBAL") // jurisdiction code or GLOBAL
  effectiveFrom     DateTime            @default(now())
  effectiveTo       DateTime?
  createdById       String?
  createdAt         DateTime            @default(now())

  @@unique([ruleKey, jurisdictionScope, version])
  @@index([ruleKey, status])
}

model RiskFactor {
  id                String               @id @default(cuid())
  factorKey         String
  version           Int
  name              String
  category          RiskSignalCategory
  description       String?
  weight            Int // contribution to the internal 0-100 score
  severity          SecurityFlagSeverity @default(MEDIUM)
  enabled           Boolean              @default(true)
  immediateControl  Boolean              @default(false) // only such a factor may raise the level from a single low-confidence signal
  status            RiskConfigStatus     @default(ACTIVE)
  jurisdictionScope String               @default("GLOBAL")
  effectiveFrom     DateTime             @default(now())
  effectiveTo       DateTime?
  createdById       String?
  createdAt         DateTime             @default(now())

  @@unique([factorKey, jurisdictionScope, version])
  @@index([factorKey, status])
}

// Central security-event ledger (SecurityEventBus). Stores only what rule
// evaluation needs: IP/user-agent are salted hashes, never raw values, and
// payloads are size-capped and redacted.
model SecurityEvent {
  id             String            @id @default(cuid())
  eventType      SecurityEventType
  source         String            @default("app")
  profileId      String?
  adminId        String?
  familyMemberId String?
  subjectKey     String? // salted hash of a pre-auth subject (e.g. a phone/email) for failed-login/OTP events with no session
  ipHash         String?
  userAgentHash  String?
  outcome        String?
  meta           String? // JSON, capped + redacted
  idempotencyKey String?           @unique // replayed events (webhooks, retries) can never double-count
  createdAt      DateTime          @default(now())

  @@index([eventType, createdAt])
  @@index([profileId, eventType, createdAt])
  @@index([adminId, eventType, createdAt])
  @@index([subjectKey, eventType, createdAt])
  @@index([ipHash, eventType, createdAt])
}

// Emergency TECHNICAL controls against an active attack (session revocation,
// temporary throttle, IP-hash block). Always expiring, never a decision about
// the person — the distinction the spec requires (§33) is the model itself.
model SecurityIncident {
  id          String                  @id @default(cuid())
  controlType SecurityIncidentControl
  status      SecurityIncidentStatus  @default(ACTIVE)
  subjectType String // PROFILE | ADMIN | IP_HASH | SUBJECT_KEY
  subjectRef  String
  reason      String
  riskCaseId  String?
  createdById String?
  expiresAt   DateTime
  liftedAt    DateTime?
  liftedById  String?
  createdAt   DateTime                @default(now())

  @@index([status, expiresAt])
  @@index([subjectType, subjectRef, status])
}

// Versioned, configurable rate-limit thresholds (defaults live in code so an
// empty table changes nothing — see src/lib/security/rate-limit-policy.ts).
model RateLimitPolicy {
  id            String           @id @default(cuid())
  policyKey     String
  version       Int
  limit         Int
  windowSeconds Int
  enabled       Boolean          @default(true)
  status        RiskConfigStatus @default(ACTIVE)
  effectiveFrom DateTime         @default(now())
  createdById   String?
  createdAt     DateTime         @default(now())

  @@unique([policyKey, version])
  @@index([policyKey, status])
}

// A cluster is a connected component over open duplicate candidates and
// duplicate-type relationships. fingerprint = sha256(sorted member ids), so a
// rebuild is idempotent. "CONFIRMED" is only ever a human-reviewed state.
model DuplicateCluster {
  id             String                  @id @default(cuid())
  fingerprint    String                  @unique
  status         DuplicateClusterStatus  @default(UNRESOLVED)
  confidenceBand DuplicateConfidenceBand
  memberCount    Int
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  members DuplicateClusterMember[]

  @@index([status])
}

model DuplicateClusterMember {
  id        String           @id @default(cuid())
  cluster   DuplicateCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  clusterId String
  profileId String // loose reference
  addedAt   DateTime         @default(now())

  @@unique([clusterId, profileId])
  @@index([profileId])
}

// A structured allegation from an applicant — an allegation, never proof.
// Wraps a STEP 12 Case (SAFETY_REPORT) so it flows through existing case
// management, and raises a deduped risk signal for human review.
model UserReport {
  id                String           @id @default(cuid())
  reportCode        String           @unique // LPP-REPORT-###### via nextSequenceCode("REPORT")
  reportType        UserReportType
  reporterProfileId String
  reportedProfileId String?
  description       String
  status            UserReportStatus @default(RECEIVED)
  caseId            String? // loose pointer to the STEP 12 Case
  riskCaseId        String? // loose pointer to the RiskCase, when one was opened
  resolutionNote    String? // neutral, reporter-visible
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([reporterProfileId, createdAt])
  @@index([reportedProfileId, createdAt])
  @@index([status])
}

model BackgroundJob {
  id            String    @id @default(cuid())
  type          String
  status        JobStatus @default(PENDING)
  dedupKey      String?   @unique
  payload       Json? // safe metadata only — never PII/secrets
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  runAfter      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  lockedUntil   DateTime?
  failureReason String?
  correlationId String?
  resolved      Boolean   @default(false)
  resolvedById  String?
  createdById   String?

  @@index([status, runAfter])
  @@index([type, status])
}

// One row per named scheduled task: lock (prevents duplicate execution) +
// last-run summary (spec §31).
model CronTask {
  name                String    @id
  lockedUntil         DateTime?
  lastStartedAt       DateTime?
  lastCompletedAt     DateTime?
  lastStatus          String? // SUCCESS | FAILED
  lastDurationMs      Int?
  consecutiveFailures Int       @default(0)
  totalFailures       Int       @default(0)
  schedule            String?
  updatedAt           DateTime  @updatedAt
}

model CronTaskRun {
  id            String    @id @default(cuid())
  taskName      String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationMs    Int?
  status        String // SUCCESS | FAILED | SKIPPED_LOCKED
  error         String?
  correlationId String?

  @@index([taskName, startedAt])
}

model BackupRun {
  id                 String               @id @default(cuid())
  backupCode         String               @unique // LPP-BKP-######
  type               BackupType
  trigger            BackupTrigger
  status             BackupStatus         @default(RUNNING)
  retentionClass     BackupRetentionClass @default(DAILY)
  startedAt          DateTime             @default(now())
  completedAt        DateTime?
  sizeBytes          Int?
  checksumSha256     String?
  manifest           Json? // per-table row counts / file counts
  storageUrl         String? // ciphertext object only
  encrypted          Boolean              @default(true)
  separateStore      Boolean              @default(false)
  expiresAt          DateTime?
  triggeredById      String?
  failureReason      String?
  verifiedAt         DateTime?
  verificationStatus String? // PASSED | FAILED
  prunedAt           DateTime?

  restoreTests    RestoreTest[]
  restoreRequests RestoreRequest[]

  @@index([type, status, startedAt])
}

// Incremental mirror of encrypted blob objects (photos/documents/evidence).
model BackupFileCopy {
  id        String   @id @default(cuid())
  sourceUrl String   @unique
  backupUrl String
  sha256    String
  sizeBytes Int
  kind      String // PHOTO | DOCUMENT | EVIDENCE
  copiedAt  DateTime @default(now())
}

model RestoreTest {
  id            String    @id @default(cuid())
  backup        BackupRun @relation(fields: [backupId], references: [id])
  backupId      String
  mode          String // VERIFY_ONLY
  status        String // RUNNING | PASSED | FAILED
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  result        Json?
  performedById String?

  @@index([backupId])
  @@index([startedAt])
}

// Authorization record for a real restore — executing it is done outside the
// app (scripts/restore-backup.ts); nothing in the app overwrites live data.
model RestoreRequest {
  id            String               @id @default(cuid())
  backup        BackupRun            @relation(fields: [backupId], references: [id])
  backupId      String
  status        RestoreRequestStatus @default(PENDING)
  reason        String
  targetLabel   String
  requestedById String
  approvedById  String?
  requestedAt   DateTime             @default(now())
  decidedAt     DateTime?
  executedAt    DateTime?
  notes         String?

  @@index([status])
}

model Alert {
  id             String        @id @default(cuid())
  alertCode      String        @unique // LPP-ALT-######
  category       String // rule key, e.g. ERROR_RATE
  severity       AlertSeverity
  source         String
  service        String
  title          String
  detail         String? // safe text only
  status         AlertStatus   @default(NEW)
  dedupKey       String
  occurrences    Int           @default(1)
  firstSeenAt    DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  assignedToId   String?
  resolution     String?
  resolvedAt     DateTime?
  incidentCaseId String? // plain id of the Case opened for this alert
  createdAt      DateTime      @default(now())

  events AlertEvent[]

  @@index([status, severity])
  @@index([dedupKey])
}

model AlertEvent {
  id         String       @id @default(cuid())
  alert      Alert        @relation(fields: [alertId], references: [id], onDelete: Cascade)
  alertId    String
  actorId    String?
  fromStatus AlertStatus?
  toStatus   AlertStatus?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([alertId])
}

model IntegrityCheckRun {
  id            String    @id @default(cuid())
  trigger       String // SCHEDULED | MANUAL | POST_RESTORE
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  status        String // RUNNING | CLEAN | FINDINGS | FAILED
  totalChecks   Int       @default(0)
  findingCount  Int       @default(0)
  findings      Json?
  triggeredById String?

  @@index([startedAt])
}

model Release {
  id                 String        @id @default(cuid())
  releaseCode        String        @unique // LPP-REL-######
  version            String
  commitSha          String
  environment        String
  status             ReleaseStatus @default(DEPLOYING)
  deployedBy         String?
  deployedAt         DateTime      @default(now())
  notes              String?
  migrations         Json? // applied migration names at deploy time
  featureFlags       Json?
  paymentEnvironment String?
  testResults        Json?
  smokeResult        String?
  rollbackTargetId   String? // previous stable Release id
  monitoringUntil    DateTime?
  approvedById       String?
  approvedAt         DateTime?
  verifiedAt         DateTime?
  verificationResult Json?

  @@unique([commitSha, environment])
  @@index([environment, deployedAt])
}

// Evidence posted by CI / deploy-gate workflows (spec §22/§49/§68). The
// readiness evaluator never marks a gate PASS without fresh evidence.
model CiEvidence {
  id          String   @id @default(cuid())
  kind        String // BUILD | TYPECHECK | LINT | TESTS | SECURITY_SCAN | DEPENDENCY_AUDIT | MIGRATION_VALIDATION | SMOKE | SECURITY_SMOKE
  status      String // PASS | FAIL
  commitSha   String
  environment String?
  summary     Json?
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
}

// =====================================================================
// STEP 16 — AI-assisted matchmaking & admin assistant (additive only).
// AI recommends and explains; humans decide. None of these tables feeds the
// deterministic matcher, payments, verification or any profile field.
// Rows carry ids and metadata only — no contact details, no free-text PII.
// =====================================================================

enum AiProviderKind {
  RULES // built-in deterministic provider — no data leaves the system
  ANTHROPIC // external LLM adapter — off unless key + explicit config + per-profile consent
  DISABLED
}

enum AiFeature {
  PROFILE_SUMMARY
  MATCH_EXPLANATION
  COMPARE
  PROPOSAL_ASSISTANT
  COMMUNICATION_ASSISTANT
  FOLLOWUP_ASSISTANT
  COPILOT
  REPORT_ASSISTANT
  DATA_QUALITY
  PROFILE_IMPROVEMENT
  // STEP 23 Add-on — read-only; summarizes configured compliance rules/
  // jurisdictions, cannot write to any compliance table (spec §35).
  COMPLIANCE_SUMMARY
  // STEP 24 — read-only summary of a RiskCase; never concludes guilt, never
  // decides an adverse action (see src/lib/ai/safety.ts ADVERSE_DECISION).
  RISK_CASE_SUMMARY
}

enum AiRequestStatus {
  SUCCESS
  FAILED
  BLOCKED_SAFETY
  CONSENT_REQUIRED
  DENIED
  RATE_LIMITED
  QUOTA_EXCEEDED
  DISABLED
  FALLBACK
}

enum AiRolloutPhase {
  DISABLED
  INTERNAL_TEST
  STAFF_PILOT
  LIMITED_PRODUCTION
  PRODUCTION
}

enum AiStorageMode {
  DO_NOT_STORE
  SUMMARY_ONLY
  FULL_RESULT
  LIMITED_PERIOD
}

// Singleton configuration (id = 1). Provider secrets are NEVER stored here —
// the external adapter reads its key from the environment only.
model AiConfig {
  id Int @id @default(1)

  phase            AiRolloutPhase @default(DISABLED)
  killSwitchActive Boolean        @default(false)
  killSwitchReason String?
  killSwitchAt     DateTime?

  provider                AiProviderKind @default(RULES)
  externalProviderAllowed Boolean        @default(false)
  model                   String         @default("lpp-rules-v1")
  temperature             Float          @default(0.2)
  maxOutputTokens         Int            @default(1200)
  timeoutMs               Int            @default(15000)
  retryCount              Int            @default(1)

  dailyRequestCap   Int   @default(500)
  monthlyRequestCap Int   @default(10000)
  rateLimits        Json? // { "<feature>": { "limit": n, "windowSec": n }, roles: { "STAFF": { ... } } }

  storageModes    Json? // { "<feature>": AiStorageMode }
  retentionDays   Int   @default(30)
  cacheTtlMinutes Int   @default(60)

  pilotAdminIds         String[] // STAFF_PILOT / LIMITED_PRODUCTION allowlist
  priceInputPerMTokUsd  Float? // only used to ESTIMATE cost when the provider reports token usage
  priceOutputPerMTokUsd Float?

  updatedById String?
  updatedAt   DateTime @updatedAt
}

// Activation history for the code-defined prompt templates (spec §65/§66).
// Templates live in src/lib/ai/prompts; this records which version was
// activated, when, by whom, and the passing test run that allowed it.
model AiPromptVersion {
  id            String    @id @default(cuid())
  promptId      String // e.g. LPP-AI-PROFILE-SUMMARY
  version       String // e.g. v1.0
  feature       AiFeature
  checksum      String
  active        Boolean   @default(false)
  testRunId     String?
  activatedById String?
  createdAt     DateTime  @default(now())

  @@unique([promptId, version])
  @@index([feature, active])
}

model AiRequest {
  id                    String          @id @default(cuid())
  actorAdminId          String
  actorRole             String
  feature               AiFeature
  status                AiRequestStatus
  provider              AiProviderKind
  model                 String
  promptVersion         String
  aiVersion             String
  appVersion            String?
  matchAlgorithmVersion String?
  latencyMs             Int?
  inputTokens           Int?
  outputTokens          Int?
  estimatedCostUsd      Float?
  costIsEstimate        Boolean         @default(false)
  correlationId         String?
  consentOutcome        String?
  errorCode             String?
  fromCache             Boolean         @default(false)
  profileIds            String[]
  createdAt             DateTime        @default(now())

  result AiResult?

  @@index([createdAt])
  @@index([actorAdminId, feature, createdAt])
  @@index([status, createdAt])
  @@index([profileIds], type: Gin)
}

model AiResult {
  id          String        @id @default(cuid())
  request     AiRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId   String        @unique
  feature     AiFeature
  profileIds  String[]
  structured  Json?
  storageMode AiStorageMode
  expiresAt   DateTime?
  cacheKey    String?
  createdAt   DateTime      @default(now())

  @@index([expiresAt])
  @@index([cacheKey])
  @@index([profileIds], type: Gin)
}

// Metadata only: which rule fired and what was done. The offending text is
// never stored.
model AiSafetyEvent {
  id           String     @id @default(cuid())
  requestId    String?
  actorAdminId String?
  feature      AiFeature?
  rule         String
  action       String // BLOCKED | REWRITTEN | DENIED
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@index([rule, createdAt])
}

model AiConfigHistory {
  id           String   @id @default(cuid())
  actorAdminId String?
  kind         String // CONFIG | ROLLOUT | KILL_SWITCH | PROMPT | MODEL
  before       Json?
  after        Json?
  reason       String?
  createdAt    DateTime @default(now())

  @@index([kind, createdAt])
}

model AiTestRun {
  id             String         @id @default(cuid())
  suite          String // safety | privacy | security | reliability | analysis | all
  testVersion    String
  provider       AiProviderKind
  model          String
  promptVersions Json?
  passed         Int
  failed         Int
  status         String // PASS | FAIL
  failures       Json?
  triggeredById  String?
  commitSha      String?
  createdAt      DateTime       @default(now())

  @@index([suite, createdAt])
}

// ---------- Approval Governance (STEP 19) ----------
// Maker-checker / four-eyes / multi-level approval for high-risk admin
// actions. See src/lib/approvals/ (catalog, policy-engine, conflict, engine,
// gate, events) for the logic consuming these. actionType is a validated
// string (not a hard Postgres enum) so Super Admin governance configuration
// (spec §9) can enable/disable and reconfigure per action type without a
// schema migration — see src/lib/approvals/catalog.ts for the known-action
// registry. No existing STEP 1-18 model, enum, or function is modified by
// this section; a small number of existing routes call into
// src/lib/approvals/gate.ts as an additive pre-execution check (see those
// files' own STEP 19 comments).

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  PENDING_APPROVAL
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  EXPIRED
  CANCELLED
  EXECUTION_PENDING
  EXECUTING
  EXECUTED
  EXECUTION_FAILED
  REOPENED
  ARCHIVED
}

enum ApprovalRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// LEVEL_0 = no approval required; LEVEL_5 = multi-party/quorum (see
// ApprovalPolicy.minimumApprovers/quorum for the actual "N of M").
enum ApprovalLevel {
  LEVEL_0
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
  LEVEL_5
}

enum ApprovalReviewerDecision {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  RECUSED
}

enum ApprovalStepStatus {
  PENDING
  IN_PROGRESS
  SATISFIED
  FAILED
  SKIPPED
}

enum ApprovalExecutionStatus {
  NOT_STARTED
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

// spec §29 — detected by src/lib/approvals/conflict.ts before any decision
// is recorded; SELF_APPROVAL is the unconditional, always-checked-first case.
enum ApprovalConflictType {
  SELF_APPROVAL
  ASSIGNED_STAFF_CONFLICT
  FINANCIAL_REQUESTER_CONFLICT
  VERIFICATION_MAKER_CONFLICT
  ROLE_POLICY_CONFLICT
  OTHER
}

enum ApprovalDelegationStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model ApprovalRequest {
  id           String @id @default(cuid())
  approvalCode String @unique // LPP-APR-###### via src/lib/privacy/codes.ts

  actionType String // validated against src/lib/approvals/catalog.ts, not a DB enum (spec §9)
  sourceType AssignmentResourceType
  sourceId   String

  maker   AdminUser @relation("ApprovalMaker", fields: [makerId], references: [id])
  makerId String

  status    ApprovalStatus     @default(DRAFT)
  riskLevel ApprovalRiskLevel
  priority  AssignmentPriority @default(NORMAL)
  reason    String

  // Before/after snapshot for the Approval Detail page (spec §20) — never
  // the sole authorization source; execution always re-derives from the
  // live source record via src/lib/approvals/gate.ts.
  currentStatePayload Json?
  requestedPayload    Json?

  requiredLevel ApprovalLevel
  currentLevel  ApprovalLevel @default(LEVEL_0)

  assignedChecker      AdminUser?  @relation("ApprovalAssignedChecker", fields: [assignedCheckerId], references: [id])
  assignedCheckerId    String?
  assignedDepartment   Department? @relation(fields: [assignedDepartmentId], references: [id])
  assignedDepartmentId String?

  requestedAt DateTime  @default(now())
  expiresAt   DateTime?
  completedAt DateTime?
  rejectedAt  DateTime?
  cancelledAt DateTime?

  createdTask   AdminTask? @relation(fields: [createdTaskId], references: [id])
  createdTaskId String?    @unique

  executionStatus ApprovalExecutionStatus @default(NOT_STARTED)
  // Dedup key for submit-twice / execute-twice protection (spec §36) —
  // e.g. `${actionType}:${sourceType}:${sourceId}:${makerId}` for most
  // actions; emergency overrides use a fresh uuid per use instead.
  idempotencyKey  String                  @unique

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps         ApprovalStep[]
  reviewers     ApprovalReviewer[]
  events        ApprovalEvent[]
  executionLogs ApprovalExecutionLog[]
  conflicts     ApprovalConflict[]

  @@index([status])
  @@index([actionType])
  @@index([sourceType, sourceId])
  @@index([makerId])
  @@index([expiresAt])
  @@index([assignedDepartmentId])
}

model ApprovalStep {
  id                String             @id @default(cuid())
  approvalRequest   ApprovalRequest    @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approvalRequestId String
  level             ApprovalLevel
  sequence          Int // execution order for sequential multi-level chains (e.g. Manager then Super Admin)
  requiredRoles     AdminRole[] // eligible reviewer roles for this step (empty = any policy-allowed role)
  requiredCount     Int                @default(1) // "M" — how many distinct eligible reviewers may decide
  quorumCount       Int                @default(1) // "N" — how many APPROVED decisions satisfy this step
  status            ApprovalStepStatus @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  reviewers ApprovalReviewer[]

  @@unique([approvalRequestId, sequence])
}

// Reviewers are recorded lazily as eligible admins actually decide (see
// plan architecture decision 3 — Level 2+ pools are eligibility-based, not a
// pre-assigned roster). @@unique([stepId, reviewerId]) makes a duplicate
// decision by the same reviewer an update, never a second counted vote.
model ApprovalReviewer {
  id                String                   @id @default(cuid())
  approvalRequest   ApprovalRequest          @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approvalRequestId String
  step              ApprovalStep             @relation(fields: [stepId], references: [id], onDelete: Cascade)
  stepId            String
  reviewer          AdminUser                @relation(fields: [reviewerId], references: [id])
  reviewerId        String
  roleAtDecision    AdminRole?
  decision          ApprovalReviewerDecision @default(PENDING)
  decisionReason    String?
  decidedAt         DateTime?
  createdAt         DateTime                 @default(now())

  @@unique([stepId, reviewerId])
  @@index([approvalRequestId])
}

// Super Admin-configurable governance rule per action type (spec §9) — the
// row read by src/lib/approvals/policy-engine.ts's getApprovalPolicy().
model ApprovalPolicy {
  id         String @id @default(cuid())
  actionType String @unique

  enabled       Boolean           @default(true)
  riskLevel     ApprovalRiskLevel
  requiredLevel ApprovalLevel

  minimumApprovers Int @default(1)
  quorum           Int @default(1)

  allowedRoles         AdminRole[]
  allowedDepartmentIds String[]    @default([])

  makerCheckerRequired Boolean @default(true)
  reauthRequired       Boolean @default(false)
  twoFactorRequired    Boolean @default(false)
  expirationMinutes    Int     @default(4320) // 3 days

  emergencyOverrideAllowed Boolean @default(false)

  createdBy   AdminUser? @relation("ApprovalPolicyCreator", fields: [createdById], references: [id])
  createdById String?
  updatedBy   AdminUser? @relation("ApprovalPolicyUpdater", fields: [updatedById], references: [id])
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Currency-aware, admin-configurable financial approval tiers (spec §10) —
// never hardcoded; amounts are integer minor units matching
// src/lib/finance/money.ts's convention (no floating-point money).
model ApprovalAmountThreshold {
  id               String        @id @default(cuid())
  actionType       String
  currencyCode     String
  minAmountMinor   Int
  maxAmountMinor   Int? // null = no upper bound
  requiredLevel    ApprovalLevel
  minimumApprovers Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([actionType, currencyCode])
}

// Time-limited decision-making delegation (spec §27) — scoped to eligibility
// only; never grants the delegate new Permission strings or a role (see
// plan architecture decision 10).
model ApprovalDelegation {
  id                 String                   @id @default(cuid())
  delegator          AdminUser                @relation("ApprovalDelegator", fields: [delegatorId], references: [id])
  delegatorId        String
  delegate           AdminUser                @relation("ApprovalDelegate", fields: [delegateId], references: [id])
  delegateId         String
  allowedActionTypes String[]                 @default([]) // empty = all action types the delegator could decide on
  startAt            DateTime
  endAt              DateTime
  reason             String
  status             ApprovalDelegationStatus @default(ACTIVE)
  createdBy          AdminUser                @relation("ApprovalDelegationCreator", fields: [createdById], references: [id])
  createdById        String
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([delegatorId, status])
  @@index([delegateId, status])
}

model ApprovalExecutionLog {
  id                String                  @id @default(cuid())
  approvalRequest   ApprovalRequest         @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approvalRequestId String
  executionStatus   ApprovalExecutionStatus
  executedBy        AdminUser?              @relation(fields: [executedById], references: [id])
  executedById      String?
  startedAt         DateTime                @default(now())
  completedAt       DateTime?
  errorCode         String?
  errorMessage      String?

  @@index([approvalRequestId])
}

// Conflict-of-interest block (spec §29) — created whenever
// src/lib/approvals/conflict.ts denies a decision attempt; the actor sees
// only a neutral message, this row keeps the real reason for audit.
model ApprovalConflict {
  id                String               @id @default(cuid())
  approvalRequest   ApprovalRequest      @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approvalRequestId String
  actor             AdminUser            @relation(fields: [actorId], references: [id])
  actorId           String
  conflictType      ApprovalConflictType
  detectedAt        DateTime             @default(now())
  resolution        String?

  @@index([approvalRequestId])
}

// Fast, purpose-built per-request timeline (plan architecture decision 5) —
// written together with the central AuditLog by
// src/lib/approvals/events.ts's recordApprovalEvent(), never on its own.
model ApprovalEvent {
  id                String          @id @default(cuid())
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  approvalRequestId String
  actor             AdminUser?      @relation(fields: [actorId], references: [id])
  actorId           String?
  eventType         String // mirrors the AuditAction Approval Governance block
  metadata          Json?
  createdAt         DateTime        @default(now())

  @@index([approvalRequestId, createdAt])
}

// ---------- Candidate Discovery & Matchmaking Workspace (STEP 20) ----------
// See src/lib/search/ (fields, filter-builder, candidate-search, audit) for
// the logic consuming these. No existing STEP 1-19 model, enum, or function
// is replaced by this section — src/lib/serializers.ts's toListDto/
// toDetailDto and src/lib/matching.ts's scoreMatch() gain small, additive
// enhancements (see those files' own STEP 20 comments); everything else here
// is new.

enum SavedSearchVisibility {
  PRIVATE
  TEAM
  DEPARTMENT
  ORGANIZATION
}

enum ShortlistStatus {
  DRAFT
  REVIEWING
  READY_FOR_PROPOSAL
  ARCHIVED
}

// Spec §19/§20 — a named, reusable filter configuration. filterJson stores a
// validated FilterGroup (src/lib/search/filter-builder.ts) — never raw SQL,
// never re-trusted without re-validation on read.
model SavedSearch {
  id           String                @id @default(cuid())
  searchCode   String                @unique // LPP-SRCH-###### via src/lib/privacy/codes.ts
  owner        AdminUser             @relation(fields: [ownerId], references: [id])
  ownerId      String
  name         String
  description  String?
  filterJson   Json
  visibility   SavedSearchVisibility @default(PRIVATE)
  department   Department?           @relation(fields: [departmentId], references: [id])
  departmentId String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([ownerId])
  @@index([visibility])
}

// Spec §21 — "Recent Searches" source. filterSummary is a compact, non-
// sensitive JSON summary (e.g. {"city":"Lahore","verifiedOnly":true}) — a
// sensitive-flagged search additionally gets a CandidateSearchAudit row
// (below); this table alone is never the sensitive-compliance record.
model SearchHistory {
  id              String    @id @default(cuid())
  actor           AdminUser @relation(fields: [actorId], references: [id])
  actorId         String
  searchType      String // "criteria" | "mutual" | "nl" | "profile_id"
  sourceProfile   Profile?  @relation(fields: [sourceProfileId], references: [id])
  sourceProfileId String?
  filterSummary   Json
  resultCount     Int
  createdAt       DateTime  @default(now())

  @@index([actorId, createdAt])
}

// Spec §28 — LPP-SHORT-######. Never auto-creates a proposal (spec §28's own
// explicit rule) — a shortlist is purely a staging area.
model Shortlist {
  id              String          @id @default(cuid())
  shortlistCode   String          @unique // LPP-SHORT-###### via src/lib/privacy/codes.ts
  owner           AdminUser       @relation(fields: [ownerId], references: [id])
  ownerId         String
  sourceProfile   Profile?        @relation(fields: [sourceProfileId], references: [id])
  sourceProfileId String?
  name            String
  description     String?
  status          ShortlistStatus @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items ShortlistItem[]

  @@index([ownerId])
  @@index([sourceProfileId])
}

// @@unique([shortlistId, profileId]) is the spec §45 duplicate-add
// protection — adding an already-present candidate is a no-op, not a second row.
model ShortlistItem {
  id          String    @id @default(cuid())
  shortlist   Shortlist @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  shortlistId String
  profile     Profile   @relation(fields: [profileId], references: [id])
  profileId   String
  position    Int       @default(0)
  adminNote   String?
  addedBy     AdminUser @relation(fields: [addedById], references: [id])
  addedById   String
  createdAt   DateTime  @default(now())

  @@unique([shortlistId, profileId])
  @@index([shortlistId])
}

// Spec §39 — a dedicated compliance trail for sensitive-filter usage, kept
// separate from SearchHistory's general UX purpose. sensitiveFiltersUsed
// records WHICH sensitive categories were filtered on (e.g. ["income"]),
// never the raw threshold value (spec §38's explicit example).
model CandidateSearchAudit {
  id                   String    @id @default(cuid())
  actor                AdminUser @relation(fields: [actorId], references: [id])
  actorId              String
  searchType           String
  sourceProfile        Profile?  @relation(fields: [sourceProfileId], references: [id])
  sourceProfileId      String?
  sensitiveFiltersUsed String[]  @default([])
  resultCount          Int
  reason               String?
  createdAt            DateTime  @default(now())

  @@index([actorId, createdAt])
}

// ================================================================
// Family/Guardian Portal, Delegated Access & Multi-User Family
// Account System (STEP 22)
// ================================================================
// A genuinely new, third authenticated actor type — family
// members/guardians invited by an applicant, with explicit, scoped,
// consent-based, revocable, time-bounded access. Parallel to (never
// sharing) the applicant's ProfileSession/lpp_session machinery — see
// src/lib/family/family-session.ts. Additive alongside, and does not
// replace, STEP 21's admin-mediated FamilyCommunication outreach log,
// which stays exactly as-is.

enum FamilyRole {
  FAMILY_VIEWER
  FAMILY_ADVISOR
  FAMILY_COORDINATOR
  FAMILY_GUARDIAN
  FAMILY_APPROVER
  FAMILY_ADMIN // manages the family's OWN members only — never a platform admin permission
}

enum FamilyMemberStatus {
  PENDING // invited, not yet accepted
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum FamilyInvitationStatus {
  DRAFT
  SENT
  DELIVERED
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
  SUSPENDED
}

// VIEW|COMMENT|SUGGEST|RESPOND|MANAGE|APPROVE (spec §8). OWNER is
// deliberately not a value here — reserved for the primary applicant,
// never stored as a FamilyMember's access level.
enum FamilyAccessLevel {
  VIEW
  COMMENT
  SUGGEST
  RESPOND
  MANAGE
  APPROVE
}

enum FamilyAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum FamilyPermissionStatus {
  ACTIVE
  PENDING_APPROVAL // STEP 19 gate — a sensitive permission awaiting admin approval
  EXPIRED
  REVOKED
  REJECTED
}

enum FamilyConsentType {
  FAMILY_INVITATION
  PROFILE_ACCESS
  PROPOSAL_SHARING
  CONTACT_INFORMATION
  FAMILY_COMMENTS
  RESPONSE_PARTICIPATION
  MEETING_COORDINATION
  FAMILY_COMMUNICATIONS
}

enum FamilyConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
}

enum FamilyAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED_FOR_ADMIN_APPROVAL // sensitive permission — routed to STEP 19
  CANCELLED
}

enum FamilySharedRecordType {
  PROPOSAL
  MEETING
}

// SUMMARY|STANDARD|DETAILED|RESPONSE_PARTICIPATION — spec §20.
enum ProposalSharingLevel {
  SUMMARY
  STANDARD
  DETAILED
  RESPONSE_PARTICIPATION
}

enum FamilySharedRecordStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

// A family member's SUGGESTED response — never binding until the
// applicant confirms it (Decision 8) — kept structurally distinct
// from the real ProposalResponse/ProposalResponseType.
enum FamilyDecisionValue {
  INTERESTED
  NOT_INTERESTED
  NEED_MORE_INFO
}

enum FamilyDecisionStatus {
  NOT_REQUESTED
  PENDING_FAMILY_REVIEW
  FAMILY_INTERESTED
  FAMILY_NOT_INTERESTED
  MORE_INFO_REQUESTED
  APPLICANT_CONFIRMATION_REQUIRED
  CONFIRMED
  CANCELLED
}

enum FamilyCommentType {
  PROPOSAL_COMMENT
  PROFILE_SUGGESTION
  MEETING_COMMENT
  GENERAL_FAMILY_NOTE
}

// Broader than FamilySharedRecordType (a comment can target the
// profile itself, e.g. PROFILE_SUGGESTION, not just a shared record).
enum FamilyCommentTargetType {
  PROPOSAL
  MEETING
  PROFILE
}

enum FamilyCommentVisibility {
  APPLICANT_ONLY
  FAMILY_SHARED
  ADMIN_SHARED
}

// One per applicant, created lazily on the first invitation — most
// applicants never use this feature (Decision 3).
model FamilyAccount {
  id          String              @id @default(cuid())
  familyCode  String              @unique // LPP-FAM-###### — see nextSequenceCode("FAM")
  applicant   Profile             @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId String              @unique
  status      FamilyAccountStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  groups      FamilyGroup[]
  members     FamilyMember[]
  invitations FamilyInvitation[]

  @@index([applicantId])
}

// Optional labeling/grouping of members (spec §33). Deliberately
// carries NO permission-inheritance logic in this pass (Decision 3) —
// every access check resolves at the individual FamilyMember/
// FamilyPermission level regardless of group membership.
model FamilyGroup {
  id              String        @id @default(cuid())
  groupCode       String        @unique // LPP-FAMGRP-######
  familyAccount   FamilyAccount @relation(fields: [familyAccountId], references: [id], onDelete: Cascade)
  familyAccountId String
  name            String
  createdAt       DateTime      @default(now())

  members FamilyMember[]

  @@index([familyAccountId])
}

// The family member's own authenticated account — password-based
// (Decision 2), entirely separate from the applicant's passwordless
// ProfileSession. Never carries any AdminRole/Permission.
model FamilyMember {
  id              String             @id @default(cuid())
  familyAccount   FamilyAccount      @relation(fields: [familyAccountId], references: [id], onDelete: Cascade)
  familyAccountId String
  group           FamilyGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId         String?
  fullName        String
  relationship    String // "Parent" | "Guardian" | "Sibling" | "Relative" | "Other" — free text, not assumed from name
  email           String?
  mobile          String?
  emailVerified   Boolean            @default(false)
  mobileVerified  Boolean            @default(false)
  passwordHash    String
  role            FamilyRole         @default(FAMILY_VIEWER)
  status          FamilyMemberStatus @default(PENDING)
  invitedAt       DateTime           @default(now())
  joinedAt        DateTime?
  lastLoginAt     DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  removedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  sessions       FamilyMemberSession[]
  permissions    FamilyPermission[]
  consentsGiven  FamilyConsent[]
  accessRequests FamilyAccessRequest[]
  sharedRecords  FamilySharedRecord[]
  decisions      FamilyDecision[]
  comments       FamilyComment[]
  auditEvents    AuditLog[]
  notifications  Notification[]

  @@index([familyAccountId])
  @@index([email])
  @@index([status])
}

// Mirrors ProfileSession's exact shape (src/lib/profile-session.ts) —
// a parallel, not shared, revocation/tracking row (Decision 2).
model FamilyMemberSession {
  id             String       @id @default(cuid())
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  familyMemberId String
  deviceInfo     String?
  userAgent      String?
  ipAddress      String?
  createdAt      DateTime     @default(now())
  lastActiveAt   DateTime     @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  @@index([familyMemberId])
}

// tokenHash follows the OTP module's exact pattern (bcrypt-hashed,
// never stored/returned raw after issuance) — never the stateless
// step-up-token HMAC scheme, which has no one-time-use enforcement.
model FamilyInvitation {
  id              String                 @id @default(cuid())
  invitationCode  String                 @unique // LPP-FAM-######
  familyAccount   FamilyAccount          @relation(fields: [familyAccountId], references: [id], onDelete: Cascade)
  familyAccountId String
  invitedName     String
  invitedEmail    String?
  invitedMobile   String?
  relationship    String
  requestedRole   FamilyRole             @default(FAMILY_VIEWER)
  tokenHash       String
  status          FamilyInvitationStatus @default(SENT)
  expiresAt       DateTime
  createdAt       DateTime               @default(now())
  acceptedAt      DateTime?
  revokedAt       DateTime?
  familyMemberId  String? // set once accepted — links to the resulting account

  @@index([familyAccountId])
  @@index([status])
}

// Dotted scope-strings (profile.basic.view, proposal.respond, ...) —
// never a monolithic role-implies-everything model (Decision 4).
model FamilyPermission {
  id                 String                 @id @default(cuid())
  familyMember       FamilyMember           @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  familyMemberId     String
  permission         String // e.g. "proposal.view" — see src/lib/family/permissions.ts's catalog
  scope              String? // e.g. a specific proposalCode, or null for "all shared records of this type"
  status             FamilyPermissionStatus @default(ACTIVE)
  grantedByProfileId String? // the applicant, when self-granted (soft reference, no FK — see FamilySharedRecord.recordId comment)
  grantedByAdminId   String? // set only when a sensitive grant was STEP-19-approved
  grantedAt          DateTime               @default(now())
  expiresAt          DateTime?
  revokedAt          DateTime?

  @@unique([familyMemberId, permission, scope])
  @@index([familyMemberId])
  @@index([status])
}

// Grantor (applicant) -> grantee (family member) consent ledger —
// genuinely new plumbing; ConsentGrant is single-subject only ("I
// consent to processing about myself"), with no grantor/grantee pair.
model FamilyConsent {
  id             String              @id @default(cuid())
  familyMember   FamilyMember        @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  familyMemberId String
  applicant      Profile             @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId    String
  consentType    FamilyConsentType
  scope          String?
  version        String              @default("1.0")
  status         FamilyConsentStatus @default(GRANTED)
  grantedAt      DateTime            @default(now())
  revokedAt      DateTime?
  expiresAt      DateTime?

  @@index([familyMemberId, consentType])
  @@index([applicantId])
}

// Family member requests additional permission -> applicant reviews
// -> approve/reject, escalating to STEP 19 for sensitive scopes.
model FamilyAccessRequest {
  id                  String                    @id @default(cuid())
  requestCode         String                    @unique // LPP-FAMREQ-######
  familyMember        FamilyMember              @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  familyMemberId      String
  applicantId         String
  requestedPermission String
  reason              String?
  status              FamilyAccessRequestStatus @default(PENDING)
  reviewedAt          DateTime?
  createdAt           DateTime                  @default(now())

  @@index([familyMemberId])
  @@index([applicantId, status])
}

// The specific-instance sharing decision (Decision 7) — a
// FamilyPermission("proposal.view") is a capability; this is the
// instance ("this exact proposal, at this level, until this date").
// recordId has no enforced FK, mirroring AdminAssignment's existing
// resourceType/resourceId polymorphic-reference convention.
model FamilySharedRecord {
  id                String                   @id @default(cuid())
  familyMember      FamilyMember             @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  familyMemberId    String
  recordType        FamilySharedRecordType
  recordId          String
  accessLevel       ProposalSharingLevel     @default(SUMMARY)
  allowComments     Boolean                  @default(false)
  allowResponse     Boolean                  @default(false)
  sharedByProfileId String
  sharedAt          DateTime                 @default(now())
  expiresAt         DateTime?
  status            FamilySharedRecordStatus @default(ACTIVE)

  @@unique([familyMemberId, recordType, recordId])
  @@index([familyMemberId, status])
}

// A family member's non-binding SUGGESTED proposal response — never
// written to ProposalResponse directly (Decision 8).
model FamilyDecision {
  id             String               @id @default(cuid())
  decisionCode   String               @unique // LPP-FAMDEC-######
  proposal       Proposal             @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposalId     String
  familyMember   FamilyMember         @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  familyMemberId String
  decision       FamilyDecisionValue
  comment        String?
  status         FamilyDecisionStatus @default(PENDING_FAMILY_REVIEW)
  createdAt      DateTime             @default(now())
  confirmedAt    DateTime?
  cancelledAt    DateTime?

  @@index([proposalId])
  @@index([familyMemberId])
}

// Family comments (spec §23) — polymorphic target, same
// resourceType/resourceId convention as AdminAssignment (no enforced FK).
model FamilyComment {
  id             String                  @id @default(cuid())
  familyMember   FamilyMember            @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  familyMemberId String
  commentType    FamilyCommentType
  targetType     FamilyCommentTargetType
  targetId       String
  body           String
  visibility     FamilyCommentVisibility @default(APPLICANT_ONLY)
  createdAt      DateTime                @default(now())

  @@index([familyMemberId])
  @@index([targetType, targetId])
}

// ---------- STEP 25 — Communication, WhatsApp, SMS, Email Automation & Conversation Management ----------
// Design notes (see the approved STEP 25 plan):
//  - CommunicationLog (above) IS the message record, the queue entry and the dead-letter record. A QUEUED row with
//    nextAttemptAt is a job; a FAILED row with deadLetteredAt set is a dead letter. WebhookEvent is the webhook ledger.
//  - Provider SECRETS are never stored: CommunicationProvider only keeps the NAMES of the environment variables that hold them.
//  - Threads are controlled, admin-mediated conversations. There is deliberately NO applicant-to-applicant thread type.

enum CommunicationMessageType {
  TRANSACTIONAL
  SECURITY
  VERIFICATION
  PROPOSAL
  MATCHING
  MEETING
  SUPPORT
  FAMILY
  PAYMENT
  PRIVACY
  SYSTEM
  ADMIN_INTERNAL
  MARKETING
}

enum CommunicationPurpose {
  ACCOUNT
  OTP
  VERIFICATION
  PROFILE
  MATCH
  PROPOSAL
  CONTACT_PERMISSION
  MEETING
  FOLLOWUP
  SUPPORT
  PAYMENT
  PRIVACY
  SECURITY
  FAMILY_ACCESS
  MARKETING
  ADMIN_INTERNAL
}

enum CommunicationRecipientType {
  PROFILE
  FAMILY_MEMBER
  ADMIN
}

enum CommunicationEnvironment {
  DEVELOPMENT
  STAGING
  SANDBOX
  PRODUCTION
}

enum CommunicationFailureClass {
  RETRYABLE
  PERMANENT
  POLICY_BLOCKED
}

enum CommunicationTemplateStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  ACTIVE
  DISABLED
  ARCHIVED
}

enum CommunicationSuppressionReason {
  USER_REQUEST
  BOUNCE
  COMPLAINT
  UNSUBSCRIBED
  SECURITY_RESTRICTION
  ADMIN_RESTRICTION
  JURISDICTION_RULE
  PROVIDER_BLOCK
  TEMPORARY_LIMIT
}

enum CommunicationSuppressionStatus {
  ACTIVE
  LIFTED
  EXPIRED
}

enum CommunicationPolicyKind {
  FREQUENCY
  QUIET_HOURS
  JURISDICTION_DEFAULTS
  FOLLOWUP_RULE
  ENVIRONMENT
}

enum CommunicationThreadType {
  SUPPORT_THREAD
  PROPOSAL_COORDINATION
  MEETING_COORDINATION
  FAMILY_COORDINATION
  VERIFICATION_THREAD
  INTERNAL_ADMIN_THREAD
}

enum CommunicationThreadStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum CommunicationVisibility {
  PUBLIC_TO_USER
  INTERNAL_ONLY
  STAFF_SHARED
  MANAGER_ONLY
}

enum CommunicationCampaignStatus {
  DRAFT
  REVIEW
  APPROVED
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum CommunicationCampaignRecipientStatus {
  PENDING
  QUEUED
  SENT
  SKIPPED
  FAILED
}

// Non-secret provider configuration + health. `secretRefs` is a JSON array of environment-variable NAMES.
model CommunicationProvider {
  id                  String                   @id @default(cuid())
  providerKey         String                   @unique // e.g. smtp-email, twilio-sms, meta-whatsapp, sandbox-sms
  name                String
  channel             NotificationChannel
  adapter             String // EMAIL_SMTP | SMS_TWILIO | WHATSAPP_META | SANDBOX | INAPP
  environment         CommunicationEnvironment @default(PRODUCTION)
  active              Boolean                  @default(false)
  priority            Int                      @default(100) // lower = tried first; later rows are failover candidates
  senderIdentity      String? // display sender / from-number / phone-number-id label (not a secret)
  supportedCountries  String                   @default("[]") // JSON array of country names; empty = any
  supportedLanguages  String                   @default("[]") // JSON array of EN | UR; empty = any
  rateLimitPerMinute  Int                      @default(60)
  retryMaxAttempts    Int                      @default(4)
  retryBaseSeconds    Int                      @default(60)
  secretRefs          String                   @default("[]")
  processorId         String? // loose pointer to ComplianceProcessor.id (STEP 23) for provider eligibility
  failoverAllowed     Boolean                  @default(false) // may sensitive traffic fail over TO this provider
  healthStatus        String                   @default("UNKNOWN") // HEALTHY | DEGRADED | DOWN | UNKNOWN
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastError           String?
  consecutiveFailures Int                      @default(0)
  lastWebhookAt       DateTime?
  updatedById         String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([channel, active])
}

// Admin-authored template. Never edited in place once ACTIVE: a change creates a CommunicationTemplateVersion.
model CommunicationTemplate {
  id                   String                      @id @default(cuid())
  templateCode         String                      @unique // LPP-CTPL-######
  name                 String
  channel              NotificationChannel
  messageType          CommunicationMessageType
  purpose              CommunicationPurpose
  language             Locale
  eventKey             String? // NotificationType this template overrides for system notifications, when bound
  subject              String?
  body                 String
  variables            String                      @default("[]") // JSON: allow-listed variable names this template uses
  status               CommunicationTemplateStatus @default(DRAFT)
  currentVersion       Int                         @default(1)
  activeVersion        Int?
  providerTemplateName String? // WhatsApp / SMS provider-side template
  providerTemplateId   String?
  providerCategory     String?
  providerStatus       String? // DRAFT | SUBMITTED | APPROVED | REJECTED | ACTIVE | DISABLED
  providerSyncedAt     DateTime?
  createdById          String?
  approvedById         String?
  approvalId           String? // loose pointer to the STEP 19 ApprovalRequest.id
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  versions CommunicationTemplateVersion[]

  @@index([channel, language, status])
  @@index([eventKey, channel, language, status])
  @@index([messageType, status])
}

model CommunicationTemplateVersion {
  id              String                      @id @default(cuid())
  template        CommunicationTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId      String
  version         Int
  previousVersion Int?
  subject         String?
  body            String
  variables       String                      @default("[]")
  status          CommunicationTemplateStatus @default(DRAFT)
  changeReason    String
  changedById     String?
  approvalId      String?
  effectiveAt     DateTime?
  createdAt       DateTime                    @default(now())

  @@unique([templateId, version])
}

// Every change is audited; a suppression is never silently removed (lifting records who and why).
model CommunicationSuppression {
  id              String                         @id @default(cuid())
  profileId       String? // loose reference, survives profile deletion for compliance
  familyMemberId  String?
  channel         NotificationChannel
  destinationHash String? // salted hash of an external address (never the address itself)
  scope           String                         @default("ALL") // ALL | MARKETING | TRANSACTIONAL
  reason          CommunicationSuppressionReason
  status          CommunicationSuppressionStatus @default(ACTIVE)
  expiresAt       DateTime?
  note            String?
  createdById     String?
  liftedById      String?
  liftedAt        DateTime?
  liftReason      String?
  createdAt       DateTime                       @default(now())

  @@index([profileId, channel, status])
  @@index([destinationHash, channel, status])
  @@index([status, expiresAt])
}

// Versioned communication configuration (same pattern as RiskRule / ComplianceRule): a change is a new row.
model CommunicationPolicy {
  id                String                  @id @default(cuid())
  kind              CommunicationPolicyKind
  policyKey         String // "default", or a follow-up rule key
  version           Int
  configuration     String // JSON
  status            RiskConfigStatus        @default(ACTIVE)
  jurisdictionScope String                  @default("GLOBAL")
  effectiveFrom     DateTime                @default(now())
  createdById       String?
  createdAt         DateTime                @default(now())

  @@unique([kind, policyKey, jurisdictionScope, version])
  @@index([kind, status])
}

// Status timeline of one message. Rows are only written from a real provider answer or webhook - never inferred.
model CommunicationDeliveryEvent {
  id              String           @id @default(cuid())
  log             CommunicationLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  logId           String
  provider        String?
  eventType       String // QUEUED | SENDING | SENT | DELIVERED | READ | FAILED | BOUNCED | REJECTED | CANCELLED | EXPIRED | BLOCKED
  providerEventId String?
  source          String           @default("SYSTEM") // SYSTEM | WEBHOOK | ADMIN
  detail          String?
  occurredAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())

  @@index([logId, occurredAt])
  @@index([eventType, createdAt])
}

// Controlled, admin-mediated conversation attached to an authorised record. No applicant-to-applicant threads exist.
model CommunicationThread {
  id           String                    @id @default(cuid())
  threadCode   String                    @unique // LPP-THR-######
  type         CommunicationThreadType
  subject      String
  status       CommunicationThreadStatus @default(OPEN)
  resourceType String? // PROPOSAL | CASE | MEETING | PROFILE | VERIFICATION | RISK_CASE | TASK | PAYMENT | PRIVACY_REQUEST
  resourceId   String?
  profileId    String? // the applicant this thread concerns (loose reference)
  createdById  String?
  closedAt     DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  members  CommunicationThreadMember[]
  messages CommunicationThreadMessage[]

  @@index([resourceType, resourceId])
  @@index([profileId, status])
  @@index([type, status])
}

model CommunicationThreadMember {
  id             String              @id @default(cuid())
  thread         CommunicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId       String
  memberType     String // PROFILE | FAMILY_MEMBER | ADMIN
  profileId      String?
  familyMemberId String?
  adminId        String?
  canReply       Boolean             @default(true)
  addedById      String?
  createdAt      DateTime            @default(now())

  @@index([threadId])
  @@index([profileId])
  @@index([familyMemberId])
  @@index([adminId])
}

model CommunicationThreadMessage {
  id            String                  @id @default(cuid())
  thread        CommunicationThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId      String
  authorType    String // ADMIN | PROFILE | FAMILY_MEMBER | SYSTEM
  authorId      String?
  visibility    CommunicationVisibility @default(INTERNAL_ONLY)
  body          String // AES-256-GCM ciphertext (see src/lib/communications/crypto.ts)
  bodyEncrypted Boolean                 @default(true)
  createdAt     DateTime                @default(now())

  @@index([threadId, createdAt])
  @@index([visibility])
}

model CommunicationCampaign {
  id                  String                      @id @default(cuid())
  campaignCode        String                      @unique // LPP-CAMP-######
  name                String
  purpose             CommunicationPurpose
  messageType         CommunicationMessageType
  channel             NotificationChannel
  templateId          String
  audienceFilter      String // JSON of allow-listed filters (never SQL)
  status              CommunicationCampaignStatus @default(DRAFT)
  scheduledAt         DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  pausedAt            DateTime?
  cancelledAt         DateTime?
  estimatedRecipients Int?
  eligibleCount       Int                         @default(0)
  queuedCount         Int                         @default(0)
  sentCount           Int                         @default(0)
  skippedCount        Int                         @default(0)
  failedCount         Int                         @default(0)
  createdById         String?
  approvedById        String?
  approvalId          String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  recipients CommunicationCampaignRecipient[]

  @@index([status])
  @@index([createdAt])
}

model CommunicationCampaignRecipient {
  id         String                               @id @default(cuid())
  campaign   CommunicationCampaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  profileId  String // loose reference
  status     CommunicationCampaignRecipientStatus @default(PENDING)
  skipReason String?
  logId      String?
  createdAt  DateTime                             @default(now())

  @@unique([campaignId, profileId])
  @@index([campaignId, status])
}

// ============================================================================
// STEP 26 — Secure Document Management, Verification, E-Signature & Document
// Lifecycle. A genuinely new, general-purpose document store for categories
// that had no home (education/employment/income/family/address/legal/
// agreement/consent/support/administrative/...). It does NOT replace or
// migrate VerificationDocument/ProfileVerification (STEP 8/23's identity
// checklist flow) or CaseEvidence (STEP 24) — those keep working unchanged.
// Storage pattern mirrors document-storage.ts exactly (Vercel Blob +
// application-layer AES-256-GCM; the raw blob URL never reaches the client).
// Legal holds reuse the existing DataHold model (recordType "Document");
// retention reuses RetentionActionLog; review/expiry work reuses AdminTask;
// gated actions reuse ApprovalRequest (STEP 19); family grants reuse
// FamilySharedRecord (type DOCUMENT, added above).
// ============================================================================

enum DocumentClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  HIGHLY_SENSITIVE
  RESTRICTED
}

enum DocumentOwnerType {
  PROFILE
  FAMILY_MEMBER
  PROPOSAL
  SUPPORT_CASE
  RISK_CASE
  PRIVACY_REQUEST
  ADMIN
  SYSTEM
}

enum DocumentStatus {
  UPLOADING
  UPLOADED
  SCANNING
  AVAILABLE
  UNDER_REVIEW
  VERIFIED
  PARTIALLY_VERIFIED
  REJECTED
  EXPIRED
  REVERIFICATION_REQUIRED
  RESTRICTED
  QUARANTINED
  ARCHIVED
  DELETED
}

enum DocumentUploaderType {
  PROFILE
  FAMILY_MEMBER
  ADMIN
  SYSTEM
}

enum DocumentScanStatus {
  PENDING
  SCANNING
  CLEAN
  INFECTED
  SUSPICIOUS
  SCAN_FAILED
  QUARANTINED
}

enum DocumentQuarantineDecision {
  PENDING
  RELEASED
  DESTROYED
}

enum DocumentShareRecipientType {
  FAMILY_MEMBER
  ADMIN
  PROFILE
}

enum DocumentShareScope {
  VIEW
  DOWNLOAD
}

enum DocumentShareStatus {
  REQUESTED
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  EXPIRED
  REVOKED
  REJECTED
}

enum DocumentRequestStatus {
  DRAFT
  SENT
  VIEWED
  UPLOADED
  UNDER_REVIEW
  COMPLETED
  EXPIRED
  CANCELLED
}

enum DocumentSignatureStatus {
  DRAFT
  SENT
  VIEWED
  PARTIALLY_SIGNED
  SIGNED
  DECLINED
  EXPIRED
  VOIDED
  FAILED
}

enum DocumentSignatureRecipientStatus {
  PENDING
  SENT
  VIEWED
  SIGNED
  DECLINED
}

enum DocumentAccessAction {
  VIEW
  PREVIEW
  DOWNLOAD
  SHARE
  VERIFY
  REJECT
  APPROVE
  REDACT
  EXPORT
  DELETE
  RESTORE
}

// Admin-editable catalog (spec §2/§3) — never a Prisma enum, so a new category
// or document type never needs a migration. Document.categoryKey/typeKey are
// validated against these at write time (src/lib/documents/catalog.ts).
model DocumentCategoryConfig {
  id                    String                 @id @default(cuid())
  key                   String                 @unique // e.g. IDENTITY, EDUCATION, LEGAL, SUPPORT
  label                 String
  active                Boolean                @default(true)
  defaultClassification DocumentClassification @default(RESTRICTED)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  types DocumentTypeConfig[]

  @@index([active])
}

model DocumentTypeConfig {
  id                    String                 @id @default(cuid())
  key                   String                 @unique // e.g. PASSPORT, NATIONAL_ID, DEGREE, CONSENT_FORM
  label                 String
  category              DocumentCategoryConfig @relation(fields: [categoryKey], references: [key])
  categoryKey           String
  defaultClassification DocumentClassification @default(RESTRICTED)
  requiresExpiry        Boolean                @default(false)
  acceptedMimeTypes     String                 @default("[]") // JSON array; empty = the global default allow-list
  active                Boolean                @default(true)
  // Never treat any type as universally mandatory here — that decision belongs to the
  // feature that requests it (e.g. the STEP 8/23 verification checklist), not this catalog.
  createdById           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  documents Document[]

  @@index([categoryKey, active])
}

model Document {
  id           String @id @default(cuid())
  documentCode String @unique // public identifier, LPP-DOC-######, distinct from `id`

  ownerType DocumentOwnerType
  ownerId   String // loose pointer — the record this document belongs to
  profileId String? // convenience loose reference for filtering/queries when the owner resolves to an applicant; not a hard FK

  type        DocumentTypeConfig @relation(fields: [typeKey], references: [key])
  typeKey     String
  categoryKey String

  classification DocumentClassification @default(RESTRICTED)
  status         DocumentStatus         @default(UPLOADING)

  // ---------- current version (mirrors the latest DocumentVersion row) ----------
  currentVersion         Int    @default(1)
  secureStorageReference String // Vercel Blob key — never sent to the client
  ivBase64               String
  authTagBase64          String
  mimeType               String
  originalFilename       String // sanitized display name only, see safeFilename()
  sizeBytes              Int
  fileHash               String // SHA-256 of the plaintext bytes — tamper detection + duplicate detection

  uploaderType DocumentUploaderType
  uploaderId   String

  // ---------- verification (spec §16) — columns on the row, like CommunicationLog's own status ----------
  verificationStatus    DocumentVerificationStatus @default(NOT_SUBMITTED)
  verificationMethod    String? // MANUAL | PROVIDER | OCR_ASSISTED
  verificationProvider  String?
  verificationReference String?
  reviewedById          String?
  reviewedAt            DateTime?
  verificationReason    String? // neutral rejection-reason key, spec §19
  verificationNotes     String?
  verificationVersion   Int                        @default(1)

  expiresAt      DateTime?
  archivedAt     DateTime?
  softDeletedAt  DateTime?
  bodyRedactedAt DateTime? // set when retention/redaction removed the stored bytes (metadata kept)

  proposalId String? // loose — set when this document was uploaded specifically for/about a proposal
  caseId     String? // loose — set when this document is support/risk case evidence-adjacent
  requestId  String? // loose — the DocumentRequest this upload satisfies, if any

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions          DocumentVersion[]
  scans             DocumentSecurityScan[]
  accessLogs        DocumentAccessLog[]
  shares            DocumentShare[]
  redactions        DocumentRedaction[]
  verifications     DocumentVerificationEvent[]
  signatureRequests DocumentSignatureRequest[]

  @@index([ownerType, ownerId])
  @@index([profileId, status])
  @@index([typeKey])
  @@index([categoryKey])
  @@index([status])
  @@index([classification])
  @@index([expiresAt])
  @@index([fileHash])
  @@index([requestId])
}

enum DocumentVerificationStatus {
  NOT_SUBMITTED
  PENDING
  UNDER_REVIEW
  VERIFIED
  PARTIALLY_VERIFIED
  REJECTED
  REVERIFICATION_REQUIRED
}

// One row per replacement (spec §33/§34). The parent Document's live columns
// always mirror whichever version is current — never overwritten in place.
model DocumentVersion {
  id              String   @id @default(cuid())
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId      String
  version         Int
  previousVersion Int?

  secureStorageReference String
  ivBase64               String
  authTagBase64          String
  mimeType               String
  sizeBytes              Int
  fileHash               String

  uploaderType DocumentUploaderType
  uploaderId   String
  changeReason String?

  scanStatus         DocumentScanStatus         @default(PENDING)
  verificationStatus DocumentVerificationStatus @default(NOT_SUBMITTED)

  createdAt DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

model DocumentSecurityScan {
  id         String             @id @default(cuid())
  document   Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  version    Int
  status     DocumentScanStatus @default(PENDING)
  scanner    String // "heuristic-v1" | a configured external provider key
  findings   String             @default("[]") // JSON array of finding codes (never raw file content)
  scannedAt  DateTime?
  createdAt  DateTime           @default(now())

  quarantine DocumentQuarantine?

  @@index([documentId, version])
  @@index([status])
}

model DocumentQuarantine {
  id           String                     @id @default(cuid())
  scan         DocumentSecurityScan       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId       String                     @unique
  documentId   String
  reason       String
  decision     DocumentQuarantineDecision @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  decisionNote String?
  createdAt    DateTime                   @default(now())

  @@index([documentId])
  @@index([decision])
}

// Per-document access timeline (spec §56) — also mirrored into the global
// AuditLog via writeAudit() for the platform-wide feed.
model DocumentAccessLog {
  id            String               @id @default(cuid())
  document      Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId    String
  action        DocumentAccessAction
  actorType     DocumentUploaderType // reuses PROFILE|FAMILY_MEMBER|ADMIN|SYSTEM
  actorId       String
  purpose       String?
  result        String // ALLOWED | DENIED
  denialReason  String?
  ipHash        String?
  userAgentHash String?
  createdAt     DateTime             @default(now())

  @@index([documentId, createdAt])
  @@index([actorType, actorId])
  @@index([action])
}

// Explicit, expiring sharing grant (spec §27-§29). Document/proposal/family
// access never implies this — it is always a separate row.
model DocumentShare {
  id            String                     @id @default(cuid())
  document      Document                   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId    String
  recipientType DocumentShareRecipientType
  recipientId   String
  scope         DocumentShareScope         @default(VIEW)
  purpose       String
  status        DocumentShareStatus        @default(REQUESTED)
  requestedById String
  approvalId    String? // loose STEP 19 ApprovalRequest.id pointer
  watermarked   Boolean                    @default(true)
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedById   String?
  revokeReason  String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([documentId, status])
  @@index([recipientType, recipientId])
  @@index([status, expiresAt])
}

// Admin -> applicant document requests (spec §37/§38).
model DocumentRequest {
  id                  String                @id @default(cuid())
  requestCode         String                @unique // LPP-DREQ-######
  typeKey             String
  purpose             String
  requestedFromType   DocumentUploaderType
  requestedFromId     String
  dueDate             DateTime?
  priority            String                @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  instructions        String?
  assignedToId        String?
  status              DocumentRequestStatus @default(DRAFT)
  resultingDocumentId String?
  createdById         String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  events DocumentRequestEvent[]

  @@index([requestedFromType, requestedFromId])
  @@index([status])
  @@index([assignedToId])
}

model DocumentRequestEvent {
  id        String                @id @default(cuid())
  request   DocumentRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  eventType String // SENT | VIEWED | UPLOADED | REVIEWED | REMINDED | CANCELLED | EXPIRED
  actorType DocumentUploaderType?
  actorId   String?
  note      String?
  createdAt DateTime              @default(now())

  @@index([requestId, createdAt])
}

// Provider-neutral e-signature layer (spec §40-§43). Default provider is the
// in-app LocalSignatureProvider — an authenticated acknowledgement, never
// represented as a cryptographic/legally-binding signature unless a real,
// legal-reviewed provider is configured behind this same interface.
model DocumentSignatureRequest {
  id                      String                  @id @default(cuid())
  signCode                String                  @unique // LPP-SIGN-######
  document                Document                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId              String
  provider                String                  @default("LOCAL")
  status                  DocumentSignatureStatus @default(DRAFT)
  requestedById           String
  message                 String?
  expiresAt               DateTime?
  voidedAt                DateTime?
  voidedById              String?
  voidReason              String?
  signedDocumentVersionId String? // loose pointer to the DocumentVersion produced once fully signed
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  recipients DocumentSignatureRecipient[]
  events     DocumentSignatureEvent[]

  @@index([documentId])
  @@index([status])
}

model DocumentSignatureRecipient {
  id            String                           @id @default(cuid())
  request       DocumentSignatureRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId     String
  recipientType DocumentUploaderType
  recipientId   String
  order         Int                              @default(1)
  status        DocumentSignatureRecipientStatus @default(PENDING)
  viewedAt      DateTime?
  signedAt      DateTime?
  declinedAt    DateTime?
  declineReason String?
  signedName    String? // the typed full legal name captured at signing (LocalSignatureProvider)
  ipHash        String?

  @@unique([requestId, recipientType, recipientId])
  @@index([requestId, status])
}

model DocumentSignatureEvent {
  id            String                   @id @default(cuid())
  request       DocumentSignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId     String
  eventType     String // SENT | VIEWED | SIGNED | DECLINED | VOIDED | EXPIRED
  recipientType DocumentUploaderType?
  recipientId   String?
  documentHash  String? // the document's hash at the moment of this event — tamper evidence
  createdAt     DateTime                 @default(now())

  @@index([requestId, createdAt])
}

// Secure redaction (spec §49) — the original is never modified; this points
// at the DocumentVersion the redacted derivative was stored as.
model DocumentRedaction {
  id              String   @id @default(cuid())
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId      String
  sourceVersion   Int
  redactedVersion Int // the DocumentVersion.version of the derivative
  reason          String
  regions         String // JSON array of {page,x,y,width,height} or "FULL_PAGE:n"
  redactedById    String
  approvalId      String?
  createdAt       DateTime @default(now())

  @@index([documentId])
}

// Review-history trail for Document.verificationStatus (spec §17 "review history").
model DocumentVerificationEvent {
  id         String   @id @default(cuid())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String
  action     String // SUBMITTED | APPROVED | REJECTED | REQUEST_MORE_INFORMATION | REQUEST_REUPLOAD | MARK_REVERIFICATION_REQUIRED | ESCALATE | RESTRICT
  reasonKey  String? // neutral configurable reason, spec §19
  note       String?
  actorId    String?
  approvalId String? // set when this action went through the STEP 19 gate
  createdAt  DateTime @default(now())

  @@index([documentId, createdAt])
}

// Permission/consent/hold-checked manifest (spec §51) — not a real .zip (no
// zip dependency in this repo); each item resolves to its own signed access
// ticket when fetched, never a bundled file.
model DocumentPackage {
  id          String            @id @default(cuid())
  packageCode String            @unique // LPP-DOCPKG-######
  kind        String // VERIFICATION | PROPOSAL | SUPPORT_CASE | COMPLIANCE
  ownerType   DocumentOwnerType
  ownerId     String
  createdById String
  purpose     String
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())

  items DocumentPackageItem[]

  @@index([ownerType, ownerId])
}

model DocumentPackageItem {
  id            String          @id @default(cuid())
  package       DocumentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId     String
  documentId    String
  included      Boolean         @default(true)
  excludeReason String?

  @@unique([packageId, documentId])
}

// OCR is disabled by default (no vendor configured — see src/lib/documents/providers/noop-ocr-provider.ts).
// This table exists so a real provider has somewhere to write to later; output is ALWAYS treated as
// unverified pending human review and is never written to Document.verificationStatus directly.
model DocumentOcrResult {
  id            String   @id @default(cuid())
  documentId    String
  provider      String
  extractedText String?
  fields        String   @default("{}") // JSON
  detectedType  String?
  createdAt     DateTime @default(now())

  @@index([documentId])
}
